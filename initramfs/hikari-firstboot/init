#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later

export PATH=/bin:/sbin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true

echo "HIKARI_FIRSTBOOT_NATIVE_INITRAMFS"
uname -a
echo "--- /proc/cpuinfo ---"
cat /proc/cpuinfo
echo "--- /proc/meminfo ---"
cat /proc/meminfo
echo "Native diagnostic shell; no Android userspace is present."
exec /bin/sh
