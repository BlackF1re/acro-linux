#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# BOOT #5.1 PID 1.  This is deliberately independent of its optional USB
# console: losing or closing a host terminal must never terminate PID 1.

# BusyBox's host-side install metadata places a few applets in /usr/bin.
# Keep the runtime lookup path aligned with the archive's canonical links.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

log()
{
	[ -c /dev/kmsg ] || return 0
	printf '%s\n' "$*" >/dev/kmsg
}

log "HIKARI INIT ENTER"

/bin/mount -t proc proc /proc
log "HIKARI PROC MOUNT rc=$?"
/bin/mount -t sysfs sysfs /sys
log "HIKARI SYS MOUNT rc=$?"
/bin/mount -t devtmpfs devtmpfs /dev
log "HIKARI DEV MOUNT rc=$?"
# The earlier copy records the transition if a console already exists.  Repeat
# it after devtmpfs so ramoops receives an unambiguous init-entry marker.
log "HIKARI INIT ENTER"
[ -c /dev/kmsg ] && log "HIKARI KMSG AVAILABLE"
/bin/mkdir -p /run
/bin/mount -t tmpfs -o mode=0755 tmpfs /run
log "HIKARI RUN MOUNT rc=$?"
/bin/mount -t debugfs debugfs /sys/kernel/debug
log "HIKARI DEBUGFS MOUNT rc=$?"

log "HIKARI BOOT5 INIT START"
log "HIKARI BOOT5 DEV READY"

usb_snapshot()
{
	seen=0
	log "HIKARI USB SYSFS UDC: BEGIN"
	for node in /sys/class/udc/*; do
		[ -e "$node" ] || continue
		log "HIKARI USB SYSFS UDC: ${node##*/}"
		seen=1
	done
	[ "$seen" -eq 1 ] || log "HIKARI USB SYSFS UDC: NONE"

	seen=0
	log "HIKARI USB TTY: BEGIN"
	for node in /dev/ttyGS*; do
		[ -c "$node" ] || continue
		log "HIKARI USB TTY: ${node##*/}"
		seen=1
	done
	[ "$seen" -eq 1 ] || log "HIKARI USB TTY: NONE"
}

usb_snapshot

console_supervisor()
{
	announced=0
	wait_logged=0
	while :; do
		state=missing
		[ -r /sys/class/udc/ci_hdrc.0/state ] &&
			state=$(/bin/cat /sys/class/udc/ci_hdrc.0/state 2>/dev/null)
		role=missing
		for node in /sys/class/usb_role/*/role; do
			[ -r "$node" ] || continue
			role=$(/bin/cat "$node" 2>/dev/null)
		done

		# UDC addressed/powered/suspended are normal device-side transients and
		# must not permanently disarm the terminal.  Only leaving the device
		# role means ChipIdea is tearing the gadget down for OTG host mode.
		if [ -c /dev/ttyGS0 ] && [ "$role" = device ] &&
		   [ "$state" = configured ]; then
			if [ "$announced" -eq 0 ]; then
				log "HIKARI USB UDC READY"
				log "HIKARI USB GADGET READY"
				log "HIKARI TTYGS0 EXISTS"
				log "HIKARI USB TTYGS0 READY"
				announced=1
			fi
			log "HIKARI SHELL START"
			# PID 1's ash ignores interactive signals, and another ash keeps
			# inherited SIG_IGN dispositions.  The launcher resets signals,
			# configures ttyGS0 and establishes its foreground process group.
			/usr/sbin/hikari-console-launch &
			shell_pid=$!

			# Keep observing the UDC while the interactive shell owns ttyGS0.
			# A synchronous wait can miss a cable disconnect and can leave the
			# port open while ChipIdea changes to host mode.
			while kill -0 "$shell_pid" 2>/dev/null; do
				role=missing
				for node in /sys/class/usb_role/*/role; do
					[ -r "$node" ] || continue
					role=$(/bin/cat "$node" 2>/dev/null)
				done
				if [ "$role" != device ]; then
					log "HIKARI SHELL ROLE EXIT role=$role"
					kill "$shell_pid" 2>/dev/null
					break
				fi
				/bin/sleep 1
			done
			wait "$shell_pid"
			log "HIKARI SHELL EXIT rc=$?"
			role=missing
			for node in /sys/class/usb_role/*/role; do
				[ -r "$node" ] || continue
				role=$(/bin/cat "$node" 2>/dev/null)
			done
			if [ "$role" = device ]; then
				log "HIKARI SHELL RETRY DELAY"
				/bin/sleep 5
			else
				log "HIKARI SHELL WAIT DEVICE ROLE"
			fi
		else
			if [ "$wait_logged" -eq 0 ]; then
				log "HIKARI WAIT TTYGS0"
				wait_logged=1
			fi
		fi
		/bin/sleep 1
	done
}

usb_role_snapshot()
{
	seen=0
	for node in /sys/class/usb_role/*/role; do
		[ -r "$node" ] || continue
		log "HIKARI USB ROLE ${node%/role}=$(/bin/cat "$node" 2>/dev/null)"
		seen=1
	done
	[ "$seen" -eq 1 ] || log "HIKARI USB ROLE NONE"

	for node in /sys/class/udc/*/state; do
		[ -r "$node" ] || continue
		log "HIKARI USB UDC ${node%/state}=$(/bin/cat "$node" 2>/dev/null)"
	done

	# The exact raw bytes distinguish a logical regulator state from the
	# physical PM8901 MPP1 output and BQ24160 OTG-lock state.
	for node in /sys/kernel/debug/regmap/*; do
		[ -d "$node" ] || continue
		log "HIKARI REGMAP ${node##*/}"
	done
	for node in /sys/kernel/debug/regmap/*c00000*/registers \
		    /sys/kernel/debug/regmap/*pm8901*/registers; do
		[ -r "$node" ] || continue
		while IFS= read -r line; do
			case "$line" in
			27:*|027:*|0027:*|28:*|028:*|0028:*|29:*|029:*|0029:*)
				log "HIKARI PM8901 RAW $line" ;;
			esac
		done <"$node"
	done
	for node in /sys/kernel/debug/regmap/*006b*/registers \
		    /sys/kernel/debug/regmap/*bq24160*/registers; do
		[ -r "$node" ] || continue
		while IFS= read -r line; do
			case "$line" in
			0:*|00:*|000:*|1:*|01:*|001:*) log "HIKARI BQ24160 RAW $line" ;;
			esac
		done <"$node"
	done
}

usb_role_monitor()
{
	previous=unknown
	while :; do
		state=missing
		[ -r /sys/class/udc/ci_hdrc.0/state ] &&
			state=$(/bin/cat /sys/class/udc/ci_hdrc.0/state 2>/dev/null)
		role=missing
		for node in /sys/class/usb_role/*/role; do
			[ -r "$node" ] || continue
			role=$(/bin/cat "$node" 2>/dev/null)
		done
		current="$role:$state"
		if [ "$current" != "$previous" ]; then
			log "HIKARI USB TRANSITION $previous -> $current"
			usb_role_snapshot
			previous=$current
		fi
		/bin/sleep 1
	done
}

# A first successful DRM/fbdev bind should immediately produce something that
# can be judged by eye.  This service is intentionally independent of the USB
# shell and PID 1: if DRM never creates fb0 it only waits and cannot take the
# USB diagnostics or PID 1 down with it.
display_supervisor()
{
	wait_logged=0
	while :; do
		if [ -e /sys/class/graphics/fb0 ] && [ -c /dev/tty0 ]; then
			log "HIKARI DISPLAY FB0 READY"
			[ -r /sys/class/graphics/fb0/virtual_size ] &&
				log "HIKARI DISPLAY SIZE $(cat /sys/class/graphics/fb0/virtual_size)"

			# Give fbcon a moment to complete its takeover after fb0 appears.
			/bin/sleep 1
			{
				printf '\033[2J\033[H'
				echo '============================================================'
				echo ' HIKARI MAINLINE LINUX - DISPLAY / FBCON IS ALIVE'
				echo '============================================================'
				uname -a
				if [ -r /sys/class/graphics/fb0/virtual_size ]; then
					printf 'fb0 virtual_size: '
					cat /sys/class/graphics/fb0/virtual_size
				fi
				echo '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz'
				echo '---------------- recent kernel log ----------------'
				dmesg | tail -n 100
				echo '---------------- end kernel log -------------------'
			} >/dev/tty0 2>&1
			log "HIKARI DISPLAY WITNESS WRITTEN"

			# Keep a small moving witness on-screen so a frozen scanout can be
			# distinguished from a live framebuffer without flooding the console.
			while :; do
				set -- $(cat /proc/uptime 2>/dev/null || echo unknown)
				printf '\nHIKARI DISPLAY ALIVE uptime=%s\n' "$1" >/dev/tty0 2>&1
				/bin/sleep 30
			done
		fi

		if [ "$wait_logged" -eq 0 ]; then
			log "HIKARI WAIT FB0"
			wait_logged=1
		fi
		/bin/sleep 2
	done
}

console_supervisor &
usb_role_monitor &
display_supervisor &
log "HIKARI BOOT5 SERVICES START"

while :; do
	set -- $(/bin/cat /proc/uptime 2>/dev/null || /bin/echo unknown)
	log "HIKARI ALIVE uptime=$1"
	/bin/sleep 30
done
