#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Read-only Adreno A220 bring-up snapshot.  Safe to run from the USB shell.

section()
{
	printf '\n== %s ==\n' "$1"
}

show_file()
{
	printf '%s: ' "$1"
	if [ -r "$1" ]; then
		cat "$1"
	else
		echo unavailable
	fi
}

section firmware
for fw in /lib/firmware/qcom/leia_pm4_470.fw /lib/firmware/qcom/leia_pfp_470.fw; do
	if [ -s "$fw" ]; then
		ls -l "$fw"
	else
		echo "missing $fw"
	fi
done

section drm
if [ -d /sys/class/drm ]; then
	ls -la /sys/class/drm
else
	echo unavailable
fi
for node in /sys/class/drm/card* /sys/class/drm/renderD*; do
	[ -e "$node" ] || continue
	printf '%s -> ' "$node"
	readlink "$node/device/driver" 2>/dev/null || echo no-driver
 done

section devfreq
if [ -d /sys/class/devfreq ]; then
	for node in /sys/class/devfreq/*; do
		[ -e "$node" ] || continue
		echo "-- ${node##*/} --"
		for attr in name governor cur_freq available_frequencies min_freq max_freq; do
			show_file "$node/$attr"
		done
	done
else
	echo unavailable
fi

section runtime-pm
for node in /sys/bus/platform/devices/*4300000* /sys/bus/platform/devices/*gpu*; do
	[ -e "$node" ] || continue
	echo "-- $node --"
	show_file "$node/power/runtime_status"
	show_file "$node/power/runtime_usage"
	if [ -L "$node/driver" ]; then
		printf 'driver: '; readlink "$node/driver"
	fi
done

section clocks
if [ -r /sys/kernel/debug/clk/clk_summary ]; then
	grep -Ei 'gfx3d|gmem|mm_fabric|smi' /sys/kernel/debug/clk/clk_summary || true
else
	echo '/sys/kernel/debug/clk/clk_summary unavailable'
fi

section deferred-probes
if [ -r /sys/kernel/debug/devices_deferred ]; then
	cat /sys/kernel/debug/devices_deferred
else
	echo unavailable
fi

section kernel-log
dmesg | grep -Ei 'adreno|a220|a2xx|gpu|gfx3d|gmem|firmware|hangcheck|devfreq|iommu|mmcc|fault|timeout|oops|panic' || true
