#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Small, device-specific bootstrap. It keeps the proven Hikari USB terminal
# available, mounts a labelled Debian filesystem and hands PID 1 to systemd.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

log()
{
	printf '%s\n' "$*" >/dev/kmsg 2>/dev/null || true
	printf '%s\n' "$*" >/dev/console 2>/dev/null || true
}

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /run /newroot
mount -t tmpfs -o mode=0755 tmpfs /run

# Register the configfs composite gadget once.  After switch_root, udev starts
# the same idempotent helper whenever ChipIdea publishes a new UDC add event.
/usr/sbin/hikari-usb-gadget || log 'HIKARI USB GADGET SETUP FAILED'
tries=0
while [ "$tries" -lt 20 ] && [ ! -e /sys/class/net/usb0 ]; do
	tries=$((tries + 1))
	sleep 1
done
if [ -e /sys/class/net/usb0 ]; then
	ip link set usb0 up
	ip address replace 192.168.77.2/30 dev usb0
else
	log 'HIKARI SYSTEM USB NCM SETUP FAILED no usb0'
fi

root_spec=LABEL=HIKARI_ROOT
root_type=ext4
root_opts=rw
for arg in $(cat /proc/cmdline); do
	case "$arg" in
		hikari.root=*) root_spec=${arg#hikari.root=} ;;
		rootfstype=*) root_type=${arg#rootfstype=} ;;
		ro) root_opts=ro ;;
		rw) root_opts=rw ;;
	esac
done

log "HIKARI SYSTEM ROOT WAIT spec=$root_spec type=$root_type opts=$root_opts"
tries=0
while [ "$tries" -lt 60 ]; do
	if mount -t "$root_type" -o "$root_opts" "$root_spec" /newroot \
		2>/run/root-mount.err; then
		break
	fi
	tries=$((tries + 1))
	sleep 1
done

if ! mountpoint -q /newroot || [ ! -x /newroot/sbin/init ]; then
	log "HIKARI SYSTEM ROOT FAILED spec=$root_spec"
	while IFS= read -r line; do
		log "HIKARI SYSTEM ROOT ERROR $line"
	done </run/root-mount.err
	log 'HIKARI SYSTEM BLOCK DEVICES'
	while IFS= read -r line; do log "$line"; done </proc/partitions
	blkid 2>&1 | while IFS= read -r line; do log "$line"; done
	log 'Connect USB CDC ACM; emergency shell is active.'
	(
		while :; do
			[ -c /dev/ttyGS0 ] && /usr/sbin/hikari-console-launch
			sleep 1
		done
	) &
	exec sh </dev/console >/dev/console 2>&1
fi

log "HIKARI SYSTEM ROOT READY spec=$root_spec"
mkdir -p /newroot/proc /newroot/sys /newroot/dev /newroot/run
mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
mount --move /dev /newroot/dev
mount --move /run /newroot/run
exec switch_root /newroot /sbin/init
