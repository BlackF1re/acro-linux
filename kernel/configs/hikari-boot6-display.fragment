# SPDX-License-Identifier: GPL-2.0-or-later
# BOOT #6 extends the physically verified BOOT #5.1 foundation with the
# Hikari display path.  USB CDC ACM and ramoops intentionally remain built in.
CONFIG_ARCH_QCOM=y
CONFIG_SMP=y
# CONFIG_ARCH_MULTIPLATFORM is not set
# CONFIG_AUTO_ZRELADDR is not set
CONFIG_PHYS_OFFSET=0x40000000
CONFIG_ARCH_QCOM_RESERVE_SMEM=y
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_EXTEND=y
CONFIG_CMDLINE="console=tty0 console=ttyGS0,115200 driver_async_probe=mdp4,msm_dsi"
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_PRINTK=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
# CONFIG_PSTORE_COMPRESS is not set
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_REGULATOR_QCOM_RPM=y
CONFIG_USB=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CHIPIDEA_MSM=y
CONFIG_PHY_QCOM_USB_HS=y
CONFIG_USB_GADGET=y
CONFIG_USB_G_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y

# Diagnostic-survival policy: recoverable peripheral faults should leave the
# kernel alive long enough for ttyGS0 and ramoops to report the failure.  A
# true fatal panic still stops execution, but must not be triggered merely by
# an oops, hung-task report or soft-lockup warning in experimental drivers.
# CONFIG_PANIC_ON_OOPS is not set
CONFIG_PANIC_TIMEOUT=0
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=0
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=0

CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_LLCC=y
CONFIG_MSM_MMCC_8660=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM_MSM8660=y
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_MDP4=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_45NM_PHY=y
CONFIG_DRM_PANEL_RENESAS_R63306_TMD_MDV22=y
CONFIG_DRM_FBDEV_EMULATION=y

# Make a successful DRM/fbdev bind visibly useful on first boot. tty0 is the
# first preferred console in CONFIG_CMDLINE; do not defer fbcon takeover, so
# the console binds as soon as DRM creates fb0 instead of waiting for later
# userspace output.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER is not set

CONFIG_LEDS_CLASS=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_AS3676=y
CONFIG_I2C_QUP=y
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_BQ27XXX=y
CONFIG_BATTERY_BQ27XXX_I2C=y
# CONFIG_BATTERY_BQ27XXX_DT_UPDATES_NVM is not set
CONFIG_CHARGER_BQ24160=y

# Source-backed board hardware baseline.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_ARMMMCI=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_MFD_PM8XXX=y
CONFIG_PINCTRL_QCOM_SSBI_PMIC=y
CONFIG_INPUT_PMIC8XXX_PWRKEY=y
CONFIG_INPUT_PM8XXX_VIBRATOR=y
CONFIG_KEYBOARD_PMIC8XXX=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_IIO=y
CONFIG_QCOM_PM8XXX_XOADC=y
CONFIG_HWMON=y
CONFIG_SENSORS_IIO_HWMON=y

# Native PN544 HCI stack on GSBI8; no Android misc-device compatibility layer.
CONFIG_NFC=y
CONFIG_NFC_HCI=y
CONFIG_NFC_SHDLC=y
CONFIG_NFC_PN544_I2C=y

# BCM4330 combo radio: brcmfmac over SDCC4 and hci_bcm over GSBI6 serdev.
CONFIG_CFG80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y
# CONFIG_BRCMFMAC_USB is not set
CONFIG_RFKILL=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_BCM=y

# Synaptics ClearPad TM1964 path.  The exact Hikari controller uses RMI F11;
# the legacy virtual-key strip is intentionally not misrepresented as F1A.
CONFIG_RMI4_CORE=y
CONFIG_RMI4_I2C=y
CONFIG_RMI4_F11=y
# CONFIG_RMI4_F34 is not set

# Native IIO motion stack: MPU3050 + BMA250 behind its auxiliary I2C gate.
CONFIG_MPU3050_I2C=y
CONFIG_BMA180=y
# CONFIG_DEBUG_INFO is not set
