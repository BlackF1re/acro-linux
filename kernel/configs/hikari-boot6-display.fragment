# SPDX-License-Identifier: GPL-2.0-or-later
# BOOT #6 extends the physically verified BOOT #5.1 foundation with the
# Hikari display path.  USB CDC ACM and ramoops intentionally remain built in.
CONFIG_ARCH_QCOM=y
CONFIG_SMP=y
# CONFIG_ARCH_MULTIPLATFORM is not set
# CONFIG_AUTO_ZRELADDR is not set
CONFIG_PHYS_OFFSET=0x40000000
CONFIG_ARCH_QCOM_RESERVE_SMEM=y
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_EXTEND=y
CONFIG_CMDLINE="console=tty0 console=ttyGS0,115200"
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_PRINTK=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
# CONFIG_PSTORE_COMPRESS is not set
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_REGULATOR_QCOM_RPM=y
CONFIG_USB=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CHIPIDEA_MSM=y
CONFIG_PHY_QCOM_USB_HS=y
CONFIG_USB_GADGET=y
CONFIG_USB_G_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y

# MSM8x60 DRM/KMS display chain.  Nothing below depends on Adreno userspace.
CONFIG_COMMON_CLK_QCOM=y
# DRM/MSM is built in for fbcon.  Its Kconfig dependency chain inherits the
# generic Qualcomm LLCC option from qcom_defconfig; keep it built in too so it
# cannot demote DRM_MSM to a module.
CONFIG_QCOM_LLCC=y
CONFIG_MSM_MMCC_8660=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM_MSM8660=y
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_MDP4=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_45NM_PHY=y
CONFIG_DRM_PANEL_RENESAS_R63306_TMD_MDV22=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_AS3676=y
CONFIG_I2C_QUP=y
# CONFIG_DEBUG_INFO is not set
