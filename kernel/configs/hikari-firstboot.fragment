CONFIG_ARCH_QCOM=y
CONFIG_SMP=y
# The verified legacy RAM bank begins at 0x40200000.  AUTO_ZRELADDR would
# mask a zImage loaded at 0x40208000 down to 0x40000000, outside that bank.
# Keep the decompressor destination explicit for this first-board prototype.
# CONFIG_ARCH_MULTIPLATFORM is not set
# CONFIG_AUTO_ZRELADDR is not set
CONFIG_PHYS_OFFSET=0x40200000
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_EXTEND=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_PRINTK=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
# CONFIG_DEBUG_INFO is not set
