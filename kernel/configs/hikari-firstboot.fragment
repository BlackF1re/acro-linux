CONFIG_ARCH_QCOM=y
CONFIG_SMP=y
# Historical MSM8x60 code puts physical RAM/SMEM at 0x40000000.  Upstream
# reserves its first 2 MiB below, so the legacy-compatible zImage destination
# becomes 0x40208000.  Keep the decompressor destination explicit.
# CONFIG_ARCH_MULTIPLATFORM is not set
# CONFIG_AUTO_ZRELADDR is not set
CONFIG_PHYS_OFFSET=0x40000000
# MSM8x60 needs the first 2 MiB of System RAM retained for Qualcomm SMEM.
# This also makes the ARM zImage decompressor use TEXT_OFFSET=0x00208000.
CONFIG_ARCH_QCOM_RESERVE_SMEM=y
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_EXTEND=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_PRINTK=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
# CONFIG_PSTORE_COMPRESS is not set
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
# CONFIG_DEBUG_INFO is not set
