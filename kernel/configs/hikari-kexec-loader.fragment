# SPDX-License-Identifier: GPL-2.0-or-later
# Stable p3 rescue/loader profile.  Keep CPU1 in the bootloader's reset state
# so ARM kexec never has to hot-unplug a running MSM8x60 Scorpion core.
# The second-stage kernel loaded from microSD remains the normal SMP build.
# CONFIG_SMP is not set
# CONFIG_HOTPLUG_CPU is not set
CONFIG_KEXEC=y
CONFIG_USB_CONFIGFS_NCM=y
# Give the ABI-incompatible UP rescue kernel a visibly distinct release.  The
# build script also cleans the shared O= tree when switching profiles.
CONFIG_LOCALVERSION="-hikari-boot"
