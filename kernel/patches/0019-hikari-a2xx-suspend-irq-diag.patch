From 41a936ce75396f7e58dfeaa5d7bd7f079e751019 Mon Sep 17 00:00:00 2001
From: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
Date: Wed, 7 Oct 2026 00:40:00 +0300
Subject: [PATCH] drm/msm/adreno: quiesce A2xx IRQ across system suspend

Sony KGSL disables the physical GPU interrupt before tearing down AXI and
clocks, then restores power, hardware state and finally the interrupt on
resume. Match that ordering for A2xx instead of leaving a level-triggered
RBBM interrupt live while the register block is being powered down.

Keep the IRQ masked across pm_runtime_force_resume() and msm_gpu_hw_init().
The latter nests its own disable/enable pair, so hardware is fully
reinitialized before the outer system-suspend mask is released.

Signed-off-by: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
---
diff --git a/drivers/gpu/drm/msm/adreno/adreno_device.c b/drivers/gpu/drm/msm/adreno/adreno_device.c
--- a/drivers/gpu/drm/msm/adreno/adreno_device.c
+++ b/drivers/gpu/drm/msm/adreno/adreno_device.c
@@ -365,37 +365,93 @@
 static int adreno_system_suspend(struct device *dev)
 {
 	struct msm_gpu *gpu = dev_to_gpu(dev);
+	bool gate_irq;
+	bool irq_gated = false;
 	int remaining, ret;
 
 	if (!gpu)
 		return 0;
+
+	gate_irq = adreno_is_a2xx(to_adreno_gpu(gpu));
 
 	suspend_scheduler(gpu);
 
 	remaining = wait_event_timeout(gpu->retire_event,
 				       gpu->active_submits == 0,
 				       msecs_to_jiffies(1000));
 	if (remaining == 0) {
 		dev_err(dev, "Timeout waiting for GPU to suspend\n");
 		ret = -EBUSY;
 		goto out;
 	}
 
+	/*
+	 * Downstream KGSL masks the physical GPU IRQ before dropping AXI and
+	 * clocks. A2xx can otherwise leave a level RBBM interrupt asserted
+	 * while the register block is being powered down.
+	 */
+	if (gate_irq) {
+		disable_irq(gpu->irq);
+		irq_gated = true;
+	}
+
 	ret = pm_runtime_force_suspend(dev);
 out:
-	if (ret)
+	if (ret) {
+		if (irq_gated)
+			enable_irq(gpu->irq);
 		resume_scheduler(gpu);
+	}
 
 	return ret;
 }
 
 static int adreno_system_resume(struct device *dev)
 {
 	struct msm_gpu *gpu = dev_to_gpu(dev);
+	bool gate_irq;
+	int ret;
 
 	if (!gpu)
 		return 0;
 
+	gate_irq = adreno_is_a2xx(to_adreno_gpu(gpu));
+
+	/*
+	 * Restore rails/clocks/AXI first. msm_gpu_pm_resume() marks the GPU as
+	 * needing hardware initialization; perform it while the outer A2xx IRQ
+	 * disable is still held, then expose interrupts and scheduler work.
+	 */
+	ret = pm_runtime_force_resume(dev);
+	if (ret)
+		return ret;
+
+	if (gate_irq) {
+		/*
+		 * force_resume() may intentionally leave a device suspended when it
+		 * was already runtime-suspended before system sleep. Take a temporary
+		 * runtime reference so A2xx registers are guaranteed accessible for
+		 * the reset/init sequence before the physical IRQ is unmasked.
+		 */
+		ret = pm_runtime_resume_and_get(dev);
+		if (ret < 0)
+			return ret;
+
+		mutex_lock(&gpu->lock);
+		ret = msm_gpu_hw_init(gpu);
+		mutex_unlock(&gpu->lock);
+		if (ret) {
+			pm_runtime_put_noidle(dev);
+			return ret;
+		}
+
+		enable_irq(gpu->irq);
+		resume_scheduler(gpu);
+		pm_runtime_mark_last_busy(dev);
+		pm_runtime_put_autosuspend(dev);
+		return 0;
+	}
+
 	resume_scheduler(gpu);
-	return pm_runtime_force_resume(dev);
+	return 0;
 }
-- 
