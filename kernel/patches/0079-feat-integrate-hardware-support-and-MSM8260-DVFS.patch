+	{ 0x2000, 0x2002 },
+	{ 0x2006, 0x200f },
+	{ 0x2080, 0x2082 },
+	{ 0x210c, 0x2114 },
+	{ 0x2180, 0x2184 },
+	{ 0x2300, 0x2308 },
+	{ 0x2312, 0x2312 },
+	{ 0x2324, 0x2326 },
+	{ 0x2380, 0x2383 },
+	{ 0x2100, 0x2102 },
+	{ 0x2104, 0x2109 },
+	{ 0x2200, 0x2202 },
+	{ 0x2204, 0x2206 },
