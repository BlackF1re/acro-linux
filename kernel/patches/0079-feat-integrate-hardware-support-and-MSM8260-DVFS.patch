+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Qualcomm MSM8660 / MSM8260 Scorpion cpufreq bring-up driver.
+ *
+ * Initial target: Sony Hikari LT26w, speed-bin 1 / PVS 1.
+ *
+ * Clock/voltage tables and sequencing are ported from the historical
+ * OpenSEMC/Caf acpuclock-8x60 implementation.  This version intentionally
+ * refuses unknown fuse/boot states and is opt-in while being validated.
+ *
+ * On successful cpufreq registration the module pins itself: reboot is the
+ * rollback.  Do not attempt to unload a live CPU clock owner.
+ */
+
+#include <linux/clk.h>
+#include <linux/cpu.h>
+#include <linux/cpufreq.h>
+#include <linux/delay.h>
+#include <linux/interconnect.h>
