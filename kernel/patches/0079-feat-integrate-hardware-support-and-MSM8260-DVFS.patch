+struct msm8660_cpufreq {
+        struct device *dev;
+
+        void __iomem *scpll;
+        void __iomem *pll[NR_SCORPION_CPUS];
+        void __iomem *l2_pll;
+        void __iomem *acc[NR_SCORPION_CPUS];
+
+        struct regmap *l2cc;
+
+        struct regulator *cpu_reg[NR_SCORPION_CPUS];
+        struct regulator *mem_reg;
+        struct regulator *dig_reg;
+        struct icc_path *icc;
+
