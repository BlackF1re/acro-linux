+
 	/*
 	 * The low bank starts at the historical MSM8x60 shared-memory physical
 	 * base.  CONFIG_ARCH_QCOM_RESERVE_SMEM then retains its first 2 MiB for
@@ -62,12 +114,28 @@ &gsbi12 {
 
 /*
  * HSUSB1 is the connector-facing ChipIdea controller.  The address and IRQ
- * are shared MSM8x60 facts; `peripheral` and the two PHY rails come from the
- * Fuji/Hikari downstream board code.  PMIC VBUS/ID callbacks were only used
