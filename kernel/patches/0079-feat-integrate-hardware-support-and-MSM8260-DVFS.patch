+/*
+ * Boards without hardware battery insertion detection must tell the gauge
+ * when their permanently connected battery is present. Without BAT_INSERT,
+ * a powered gauge can report an uninitialised 100%/FC at an empty voltage.
+ * Do not reset, unseal or modify the battery's learned data.
+ */
+static int bq27520_battery_insert(struct bq27xxx_device_info *di, int flags)
+{
+	int ret, status, i;
+
+	if (flags < 0 || (flags & BQ27520_FLAG_BAT_DET) ||
+	    di->chip != BQ27520G1 ||
+	    !device_property_read_bool(di->dev, "ti,host-battery-insertion"))
+		return flags;
+
+	ret = bq27xxx_write(di, BQ27XXX_REG_CTRL,
+			    BQ27520_CTRL_BAT_INSERT, false);
+	if (ret < 0)
+		return ret;
+
+	/* Wait for gauging to start before publishing any state of charge. */
+	for (i = 0; i < 50; i++) {
+		msleep(100);
+		ret = bq27xxx_write(di, BQ27XXX_REG_CTRL, 0, false);
+		if (ret < 0)
+			return ret;
+		usleep_range(1000, 2000);
+		status = bq27xxx_read(di, BQ27XXX_REG_CTRL, false);
+		if (status < 0)
+			return status;
+		if ((status & (BQ27520_CTRL_INITCOMP | BQ27520_CTRL_QEN)) ==
+		    (BQ27520_CTRL_INITCOMP | BQ27520_CTRL_QEN)) {
+			flags = bq27xxx_read(di, BQ27XXX_REG_FLAGS, false);
+			if (flags < 0)
+				return flags;
+			if (flags & BQ27520_FLAG_BAT_DET) {
+				dev_info(di->dev, "host battery insertion complete\n");
+				return flags;
+			}
+		}
+	}
+
+	dev_warn_ratelimited(di->dev, "battery insertion did not initialise gauge\n");
+	return -ETIMEDOUT;
+}
