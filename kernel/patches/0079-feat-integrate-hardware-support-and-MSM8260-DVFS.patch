+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Qualcomm MSM8660 / MSM8260 SAW v1 CPU regulator
+ *
+ * Hikari/Fuji legacy-compatible implementation.
+ *
+ * The SAW SPM initialization deliberately does NOT touch:
+ *   VCTL     +0x08
+ *   STS      +0x0c
+ *   PMIC_CTL +0x20
+ *
+ * CPU voltage changes are performed through VCTL and verified through STS.
+ */
+
+#include <linux/cpu.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/driver.h>
+#include <linux/regulator/machine.h>
+#include <linux/regulator/of_regulator.h>
+
+/* MSM8x60 SAW v1 register layout */
+#define SAW_AVS_CTL              0x04
+#define SAW_VCTL                 0x08
+#define SAW_STS                  0x0c
+#define SAW_CFG                  0x10
+#define SAW_SPM_CTL              0x14
+#define SAW_SLP_TMR_DLY          0x18
+#define SAW_WAKE_TMR_DLY         0x1c
+#define SAW_PMIC_CTL             0x20
+#define SAW_SLP_CLK_EN           0x24
+#define SAW_PRECLMP_EN           0x28
+#define SAW_POSTCLMP_EN          0x2c
+#define SAW_CLMP_EN              0x30
+#define SAW_RST_EN               0x34
+#define SAW_MPM_CFG              0x38
+
+#define SAW_STS_PMIC_STATE(v)    (((v) >> 20) & 0x3)
+#define SAW_STS_PMIC_DATA(v)     (((v) >> 10) & 0xff)
+
+#define FTSMPS_BAND2             0x80
+#define FTSMPS_BAND2_MIN_UV      700000
+#define FTSMPS_BAND2_STEP_UV     12500
+
+/* Exact historical Hikari/Fuji regulator constraints. */
+#define HIKARI_MIN_UV            800000
+#define HIKARI_MAX_UV            1325000
+#define HIKARI_STEP_UV           12500
+#define HIKARI_N_VOLTAGES \
+	(((HIKARI_MAX_UV - HIKARI_MIN_UV) / HIKARI_STEP_UV) + 1)
+
+/* Legacy driver value: PMIC internal slew rate. */
+#define REGULATOR_SLEW_RATE_UV_US 1250
+
+struct msm8660_saw {
+	struct device *dev;
