+#include <linux/kernel.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/nvmem-consumer.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <linux/slab.h>
+
+#include <dt-bindings/clock/qcom,gcc-msm8660.h>
+
+#define DRV_NAME                        "qcom-msm8660-cpufreq"
+
+#define NR_SCORPION_CPUS                2
+
+#define SCPLL_CPU0_OFF                  0x200
+#define SCPLL_CPU1_OFF                  0x300
+#define SCPLL_L2_OFF                    0x400
+
+#define PLL_CTL                         0x04
+#define PLL_CAL                         0x08
+#define PLL_STATUS                      0x10
+#define PLL_CFG                         0x1c
+#define PLL_FSM                         0x24
+#define PLL_LUT(l)                      (0x38 + (((l) / 4) * 4))
+
+#define ACC_CTL                         0x04
+#define ACC_SEL                         0x08
+
+#define KPSS_L2_CLK_SEL                 0x38
+#define CORE_SRC_MASK                   0x3
+
+#define CORE_SRC_MUX                    0
+#define CORE_SRC_SCPLL                  1
+
+#define SHOT_SWITCH                     4
+#define COMPLEX_SLEW                    7
+#define SCPLL_POWER_DOWN                0
+#define SCPLL_STANDBY                   2
+#define SCPLL_NORMAL                    7
+
+#define SCPLL_CAL_MIN_L                 0x08
+#define SCPLL_CAL_MAX_L                 0x1c
+
+#define MAX_VDD_SC_UV                   1325000
+#define MAX_VDD_MEM_UV                  1325000
+#define MAX_VDD_DIG_UV                  1200000
+
+#define SCPLL_LOW_VDD_FMAX_KHZ          594000
+#define SCPLL_LOW_VDD_UV                1000000
+#define SCPLL_NOMINAL_VDD_UV            1100000
+
+/* Interconnect API uses kB/s. */
+#define MBPS_TO_ICC(x)                  ((u32)(x) * 1000U)
+
+struct msm8660_l2_level {
+        unsigned int khz;
+        u8 l;
+        unsigned int vdd_dig_uv;
+        unsigned int vdd_mem_uv;
+        u8 bw_level;
+};
+
+struct msm8660_opp {
+        unsigned int khz;
+        unsigned int vdd_sc_uv;
+        u8 l2_idx;
+};
+
+/*
+ * Historical l2_freq_tbl_v2, excluding the AFAB-only calibration row.
+ * Field order in the legacy source is:
+ * khz, src_sel, l_val, vdd_dig, vdd_mem, bw_level.
+ */
+static const struct msm8660_l2_level l2_levels[] = {
+        {  432000, 0x08, 1000000, 1100000, 0 },
+        {  486000, 0x09, 1000000, 1100000, 0 },
+        {  540000, 0x0a, 1000000, 1100000, 0 },
