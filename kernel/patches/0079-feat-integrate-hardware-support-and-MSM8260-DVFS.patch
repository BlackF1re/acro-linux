+ OUT_RING(ring, 0);
+ OUT_PKT3(ring, CP_SET_PROTECTED_MODE, 1);
+ OUT_RING(ring, 0);
+ OUT_PKT0(ring, REG_A2XX_MH_MMU_INVALIDATE, 1);
