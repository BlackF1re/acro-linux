From 1111111111111111111111111111111111111111 Mon Sep 17 00:00:00 2001
From: BlackF1re <plevickij57@gmail.com>
Date: Sat, 5 Sep 2026 12:00:00 +0700
Subject: [PATCH] dt-bindings: iommu: qcom: add MSM8660 compatible

MSM8660 uses the same two-context-bank Qualcomm IOMMU hardware and DT
interface as APQ8064.  Allow an SoC-specific compatible followed by the
existing APQ8064 fallback.  Clarify the interrupt ordering to match the
driver and the existing example.

Signed-off-by: BlackF1re <plevickij57@gmail.com>
---
 .../bindings/iommu/qcom,apq8064-iommu.yaml    | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/Documentation/devicetree/bindings/iommu/qcom,apq8064-iommu.yaml b/Documentation/devicetree/bindings/iommu/qcom,apq8064-iommu.yaml
index dc45a2356f06..6abf91d98bea 100644
--- a/Documentation/devicetree/bindings/iommu/qcom,apq8064-iommu.yaml
+++ b/Documentation/devicetree/bindings/iommu/qcom,apq8064-iommu.yaml
@@ -5,7 +5,7 @@
 $id: http://devicetree.org/schemas/iommu/qcom,apq8064-iommu.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Qualcomm APQ8064 IOMMU
+title: Qualcomm APQ8064 and MSM8660 IOMMU
 
 maintainers:
   - David Heidelberg <david@ixit.cz>
@@ -16,8 +16,13 @@ description:
   outside of the CPU, each connected to the IOMMU through a port called micro-TLB.
 
 properties:
   compatible:
-    const: qcom,apq8064-iommu
+    oneOf:
+      - const: qcom,apq8064-iommu
+      - items:
+          - enum:
+              - qcom,msm8660-iommu
+          - const: qcom,apq8064-iommu
 
   clocks:
     items:
@@ -36,8 +42,8 @@ properties:
     description: Specifiers for the MMU fault interrupts.
     minItems: 1
     items:
-      - description: non-secure mode interrupt
-      - description: secure mode interrupt (for instances which supports it)
+      - description: secure mode interrupt
+      - description: non-secure mode interrupt
 
   "#iommu-cells":
     const: 1
-- 
2.51.0
