+};
+
+&soc {
+	sfpb_mutex: hwmutex@1200600 {
+		compatible = "qcom,sfpb-mutex";
+		reg = <0x01200600 0x100>;
+		#hwlock-cells = <1>;
+	};
+};
+
+
+/* HIKARI MSM8X60 SAW CPU regulators */
+&soc {
+	saw0_reg: regulator@2042000 {
+		compatible = "qcom,msm8660-saw-regulator";
+		reg = <0x02042000 0x100>;
+		qcom,cpu = <0>;
+
+		regulator-name = "msm8660-saw-cpu0";
+		regulator-min-microvolt = <800000>;
+		regulator-max-microvolt = <1325000>;
+	};
+
+	saw1_reg: regulator@2052000 {
+		compatible = "qcom,msm8660-saw-regulator";
+		reg = <0x02052000 0x100>;
+		qcom,cpu = <1>;
+
+		regulator-name = "msm8660-saw-cpu1";
+		regulator-min-microvolt = <800000>;
+		regulator-max-microvolt = <1325000>;
+	};
+};
