index 0000000000000000000000000000000000000000..944875c56c63307a827be7be6dd618234789144c
--- /dev/null
+++ b/arch/arm/boot/dts/qcom/qcom-msm8260-sony-hikari-wireless.dtsi
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Sony Xperia acro S (Hikari) Broadcom BCM4330 radio wiring.
+ *
+ * Downstream Sony sources place WLAN on MSM SDCC4 and Bluetooth on GSBI6
+ * UARTDM.  Keep firmware/calibration data out of DT: those remain userspace
+ * firmware assets and must come from the device/vendor firmware package.
+ */
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
+#include <dt-bindings/soc/qcom,gsbi.h>
+
+/ {
+	hikari_wifi_vdd: wifi-vdd-regulator {
+		compatible = "regulator-fixed";
+		/*
+		 * Sony advertises MMC_VDD_27_28 | MMC_VDD_28_29 to the MMC
+		 * core although the physical PM8058 S3 rail is 1.8 V.  This fixed
+		 * regulator is therefore only an OCR adapter.  Its parent is the
+		 * real shared PM8058 S3 rail used by WLAN and the Timpani codec.
+		 */
+		regulator-name = "wlan-mmc-ocr-2v8";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		regulator-always-on;
+		vin-supply = <&pm8058_s3>;
+	};
+
+	hikari_wifi_pwrseq: wifi-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		reset-gpios = <&tlmm 130 GPIO_ACTIVE_LOW>;
+		post-power-on-delay-ms = <200>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&hikari_wifi_sleep_clk>;
+	};
+};
+
+&pm8058_gpio {
+	/* PM8058 GPIO38 FUNC2 is the BCM4330 32.768 kHz sleep clock. */
+	hikari_wifi_sleep_clk: wifi-sleep-clk-state {
+		pins = "gpio38";
+		function = PM8058_GPIO38_39_CLK_32KHZ;
+		output-high;
+		bias-disable;
+		power-source = <PM8058_GPIO_S3>;
+		qcom,drive-strength = <PMIC_GPIO_STRENGTH_LOW>;
+	};
+};
+
+&tlmm {
+	/* Exact Sony Hikari SDC4 pad state: 8 mA and pulled-up CMD/DATA. */
+	hikari_sdc4_pins: sdc4-state {
+		clk-pins {
+			pins = "sdc4_clk";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		cmd-data-pins {
+			pins = "sdc4_cmd", "sdc4_data";
+			drive-strength = <8>;
+			bias-pull-up;
+		};
+	};
+
+	hikari_wifi_hostwake: wifi-hostwake-state {
+		pins = "gpio128";
+		function = "gpio";
+		input-enable;
+		bias-disable;
+	};
+
+	/* GSBI6 UARTDM carries BCM4330 Bluetooth H4 with RTS/CTS flow control. */
+	hikari_bt_uart: bluetooth-uart-state {
+		pins = "gpio53", "gpio54", "gpio55", "gpio56";
+		function = "gsbi6";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	hikari_bt_reset: bluetooth-reset-state {
+		pins = "gpio23";
+		function = "gpio";
+		output-low;
+		bias-disable;
+		drive-strength = <2>;
+	};
+
+	hikari_bt_device_wake: bluetooth-device-wake-state {
+		pins = "gpio137";
+		function = "gpio";
+		output-low;
+		bias-disable;
+		drive-strength = <2>;
+	};
+
+	hikari_bt_host_wake: bluetooth-host-wake-state {
+		pins = "gpio63";
+		function = "gpio";
+		input-enable;
+		bias-pull-down;
+		drive-strength = <2>;
+	};
+};
+
+/*
+ * BCM4330 WLAN is permanently soldered to SDCC4.  Sony's board data uses a
+ * four-bit bus, defines 24 MHz as the intermediate operating point and 48 MHz
+ * as the maximum, and marks the card non-removable.  Mainline PL18x traffic at
+ * 48 MHz eventually corrupts an SDIO frame on this device, while 24 MHz keeps
+ * the source-defined operating point without relying on the unstable ceiling.
+ * The old virtual card-detect callback is unnecessary with DT non-removable.
+ * GPIO130 is WL_RST_N and GPIO128 is the separate out-of-band HOST_WAKE IRQ.
+ */
+&sdcc4 {
+	/* Logical OCR adapter backed by the real PM8058 S3 supply. */
+	vmmc-supply = <&hikari_wifi_vdd>;
+	bus-width = <4>;
+	max-frequency = <24000000>;
+	non-removable;
+	mmc-pwrseq = <&hikari_wifi_pwrseq>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&hikari_sdc4_pins>;
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	wifi@1 {
+		compatible = "brcm,bcm4330-fmac", "brcm,bcm4329-fmac";
+		reg = <1>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <128 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "host-wake";
+		pinctrl-names = "default";
+		pinctrl-0 = <&hikari_wifi_hostwake>;
+	};
+};
+
+/*
+ * BCM4330 Bluetooth uses GSBI6 UARTDM.  Sony drives BT_RST_N high to power
+ * the controller, MSM_WAKES_BT on GPIO137 and samples BT_WAKES_MSM on GPIO63.
+ * Mainline hci_bcm/serdev replaces the legacy bt_power + bcm_bt_lpm glue.
+ */
+&gsbi6 {
+	qcom,mode = <GSBI_PROT_UART_W_FC>;
+	status = "okay";
+};
+
+&gsbi6_serial {
+	pinctrl-names = "default";
+	pinctrl-0 = <&hikari_bt_uart>;
+	uart-has-rtscts;
+	status = "okay";
+
+	bluetooth {
+		compatible = "brcm,bcm4330-bt";
+		shutdown-gpios = <&tlmm 23 GPIO_ACTIVE_HIGH>;
+		device-wakeup-gpios = <&tlmm 137 GPIO_ACTIVE_HIGH>;
+		host-wakeup-gpios = <&tlmm 63 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&hikari_bt_reset &hikari_bt_device_wake &hikari_bt_host_wake>;
+	};
+};
diff --git a/arch/arm/boot/dts/qcom/qcom-msm8260-sony-hikari.dts b/arch/arm/boot/dts/qcom/qcom-msm8260-sony-hikari.dts
new file mode 100644
index 0000000000000000000000000000000000000000..c4fc8678a2c8c86b2580360f9b10382cd153536d
--- /dev/null
+++ b/arch/arm/boot/dts/qcom/qcom-msm8260-sony-hikari.dts
@@ -0,0 +1,556 @@
+// SPDX-License-Identifier: GPL-2.0
+/dts-v1/;
+
+#include <dt-bindings/soc/qcom,gsbi.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/reset/qcom,gcc-msm8660.h>
+#include <dt-bindings/clock/qcom,mmcc-msm8660.h>
+#include <dt-bindings/clock/qcom,dsi-phy-28nm.h>
+#include <dt-bindings/clock/qcom,rpmcc.h>
+#include <dt-bindings/interconnect/qcom,msm8660.h>
+#include "qcom-msm8660.dtsi"
+
+/ {
+	model = "Sony Xperia acro S (Hikari)";
+	compatible = "sony,hikari", "qcom,msm8660";
+
+	/*
+	 * The MSM8x60 multimedia clock controller is secure-only on Sony's
+	 * production firmware.  The qcom_scm convention probe alone does not
+	 * instantiate the SCM platform driver: it needs this firmware node before
+	 * MMCC can use qcom_scm_io_readl()/writel().  MSM8660's binding requires
+	 * the RPM Daytona fabric clock as its single core clock.
+	 */
+	firmware {
+		scm {
+			compatible = "qcom,scm-msm8660", "qcom,scm";
+			clocks = <&rpmcc RPM_DAYTONA_FABRIC_CLK>;
+			clock-names = "core";
+		};
+	};
+
+	/*
+	 * The legacy Fuji/TWRP kernel and a physical TWRP /proc/iomem capture
+	 * both identify this as the 128 KiB persistent ram_console region.
+	 * Keep it mapped: ramoops writes the console itself.  The legacy recovery
+	 * enables Reed-Solomon ECC with its persistent_ram defaults, so mainline
+	 * must use the same 16-byte parity blocks for reliable full-ring capture.
+	 */
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		smem_region: smem@40000000 {
+			reg = <0x40000000 0x00200000>;
+			no-map;
+		};
+
+		ramoops@7ffe0000 {
+			compatible = "ramoops";
+			reg = <0x7ffe0000 0x00020000>;
+			console-size = <0x00020000>;
+			ecc-size = <16>;
+		};
+	};
+
+	/* Sony-programmed BQ27520 gauge data is read-only to this kernel. */
+	battery: battery {
+		compatible = "simple-battery";
+		device-chemistry = "lithium-ion";
+		charge-full-design-microamp-hours = <1900000>;
+		voltage-min-design-microvolt = <3000000>;
+		voltage-max-design-microvolt = <4200000>;
+		constant-charge-current-max-microamp = <1525000>;
+		constant-charge-voltage-max-microvolt = <4200000>;
+		charge-term-current-microamp = <50000>;
+	};
+
+	cpufreq: cpu-frequency-controller@903000 {
+		compatible = "qcom,msm8660-cpufreq";
+		reg = <0x00903000 0x1000>,
+		      <0x02041000 0x1000>,
+		      <0x02051000 0x1000>;
+		reg-names = "scpll", "acc0", "acc1";
+		qcom,l2cc = <&l2cc>;
+
+		cpu0-supply = <&saw0_reg>;
+		cpu1-supply = <&saw1_reg>;
+		mem-supply = <&pm8058_s0>;
+		dig-supply = <&pm8058_s1>;
+
+		interconnects = <&afab AFAB_MAS_AMPSS_M0 &afab AFAB_SLV_EBI_CH0>;
+		interconnect-names = "cpu-mem";
+		nvmem-cells = <&speed_bin>;
+		nvmem-cell-names = "speed-bin";
+	};
+
+	/*
+	 * The low bank starts at the historical MSM8x60 shared-memory physical
+	 * base.  CONFIG_ARCH_QCOM_RESERVE_SMEM then retains its first 2 MiB for
+	 * SMEM, leaving 0x40200000 as the first normal Linux address.  The legacy
+	 * resource view starts at that latter address.  The remaining ranges match
+	 * Sony's three-bank Fuji map exactly: 44 MiB at PHYS_OFFSET, 384 MiB at
+	 * 0x48000000 and 511 MiB at 0x60000000.  The gap below 0x48000000 and the
+	 * final MiB above 0x7fefffff are therefore intentionally not System RAM.
+	 */
+};
+
+/* Override the placeholder System RAM node supplied by qcom-msm8660.dtsi. */
+&{/memory@0} {
+	reg = <0x40000000 0x02e00000>,
+	      <0x48000000 0x18000000>,
+	      <0x60000000 0x1ff00000>;
+};
+
+/*
+ * The legacy kernel directly observed a low-speed UART at 0x19c40000.  Keep
+ * this common-SoC GSBI disabled until a physical console route is known; its
+ * required mux property is nevertheless part of a schema-valid description.
+ */
+&gsbi12 {
+	qcom,mode = <GSBI_PROT_I2C_UART>;
+};
+
+/*
+ * HSUSB1 is the connector-facing ChipIdea controller.  The address and IRQ
+ * are shared MSM8x60 facts and the two PHY rails come from the Fuji/Hikari
+ * downstream board code.  USB ID, VBUS detection and the protected VBUS
+ * source below reproduce the exact Sony connector topology in current USB
+ * role-switch and regulator frameworks.
+ */
+&{/} {
+	usb_connector: connector {
+		compatible = "gpio-usb-b-connector", "usb-b-connector";
+		type = "micro";
+		id-gpios = <&pm8058_gpio 31 GPIO_ACTIVE_HIGH>;
+		vbus-gpios = <&pm8058_mpps 11 GPIO_ACTIVE_LOW>;
+		vbus-supply = <&usb_otg_vbus>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&hikari_usb_id &hikari_usb_vbus_detect>;
+
+		port {
+			usb_connector_hs: endpoint {
+				remote-endpoint = <&usb_hs1_drd>;
+			};
+		};
+	};
+
+	usb_hs1: usb@12500000 {
+		compatible = "qcom,ci-hdrc";
+		reg = <0x12500000 0x200>, <0x12500200 0x200>;
+		interrupts = <GIC_SPI 100 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&gcc USB_HS1_H_CLK>, <&gcc USB_HS1_XCVR_CLK>;
+		clock-names = "iface", "core";
+		assigned-clocks = <&gcc USB_HS1_XCVR_CLK>;
+		assigned-clock-rates = <60000000>;
+		resets = <&gcc USB_HS1_RESET>;
+		reset-names = "core";
+		phy_type = "ulpi";
+		dr_mode = "otg";
+		usb-role-switch;
+		role-switch-default-mode = "peripheral";
+		ahb-burst-config = <0>;
+		phys = <&usb_hs1_phy>;
+		phy-names = "usb-phy";
+		#reset-cells = <1>;
+		status = "okay";
+
+		port {
+			usb_hs1_drd: endpoint {
+				remote-endpoint = <&usb_connector_hs>;
+			};
+		};
+
+		ulpi {
+			usb_hs1_phy: phy {
+				compatible = "qcom,usb-hs-phy-msm8660",
+					     "qcom,usb-hs-phy";
+				clocks = <&sleep_clk>, <&cxo_board>;
+				clock-names = "sleep", "ref";
+				resets = <&usb_hs1 0>;
+				reset-names = "por";
+				v1p8-supply = <&pm8058_l7>;
+				v3p3-supply = <&pm8058_l6>;
+				#phy-cells = <0>;
+			};
+		};
+	};
+
+	/* MSM8x60 multimedia infrastructure; all clocks are fed by RPM. */
+	mmcc: clock-controller@4000000 {
+		compatible = "qcom,mmcc-msm8660";
+		reg = <0x04000000 0x1000>;
+		#clock-cells = <1>;
+		#reset-cells = <1>;
+		#power-domain-cells = <1>;
+		/*
+		 * MSM8x60 GCC exposes PLL8 as the shared MMSS parent.  Hikari has
+		 * only DSI1 wired here.  Do not alias the absent DSI2 inputs to the
+		 * DSI1 PHY: both names would then resolve to the same clk_hw and CCF
+		 * would select the first matching mux entry (hardware value 1/DSI2)
+		 * instead of value 3/DSI1.
+		 */
+		clocks = <&pxo_board>, <&gcc PLL8_VOTE>, <&gcc PLL8_VOTE>,
+			 <&dsi_phy DSI_PIXEL_PLL_CLK>, <&dsi_phy DSI_BYTE_PLL_CLK>;
+		clock-names = "pxo", "pll3", "pll8_vote", "dsi1pll", "dsi1pllbyte";
+		status = "okay";
+	};
+
+	afab: interconnect-afab {
+		compatible = "qcom,msm8660-apps-fabric";
+		#interconnect-cells = <1>;
+		clocks = <&rpmcc RPM_APPS_FABRIC_CLK>, <&rpmcc RPM_APPS_FABRIC_A_CLK>,
+			 <&rpmcc RPM_EBI1_CLK>, <&rpmcc RPM_EBI1_A_CLK>;
+		clock-names = "bus", "bus_a", "ebi1", "ebi1_a";
+		qcom,rpm = <&rpm>;
+		status = "okay";
+	};
+
+	sfab: interconnect-sfab {
+		compatible = "qcom,msm8660-system-fabric";
+		#interconnect-cells = <1>;
+		clocks = <&rpmcc RPM_SYS_FABRIC_CLK>, <&rpmcc RPM_SYS_FABRIC_A_CLK>;
+		clock-names = "bus", "bus_a";
+		qcom,rpm = <&rpm>;
+		status = "okay";
+	};
+
+	mmfab: interconnect-mmfab {
+		compatible = "qcom,msm8660-mmss-fabric";
+		#interconnect-cells = <1>;
+		clocks = <&rpmcc RPM_MM_FABRIC_CLK>, <&rpmcc RPM_MM_FABRIC_A_CLK>,
+			 <&rpmcc RPM_SMI_CLK>, <&rpmcc RPM_SMI_A_CLK>;
+		clock-names = "bus", "bus_a", "smi", "smi_a";
+		qcom,rpm = <&rpm>;
+		status = "okay";
+	};
+
+	dfab: interconnect-dfab {
+		compatible = "qcom,msm8660-daytona-fabric";
+		#interconnect-cells = <1>;
+		clocks = <&rpmcc RPM_DAYTONA_FABRIC_CLK>, <&rpmcc RPM_DAYTONA_FABRIC_A_CLK>;
+		clock-names = "bus", "bus_a";
+		qcom,rpm = <&rpm>;
+		status = "okay";
+	};
+
+	mmss_sfpb: syscon@5700000 {
+		compatible = "qcom,msm8660-mmss-sfpb", "syscon";
+		reg = <0x05700000 0x1000>;
+	};
+
+	/*
+	 * MSM8x60 has two MDP IOMMU ports, each with two context banks. Sony's
+	 * devices-iommu.c gives these exact apertures and interrupt assignments;
+	 * the binding orders them non-secure first, secure second. Keep the
+	 * APQ8064 fallback because the upstream msm_iommu driver represents this
+	 * common first-generation Qualcomm IOMMU implementation.
+	 */
+	mdp_port0: iommu@7500000 {
+		compatible = "qcom,msm8660-iommu", "qcom,apq8064-iommu";
+		reg = <0x07500000 0x00100000>;
+		interrupts = <GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 63 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&mmcc SMMU_AHB_CLK>, <&mmcc MDP_AXI_CLK>;
+		clock-names = "smmu_pclk", "iommu_clk";
+		#iommu-cells = <1>;
+		qcom,ncb = <2>;
+		/* Physical context writes read back zero; no production client. */
+		status = "disabled";
+	};
+
+	mdp_port1: iommu@7600000 {
+		compatible = "qcom,msm8660-iommu", "qcom,apq8064-iommu";
+		reg = <0x07600000 0x00100000>;
+		interrupts = <GIC_SPI 62 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 61 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&mmcc SMMU_AHB_CLK>, <&mmcc MDP_AXI_CLK>;
+		clock-names = "smmu_pclk", "iommu_clk";
+		#iommu-cells = <1>;
+		qcom,ncb = <2>;
+		/* Physical context writes read back zero; no production client. */
+		status = "disabled";
+	};
+
+	mdp: display-controller@5100000 {
+		compatible = "qcom,mdp4";
+		reg = <0x05100000 0x000f0000>;
+		interrupts = <GIC_SPI 75 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&mmcc MDP_CLK>, <&mmcc MDP_AHB_CLK>,
+			 <&mmcc MDP_AXI_CLK>, <&mmcc MDP_LUT_CLK>,
+			 <&mmcc HDMI_APP_CLK>, <&mmcc MDP_TV_CLK>;
+		/* Names are the MDP4 DRM driver's DT ABI, not descriptive labels. */
+		clock-names = "core_clk", "iface_clk", "bus_clk", "lut_clk",
+			      "hdmi_clk", "tv_clk";
+		power-domains = <&mmcc MDP_GDSC>;
+		/*
+		 * The working Sony/TWRP Hikari configuration leaves MSM_IOMMU
+		 * disabled and scans out physically contiguous framebuffer memory.
+		 * Keep MDP detached until the MSM8x60 IOMMU register interface is
+		 * understood: on this device every context/MID write reads back zero.
+		 */
+		interconnects = <&mmfab MMFAB_MAS_MDP_PORT0
+				 &afab AFAB_SLV_EBI_CH0>;
+		interconnect-names = "mdp0-mem";
+		/*
+		 * The Sony MSM8x60 BSP powers mdp.0 through footswitch FS_MDP (4).
+		 * MMCC's MDP_GDSC is its genpd representation; the platform core
+		 * attaches and powers it before MDP4 may access 0x05100000.
+		 */
+		status = "okay";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			/*
+			 * MDP4 port 0 is the internal LCDC/LVDS path. The DRM/MSM
+			 * component walker deliberately skips it; DSI1 is port 1.
+			 */
+			port@1 {
+				reg = <1>;
+				mdp_out: endpoint { remote-endpoint = <&dsi_in>; };
+			};
+		};
+	};
+
+	/* The MSM8x60 PHY and PLL live inside the DSI register aperture. */
+	dsi_phy: dsi-phy@47000f0 {
+		compatible = "qcom,msm8660-dsi-phy-45nm";
+		reg = <0x047000f0 0x1e0>, <0x04700200 0xd0>;
+		reg-names = "dsi_phy", "dsi_pll";
+		vdda-supply = <&pm8058_l0>;
+		#clock-cells = <1>;
+		#phy-cells = <0>;
+		status = "okay";
+	};
+
+	dsi: dsi@4700000 {
+		compatible = "qcom,msm8660-dsi-ctrl", "qcom,mdss-dsi-ctrl";
+		reg = <0x04700000 0x200>;
+		reg-names = "dsi_ctrl";
+		interrupts = <GIC_SPI 82 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&mmcc DSI_M_AHB_CLK>, <&mmcc DSI_S_AHB_CLK>,
+			 <&mmcc AMP_AHB_CLK>, <&mmcc DSI_CLK>,
+			 <&mmcc DSI1_BYTE_CLK>,
+			 <&mmcc DSI_PIXEL_CLK>,
+			 <&mmcc DSI1_ESC_CLK>,
+			 <&rpmcc RPM_SFPB_CLK>, <&rpmcc RPM_SFPB_A_CLK>,
+			 <&rpmcc RPM_MMFPB_A_CLK>;
+		clock-names = "iface", "bus", "core_mmss", "src", "byte", "pixel", "core",
+			      "sfpb", "sfpb_a", "mmfpb_a";
+		/* Both dedicated DSI RCGs select DSI1 PLL with source value 3. */
+		assigned-clocks = <&mmcc DSI_SRC>, <&mmcc DSI_PIXEL_SRC>;
+		assigned-clock-parents = <&dsi_phy DSI_PIXEL_PLL_CLK>,
+					 <&dsi_phy DSI_PIXEL_PLL_CLK>;
+		phys = <&dsi_phy>;
+		phy-names = "dsi";
+		syscon-sfpb = <&mmss_sfpb>;
+		vdda-supply = <&pm8058_l0>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		status = "okay";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			port@0 { reg = <0>; dsi_in: endpoint { remote-endpoint = <&mdp_out>; }; };
+			port@1 { reg = <1>; dsi_out: endpoint { remote-endpoint = <&panel_in>; }; };
+		};
+
+		panel@0 {
+			compatible = "sony,hikari-r63306-tmd-mdv22";
+			reg = <0>;
+			vci-supply = <&pm8901_l2>;
+			vddio-supply = <&pm8901_lvs1>;
+			backlight = <&lcd_backlight>;
+			power-gpios = <&tlmm 18 GPIO_ACTIVE_HIGH>;
+			reset-gpios = <&tlmm 70 GPIO_ACTIVE_HIGH>;
+			port { panel_in: endpoint { remote-endpoint = <&dsi_out>; }; };
+		};
+	};
+};
+
+/* Exact PHY rails and operating voltages from the Hikari downstream BSP. */
+&rpm {
+	regulators-0 {
+		compatible = "qcom,rpm-pm8901-regulators";
+
+		pm8901_s0: s0 {
+			regulator-min-microvolt = <750000>;
+			regulator-max-microvolt = <1325000>;
+			qcom,switch-mode-frequency = <1600000>;
+		};
+
+		pm8901_s1: s1 {
+			regulator-min-microvolt = <750000>;
+			regulator-max-microvolt = <1325000>;
+			qcom,switch-mode-frequency = <1600000>;
+		};
+
+		pm8901_l2: l2 { regulator-min-microvolt = <2850000>; regulator-max-microvolt = <2850000>; };
+		pm8901_lvs1: lvs1 { regulator-always-on; };
+	};
+	regulators-1 {
+		compatible = "qcom,rpm-pm8058-regulators";
+
+		pm8058_s0: s0 {
+			regulator-min-microvolt = <800000>;
+			regulator-max-microvolt = <1325000>;
+			qcom,switch-mode-frequency = <1600000>;
+		};
+
+		pm8058_s1: s1 {
+			regulator-min-microvolt = <800000>;
+			regulator-max-microvolt = <1200000>;
+			qcom,switch-mode-frequency = <1600000>;
+		};
+
+		/* Shared WLAN/Timpani rail; exact voltage from Sony's Fuji BSP. */
+		pm8058_s3: s3 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			qcom,switch-mode-frequency = <1600000>;
+			regulator-always-on;
+			bias-pull-down;
+		};
+
+		pm8058_l6: l6 {
+			regulator-min-microvolt = <3050000>;
+			regulator-max-microvolt = <3050000>;
+			bias-pull-down;
+		};
+
+		pm8058_l7: l7 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			bias-pull-down;
+		};
+
+		pm8058_l0: l0 {
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1200000>;
+			/* Shared DSI/Timpani rail: Sony keeps it on during sleep. */
+			regulator-always-on;
+		};
+	};
+};
+
+&qfprom {
+	speed_bin: speed-bin@c0 {
+		reg = <0xc0 0x4>;
+	};
+};
+
+&gsbi8 {
+	qcom,mode = <GSBI_PROT_I2C>;
+	status = "okay";
+};
+
+&gsbi8_i2c {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	lcd_backlight: backlight@40 {
+		compatible = "ams,as3676-backlight";
+		reg = <0x40>;
+		/* Hikari routes the ambient-light photodiode to AS3676 GPIO2. */
+		ams,als-connected;
+		status = "okay";
+	};
+
+	/* Exact Fuji/Hikari GSBI8 addresses: BQ27520 = 0x55, BQ24160 = 0x6b. */
+	bq27520: fuel-gauge@55 {
+		compatible = "ti,bq27520g1";
+		/* Sony config disables automatic insertion of the fixed battery. */
+		ti,host-battery-insertion;
+		reg = <0x55>;
+		monitored-battery = <&battery>;
+		status = "okay";
+	};
+
+	bq24160: charger@6b {
+		compatible = "ti,bq24160";
+		reg = <0x6b>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <125 IRQ_TYPE_EDGE_BOTH>;
+		fuel-gauge = <&bq27520>;
+		/* Fuji/Hikari: GPIO126 low means the IN/cradle is connected. */
+		cradle-detect-gpios = <&tlmm 126 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&hikari_cradle_detect>;
+		ti,cradle-input-current-limit-microamp = <2500000>;
+		ti,in-vindpm-microvolt = <4520000>;
+		/* Owner-requested electrical probing; not USB current negotiation. */
+		ti,opportunistic-usb-input;
+		ti,usb-input-current-limit-microamp = <500000>;
+		ti,constant-charge-current-max-microamp = <1525000>;
+		ti,constant-charge-voltage-max-microvolt = <4200000>;
+		ti,charge-term-current-microamp = <50000>;
+		wakeup-source;
+		status = "okay";
+
+		usb_otg_guard: usb-otg-guard {
+			regulator-name = "usb-otg-guard";
+			regulator-min-microvolt = <5000000>;
+			regulator-max-microvolt = <5000000>;
+		};
+	};
+};
+
+#include "qcom-msm8260-sony-hikari-hardware.dtsi"
