diff --git a/Documentation/devicetree/bindings/power/supply/ti,bq24160.yaml b/Documentation/devicetree/bindings/power/supply/ti,bq24160.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..24fd5e2474687e81763f134de716ae080e68f342
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/ti,bq24160.yaml
@@ -0,0 +1,128 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/ti,bq24160.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Texas Instruments BQ24160 USB/IN power-path battery charger
+
+maintainers:
+  - Hikari Linux Project <noreply@example.invalid>
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: ti,bq24160
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  fuel-gauge:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Reference to the fuel gauge used for safe temperature and voltage policy.
+
+  ti,usb-input-current-limit-microamp:
+    description: Conservative USB input limit for an otherwise unknown source.
+    enum: [100000, 150000, 500000]
+
+  power-supplies:
+    maxItems: 1
+    description: |
+      USB source provider reporting USB_TYPE and CURRENT_MAX. Sources without
+      capability reporting retain the conservative limit unless electrical
+      probing is explicitly enabled.
+
+  ti,adapter-input-current-limit-microamp:
+    description: Board ceiling for a CDP/DCP source or explicitly enabled USB probing.
+    enum: [500000, 800000, 900000, 1500000]
+    default: 1500000
+
+  ti,usb-vindpm-microvolt:
+    description: USB input-voltage threshold for hardware droop regulation.
+    minimum: 4200000
+    maximum: 4760000
+    enum: [4200000, 4280000, 4360000, 4440000, 4520000, 4600000, 4680000, 4760000]
+    default: 4520000
+
+  cradle-detect-gpios:
+    maxItems: 1
+    description: Active-low input indicating attachment to a powered cradle.
+
+  ti,cradle-input-current-limit-microamp:
+    description: Board ceiling for the cradle IN input.
+    enum: [1500000, 2500000]
+    default: 2500000
+
+  ti,in-vindpm-microvolt:
+    description: IN input-voltage threshold for hardware droop regulation.
+    enum: [4200000, 4280000, 4360000, 4440000, 4520000, 4600000, 4680000, 4760000]
+    default: 4520000
+
+  ti,opportunistic-usb-input:
+    type: boolean
+    description: |
+      Explicitly permit electrical current probing on sources without USB
+      capability reporting. A USB2 device on a USB3 host is not guaranteed
+      permission above 500 mA. Known advertised limits are always respected.
+      Without this property, unknown sources stay at the conservative limit.
+
+  pinctrl-names: true
+  pinctrl-0: true
+
+  ti,constant-charge-current-max-microamp:
+    minimum: 550000
+    maximum: 2500000
+
+  ti,constant-charge-voltage-max-microvolt:
+    minimum: 3500000
+    maximum: 4440000
+    multipleOf: 20000
+
+  ti,charge-term-current-microamp:
+    minimum: 50000
+    maximum: 400000
+    multipleOf: 50000
+
+  wakeup-source: true
+
+  usb-otg-guard:
+    type: object
+    description: Regulator which disconnects charging while USB host VBUS is active.
+    $ref: /schemas/regulator/regulator.yaml#
+    unevaluatedProperties: false
+
+required:
+  - compatible
+  - reg
+  - fuel-gauge
+  - ti,usb-input-current-limit-microamp
+  - ti,constant-charge-current-max-microamp
+  - ti,constant-charge-voltage-max-microvolt
+  - ti,charge-term-current-microamp
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+    i2c {
+      #address-cells = <1>;
+      #size-cells = <0>;
+
+      charger@6b {
+        compatible = "ti,bq24160";
+        reg = <0x6b>;
+        interrupts = <7 IRQ_TYPE_EDGE_BOTH>;
+        fuel-gauge = <&fuel_gauge>;
+        ti,usb-input-current-limit-microamp = <500000>;
+        ti,constant-charge-current-max-microamp = <1525000>;
+        ti,constant-charge-voltage-max-microvolt = <4200000>;
+        ti,charge-term-current-microamp = <50000>;
+      };
+    };
+...
