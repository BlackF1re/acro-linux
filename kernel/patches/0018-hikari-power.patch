+bool qcom_mpm_msm8660_wake_supported(bool require_gic)
+{
+	struct qcom_mpm_priv *priv = READ_ONCE(msm8660_mpm);
+	struct irq_desc *desc;
+	unsigned int irq;
+	int bank;
+
+	if (!priv)
+		return false;
+	for (bank = 0; bank < MSM8660_MPM_BANKS; bank++) {
+		u32 both = priv->wake_enable[bank] & priv->dual_edge[bank];
+
+		while (both) {
+			unsigned int bit = __ffs(both);
+
+			if (msm8660_mpm_gpio_level(priv, bank * 32 + bit) < 0)
+				return false;
+			both &= ~BIT(bit);
+		}
+	}
+	for_each_irq_desc(irq, desc) {
+		struct irq_data *leaf = irq_desc_get_irq_data(desc);
+		struct irq_data *data;
+		const char *name = irq_data_get_irq_chip(leaf)->name ?: "";
+		bool mapped = false;
+
+		if (!irqd_is_wakeup_set(leaf))
+			continue;
+		for (data = leaf; data; data = data->parent_data)
+			if (data->domain == priv->domain)
+				mapped = true;
+		if (mapped)
+			continue;
+		if (!strcmp(name, "msmgpio"))
+			return false; /* PXO OFF loses an unmapped TLMM wake. */
+		if (!require_gic)
+			continue;
+		/* Resolve the actual board summary route (Hikari: TLMM88), not a
+		 * reference board's direct PMIC-to-GIC wiring.
+		 */
+		for (data = leaf; data; data = data->parent_data) {
+			struct device_node *np = data->domain ?
+				irq_domain_get_of_node(data->domain) : NULL;
+			const char *parent_name = irq_data_get_irq_chip(data)->name ?: "";
+
+			if (!strcmp(parent_name, "pm8xxx") &&
+			    msm8660_mpm_parent_mapped(priv, data))
+				mapped = true;
+			/* The ARM GIC's irq_print_chip supplies its name; .name is NULL. */
+			if (np && of_device_is_compatible(np, "qcom,msm-8660-qgic") &&
+			    msm8660_mpm_bypass(data->hwirq))
+				mapped = true;
+		}
+		if (!mapped) {
+			pr_debug("MSM8660 MPM: IRQ %u (%s, hwirq %lu) blocks VDD retention\n",
+				 irq, name, leaf->hwirq);
+			return false;
+		}
+	}
+	return true;
+}
