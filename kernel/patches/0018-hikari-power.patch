+static int msm8660_mpm_map(struct platform_device *pdev,
+			   struct qcom_mpm_priv *priv)
+{
+	struct device *dev = &pdev->dev;
+	struct of_phandle_args ipc;
+	struct resource res;
+	struct clk *clk;
+	int i, ret;
+
+	clk = devm_clk_get_enabled(dev, "ram");
+	if (IS_ERR(clk))
+		return PTR_ERR(clk);
+
+	/* These subranges are also owned by qcom_rpm, so do not reserve them. */
+	for (i = 0; i < 2; i++) {
+		ret = of_address_to_resource(dev->of_node, i, &res);
+		if (ret)
+			return ret;
+		if (resource_size(&res) < (i ? 8 : 32))
+			return -EINVAL;
+		if (i)
+			priv->status_base = devm_ioremap(dev, res.start, resource_size(&res));
+		else
+			priv->base = devm_ioremap(dev, res.start, resource_size(&res));
+	}
+	if (!priv->base || !priv->status_base)
+		return -ENOMEM;
+
+	ret = of_parse_phandle_with_fixed_args(dev->of_node, "qcom,ipc", 2, 0, &ipc);
+	if (ret)
+		return ret;
+	ret = of_address_to_resource(ipc.np, 0, &res);
+	of_node_put(ipc.np);
+	if (ret)
+		return ret;
+	if (resource_size(&res) < sizeof(u32) ||
+	    ipc.args[0] > resource_size(&res) - sizeof(u32) ||
+	    !IS_ALIGNED(ipc.args[0], sizeof(u32)) || ipc.args[1] >= 32)
+		return -EINVAL;
+	priv->ipc = devm_ioremap(dev, res.start + ipc.args[0], sizeof(u32));
+	if (!priv->ipc)
+		return -ENOMEM;
+	priv->ipc_value = BIT(ipc.args[1]);
+	return 0;
+}
