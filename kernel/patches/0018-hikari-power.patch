@@ -477,6 +857,7 @@ int qcom_rpm_write(struct qcom_rpm *rpm,
 
 	writel_relaxed(BIT(state), RPM_CTRL_REG(rpm, rpm->data->req_ctx_off));
 
+	rpm->ack_status = 0;
