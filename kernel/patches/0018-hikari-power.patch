diff --git a/arch/arm/mach-qcom/msm8660-sleep.S b/arch/arm/mach-qcom/msm8660-sleep.S
new file mode 100644
index 000000000..dd4a87b12
--- /dev/null
+++ b/arch/arm/mach-qcom/msm8660-sleep.S
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * MSM8x60 Scorpion power-collapse resume glue.
+ *
+ * Sony/CAF restored Scorpion L2CR1 while still running with the MMU off,
+ * before restoring the generic ARMv7 MMU context.  Generic cpu_suspend()
+ * does not know about this Qualcomm-specific register, so restore it here
+ * and then continue through the normal ARM cpu_resume_arm path.
+ */
+
+#include <linux/linkage.h>
+#include <asm/assembler.h>
+
+	.arm
+
+	.pushsection ".idmap.text", "ax"
+	.align 5
+
+SYM_CODE_START(msm8660_cpu_resume_arm)
+	ARM_BE8(setend be)
+
+	/* MPIDR[0] selects Scorpion CPU0/CPU1 on MSM8x60. */
+	mrc	p15, 0, r0, c0, c0, 5
+	and	r0, r0, #1
+
+	/*
+	 * adr_l is PC-relative.  Since this code executes at its physical
+	 * address with the MMU off, it obtains the physical address of the
+	 * saved array as required.
+	 */
+	adr_l	r1, msm8660_l2cr1_save
+	ldr	r1, [r1, r0, lsl #2]
+
+	/* Scorpion L2 cache control register 1. */
+	mcr	p15, 3, r1, c15, c0, 3
+	isb
+
+	b	cpu_resume_arm
+SYM_CODE_END(msm8660_cpu_resume_arm)
+
+	.popsection
+
+	.data
+	.align 3
+SYM_DATA_START(msm8660_l2cr1_save)
+	.space	8
+SYM_DATA_END(msm8660_l2cr1_save)
diff --git a/drivers/cpuidle/Kconfig.arm b/drivers/cpuidle/Kconfig.arm
index b88b01aa5..452e31d1c 100644
--- a/drivers/cpuidle/Kconfig.arm
+++ b/drivers/cpuidle/Kconfig.arm
@@ -130,3 +130,15 @@ config ARM_QCOM_SPM_CPUIDLE
 	  The Subsystem Power Manager (SPM) controls low power modes for the
 	  CPU and L2 cores. It interface with various system drivers to put
 	  the cores in low power modes.
+
+config ARM_QCOM_MSM8660_CPUIDLE
+	bool "CPU Idle Driver for MSM8260/MSM8660 Scorpion"
+	depends on ARCH_QCOM && !ARM64 && MMU
+	depends on CPU_IDLE
+	depends on QCOM_SCM=y
+	depends on REGULATOR_QCOM_MSM8660_SAW=y
+	select ARM_CPU_SUSPEND
+	select CPU_IDLE_MULTIPLE_DRIVERS
+	help
+	  Sony/CAF-compatible standalone CPU power collapse for MSM8260/MSM8660
+	  Scorpion cores using SAW v1 and the legacy TrustZone warm-boot ABI.
