+					     0, &args))
+		return false;
+	domain = irq_find_host(args.np);
+	irq = domain ? irq_find_mapping(domain, args.args[0]) : 0;
+	of_node_put(args.np);
+	for (data = irq_get_irq_data(irq); data; data = data->parent_data)
+		if (data->domain == priv->domain &&
+		    (priv->wake_enable[data->hwirq / 32] & BIT(data->hwirq % 32)))
+			mapped = true;
+	return mapped;
