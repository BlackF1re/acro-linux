+
+static int msm8660_rpmrs_aggregate_vdd(struct msm8660_rpmrs_vote *vote,
+					const u16 *levels, u32 level,
+					u32 upper_bound)
+{
+	u32 mv;
+
+	if (!vote->valid)
+		return 0;
+	if (level > QCOM_RPM_MSM8660_VDD_MAX ||
+	    upper_bound > QCOM_RPM_MSM8660_VDD_MAX)
+		return -EINVAL;
+
+	mv = vote->data[0] & MSM8660_RPMRS_VDD_MASK;
+	if (mv > levels[upper_bound])
+		return -EBUSY;
+
+	if (levels[level] > mv) {
+		vote->data[0] &= ~MSM8660_RPMRS_VDD_MASK;
+		vote->data[0] |= levels[level];
+	}
+
+	return 0;
+}
+
+static int msm8660_rpmrs_program_sleep_noirq(
+	u32 sclk_count, const struct qcom_rpm_msm8660_rpmrs_limits *limits)
+{
+	struct msm8660_rpmrs_votes votes;
+	struct qcom_rpm_request reqs[5];
+	struct qcom_rpm *rpm;
+	unsigned long flags;
+	u32 timed[2] = { 0, sclk_count };
+	u32 pxo;
+	u32 l2;
+	size_t nreqs = 0;
+	int ret;
+
+	if (WARN_ON_ONCE(!irqs_disabled()))
+		return -EPERM;
+	if (!limits)
+		return -EINVAL;
+	if (limits->pxo > QCOM_RPM_MSM8660_PXO_ON ||
+	    limits->l2_cache > QCOM_RPM_MSM8660_L2_ACTIVE ||
+	    limits->vdd_mem > QCOM_RPM_MSM8660_VDD_MAX ||
+	    limits->vdd_mem_upper_bound > QCOM_RPM_MSM8660_VDD_MAX ||
+	    limits->vdd_dig > QCOM_RPM_MSM8660_VDD_MAX ||
+	    limits->vdd_dig_upper_bound > QCOM_RPM_MSM8660_VDD_MAX)
+		return -EINVAL;
+
+	rpm = READ_ONCE(msm8660_rpm);
+	if (!rpm)
+		return -ENODEV;
+
+	spin_lock_irqsave(&msm8660_rpmrs_lock, flags);
+	votes = msm8660_rpmrs_votes;
+	spin_unlock_irqrestore(&msm8660_rpmrs_lock, flags);
+
+	/*
+	 * Sony's ordering makes larger PXO/L2 values less aggressive. Refuse
+	 * buffered requirements deeper than the selected level, then raise any
+	 * lower-power buffered vote up to the chosen conservative limit.
+	 */
+	pxo = votes.pxo_valid ? votes.pxo : limits->pxo;
+	if (pxo > limits->pxo)
+		return -EBUSY;
+	if (limits->pxo > pxo)
+		pxo = limits->pxo;
+
+	l2 = votes.l2_valid ? votes.l2 : limits->l2_cache;
+	if (l2 > limits->l2_cache)
+		return -EBUSY;
+	if (limits->l2_cache > l2)
+		l2 = limits->l2_cache;
+
+	ret = msm8660_rpmrs_aggregate_vdd(&votes.vdd_mem,
+					  msm8660_vdd_mem_levels,
+					  limits->vdd_mem,
+					  limits->vdd_mem_upper_bound);
+	if (ret)
+		return ret;
+
+	ret = msm8660_rpmrs_aggregate_vdd(&votes.vdd_dig,
+					  msm8660_vdd_dig_levels,
+					  limits->vdd_dig,
+					  limits->vdd_dig_upper_bound);
+	if (ret)
+		return ret;
+
+	reqs[nreqs++] = (struct qcom_rpm_request) {
+		.resource = QCOM_RPM_MSM8660_TRIGGER_TIMED,
+		.data = timed,
+		.count = ARRAY_SIZE(timed),
+	};
+	reqs[nreqs++] = (struct qcom_rpm_request) {
+		.resource = QCOM_RPM_PXO_CLK,
+		.data = &pxo,
+		.count = 1,
+	};
+	reqs[nreqs++] = (struct qcom_rpm_request) {
+		.resource = QCOM_RPM_APPS_L2_CACHE_CTL,
+		.data = &l2,
+		.count = 1,
+	};
+
+	if (votes.vdd_mem.valid)
+		reqs[nreqs++] = (struct qcom_rpm_request) {
+			.resource = QCOM_RPM_PM8058_SMPS0,
+			.data = votes.vdd_mem.data,
+			.count = ARRAY_SIZE(votes.vdd_mem.data),
+		};
+
+	if (votes.vdd_dig.valid)
+		reqs[nreqs++] = (struct qcom_rpm_request) {
+			.resource = QCOM_RPM_PM8058_SMPS1,
+			.data = votes.vdd_dig.data,
+			.count = ARRAY_SIZE(votes.vdd_dig.data),
+		};
+
+	return qcom_rpm_write_noirq(rpm, QCOM_RPM_SLEEP_STATE,
+				    reqs, nreqs);
+}
+
+int qcom_rpm_msm8660_rpmrs_enter_sleep_noirq(
+	u32 sclk_count, const struct qcom_rpm_msm8660_rpmrs_limits *limits)
+{
+	const struct qcom_rpm_msm8660_rpmrs_limits safe_limits =
+		QCOM_RPM_MSM8660_RPMRS_CONSERVATIVE_LIMITS;
+	int rollback_ret;
+	int ret;
+
+	if (WARN_ON_ONCE(!irqs_disabled()))
+		return -EPERM;
+
+	if (atomic_cmpxchg(&msm8660_rpmrs_sleep_state,
+			   MSM8660_RPMRS_SLEEP_IDLE,
+			   MSM8660_RPMRS_SLEEP_ENTERING) !=
+	    MSM8660_RPMRS_SLEEP_IDLE)
+		return -EBUSY;
+
+	ret = msm8660_rpmrs_program_sleep_noirq(sclk_count, limits);
+	if (!ret) {
+		atomic_set(&msm8660_rpmrs_sleep_state,
+			   MSM8660_RPMRS_SLEEP_ARMED);
+		return 0;
+	}
+
+	/*
+	 * A timeout leaves the RPM transaction outcome unknown.  Do not issue a
+	 * second request while its ACK may still arrive; keep the coordinator
+	 * fail-closed until a full reinitialization.
+	 */
+	if (ret == -ETIMEDOUT) {
+		atomic_set(&msm8660_rpmrs_sleep_state,
+			   MSM8660_RPMRS_SLEEP_UNCERTAIN);
+		return ret;
+	}
+
+	/* A rejected/mismatched ACK is consumed; replace any partial sleep set. */
+	if (ret == -EIO) {
+		rollback_ret = msm8660_rpmrs_program_sleep_noirq(0, &safe_limits);
+		if (rollback_ret) {
+			pr_err("MSM8660 RPMRS: sleep rollback failed: %d (entry %d)\n",
+			       rollback_ret, ret);
+			atomic_set(&msm8660_rpmrs_sleep_state,
+				   MSM8660_RPMRS_SLEEP_UNCERTAIN);
+			return rollback_ret;
+		}
+	}
+
+	atomic_set(&msm8660_rpmrs_sleep_state, MSM8660_RPMRS_SLEEP_IDLE);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_rpm_msm8660_rpmrs_enter_sleep_noirq);
+
+int qcom_rpm_msm8660_rpmrs_exit_sleep_noirq(bool collapsed)
+{
+	const struct qcom_rpm_msm8660_rpmrs_limits safe_limits =
+		QCOM_RPM_MSM8660_RPMRS_CONSERVATIVE_LIMITS;
+	int ret = 0;
+
+	if (WARN_ON_ONCE(!irqs_disabled()))
+		return -EPERM;
+
+	if (atomic_cmpxchg(&msm8660_rpmrs_sleep_state,
+			   MSM8660_RPMRS_SLEEP_ARMED,
+			   MSM8660_RPMRS_SLEEP_EXITING) !=
+	    MSM8660_RPMRS_SLEEP_ARMED)
+		return -EINVAL;
+
+	if (!collapsed) {
+		/*
+		 * No SAW/RPM collapse occurred. Leave a conservative, non-timed
+		 * sleep set for the next attempt instead of retaining the aborted
+		 * level or its timed wake request.
+		 */
+		ret = msm8660_rpmrs_program_sleep_noirq(0, &safe_limits);
+		if (ret) {
+			pr_err("MSM8660 RPMRS: abort rollback failed: %d\n", ret);
+			atomic_set(&msm8660_rpmrs_sleep_state,
+				   MSM8660_RPMRS_SLEEP_UNCERTAIN);
+			return ret;
+		}
+	}
+
+	/* RPM selects the ACTIVE set again as the CPU leaves sleep context. */
+	atomic_set(&msm8660_rpmrs_sleep_state, MSM8660_RPMRS_SLEEP_IDLE);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(qcom_rpm_msm8660_rpmrs_exit_sleep_noirq);
+
 int qcom_rpm_write(struct qcom_rpm *rpm,
 		   int state,
 		   int resource,
@@ -465,6 +841,10 @@ int qcom_rpm_write(struct qcom_rpm *rpm,
 		return -EINVAL;
 
 	mutex_lock(&rpm->lock);
+	if (atomic_cmpxchg(&rpm->busy, 0, 1)) {
+		ret = -EBUSY;
+		goto unlock;
+	}
 
 	for (i = 0; i < res->size; i++)
