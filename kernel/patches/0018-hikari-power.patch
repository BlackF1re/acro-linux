 	regmap_write(rpm->ipc_regmap, rpm->ipc_offset, BIT(rpm->ipc_bit));
 
@@ -486,23 +867,148 @@ int qcom_rpm_write(struct qcom_rpm *rpm,
 	else if (rpm->ack_status & RPM_REJECTED)
 		ret = -EIO;
 
+	atomic_set(&rpm->busy, 0);
+unlock:
