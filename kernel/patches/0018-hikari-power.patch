+	[QCOM_RPM_MSM8660_VDD_RET_LOW] = 500,
+	[QCOM_RPM_MSM8660_VDD_RET_HIGH] = 750,
+	[QCOM_RPM_MSM8660_VDD_ACTIVE] = 1000,
+	[QCOM_RPM_MSM8660_VDD_MAX] = 1325,
+};
+
+static const u16 msm8660_vdd_dig_levels[] = {
+	[QCOM_RPM_MSM8660_VDD_RET_LOW] = 500,
+	[QCOM_RPM_MSM8660_VDD_RET_HIGH] = 750,
+	[QCOM_RPM_MSM8660_VDD_ACTIVE] = 1000,
+	[QCOM_RPM_MSM8660_VDD_MAX] = 1250,
+};
+
+struct msm8660_rpmrs_vote {
+	bool valid;
+	u32 data[2];
+};
+
+struct msm8660_rpmrs_votes {
+	bool pxo_valid;
+	u32 pxo;
+	bool l2_valid;
+	u32 l2;
+	struct msm8660_rpmrs_vote vdd_mem;
+	struct msm8660_rpmrs_vote vdd_dig;
+};
+
+static DEFINE_SPINLOCK(msm8660_rpmrs_lock);
+static struct msm8660_rpmrs_votes msm8660_rpmrs_votes;
+static struct qcom_rpm *msm8660_rpm;
+
+enum msm8660_rpmrs_sleep_state {
+	MSM8660_RPMRS_SLEEP_IDLE,
+	MSM8660_RPMRS_SLEEP_ENTERING,
+	MSM8660_RPMRS_SLEEP_ARMED,
+	MSM8660_RPMRS_SLEEP_EXITING,
+	MSM8660_RPMRS_SLEEP_UNCERTAIN,
+};
+
+static atomic_t msm8660_rpmrs_sleep_state =
+	ATOMIC_INIT(MSM8660_RPMRS_SLEEP_IDLE);
+
+int qcom_rpm_msm8660_rpmrs_set_sleep_vote(int resource,
+					   const u32 *data, size_t count)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	if (!data)
+		return -EINVAL;
+
+	spin_lock_irqsave(&msm8660_rpmrs_lock, flags);
+
+	switch (resource) {
+	case QCOM_RPM_PXO_CLK:
+		if (count != 1) {
+			ret = -EINVAL;
+			break;
+		}
+		msm8660_rpmrs_votes.pxo = data[0];
+		msm8660_rpmrs_votes.pxo_valid = true;
+		break;
+	case QCOM_RPM_APPS_L2_CACHE_CTL:
+		if (count != 1) {
+			ret = -EINVAL;
+			break;
+		}
+		msm8660_rpmrs_votes.l2 = data[0];
+		msm8660_rpmrs_votes.l2_valid = true;
+		break;
+	case QCOM_RPM_PM8058_SMPS0:
+		if (count != 2) {
+			ret = -EINVAL;
+			break;
+		}
+		memcpy(msm8660_rpmrs_votes.vdd_mem.data, data,
+		       sizeof(msm8660_rpmrs_votes.vdd_mem.data));
+		msm8660_rpmrs_votes.vdd_mem.valid = true;
+		break;
+	case QCOM_RPM_PM8058_SMPS1:
+		if (count != 2) {
+			ret = -EINVAL;
+			break;
+		}
+		memcpy(msm8660_rpmrs_votes.vdd_dig.data, data,
+		       sizeof(msm8660_rpmrs_votes.vdd_dig.data));
+		msm8660_rpmrs_votes.vdd_dig.valid = true;
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	spin_unlock_irqrestore(&msm8660_rpmrs_lock, flags);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_rpm_msm8660_rpmrs_set_sleep_vote);
+
+int qcom_rpm_msm8660_rpmrs_clear_sleep_vote(int resource)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	spin_lock_irqsave(&msm8660_rpmrs_lock, flags);
+
+	switch (resource) {
+	case QCOM_RPM_PXO_CLK:
+		msm8660_rpmrs_votes.pxo_valid = false;
+		break;
+	case QCOM_RPM_APPS_L2_CACHE_CTL:
+		msm8660_rpmrs_votes.l2_valid = false;
+		break;
+	case QCOM_RPM_PM8058_SMPS0:
+		msm8660_rpmrs_votes.vdd_mem.valid = false;
+		break;
+	case QCOM_RPM_PM8058_SMPS1:
+		msm8660_rpmrs_votes.vdd_dig.valid = false;
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	spin_unlock_irqrestore(&msm8660_rpmrs_lock, flags);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_rpm_msm8660_rpmrs_clear_sleep_vote);
+
+/* Sony 6.2.B.1.96 board-semc_fuji.c: all eight Fuji levels. */
+struct msm8660_rpmrs_level {
+	enum qcom_rpm_msm8660_sleep_mode mode;
+	struct qcom_rpm_msm8660_rpmrs_limits limits;
+	u32 latency_us, steady_power, energy_overhead, time_overhead_us;
+};
+#define FUJI_LIMITS(pxo, l2, upper, minimum) { \
+	QCOM_RPM_MSM8660_PXO_##pxo, QCOM_RPM_MSM8660_L2_##l2, \
+	QCOM_RPM_MSM8660_VDD_##upper, QCOM_RPM_MSM8660_VDD_##minimum, \
+	QCOM_RPM_MSM8660_VDD_##upper, QCOM_RPM_MSM8660_VDD_##minimum }
+static const struct msm8660_rpmrs_level msm8660_rpmrs_levels[] = {
+	{ QCOM_RPM_MSM8660_SLEEP_WFI,
+	  FUJI_LIMITS(ON, ACTIVE, MAX, ACTIVE), 1, 8000, 100000, 1 },
+	{ QCOM_RPM_MSM8660_SLEEP_STANDALONE,
+	  FUJI_LIMITS(ON, ACTIVE, MAX, ACTIVE), 1500, 5000, 60100000, 3000 },
+	{ QCOM_RPM_MSM8660_SLEEP_RPM,
+	  FUJI_LIMITS(ON, ACTIVE, MAX, ACTIVE), 1800, 5000, 60350000, 3500 },
+	{ QCOM_RPM_MSM8660_SLEEP_RPM,
+	  FUJI_LIMITS(OFF, ACTIVE, MAX, ACTIVE), 3800, 4500, 65350000, 5500 },
+	{ QCOM_RPM_MSM8660_SLEEP_RPM,
+	  FUJI_LIMITS(ON, HSFS_OPEN, MAX, ACTIVE), 2800, 2500, 66850000, 4800 },
+	{ QCOM_RPM_MSM8660_SLEEP_RPM,
+	  FUJI_LIMITS(OFF, HSFS_OPEN, MAX, ACTIVE), 4800, 2000, 71850000, 6800 },
+	{ QCOM_RPM_MSM8660_SLEEP_RPM,
+	  FUJI_LIMITS(OFF, HSFS_OPEN, ACTIVE, RET_HIGH), 6800, 500, 75850000, 8800 },
+	{ QCOM_RPM_MSM8660_SLEEP_RPM,
+	  FUJI_LIMITS(OFF, HSFS_OPEN, RET_HIGH, RET_LOW), 7800, 0, 76350000, 9800 },
+};
+#undef FUJI_LIMITS
+
+static bool msm8660_rpmrs_level_available(const struct msm8660_rpmrs_votes *votes,
+		const struct qcom_rpm_msm8660_rpmrs_limits *limits)
+{
+	u32 mem = votes->vdd_mem.valid ? votes->vdd_mem.data[0] & MSM8660_RPMRS_VDD_MASK : 1000;
+	u32 dig = votes->vdd_dig.valid ? votes->vdd_dig.data[0] & MSM8660_RPMRS_VDD_MASK : 1000;
+
+	/* Missing PXO votes mean ON, as in Sony's beyond_limits callback. */
+	if ((votes->pxo_valid ? votes->pxo : QCOM_RPM_MSM8660_PXO_ON) > limits->pxo ||
+	    (votes->l2_valid && votes->l2 > limits->l2_cache) ||
+	    mem > msm8660_vdd_mem_levels[limits->vdd_mem_upper_bound] ||
+	    dig > msm8660_vdd_dig_levels[limits->vdd_dig_upper_bound])
+		return false;
+	if (limits->pxo == QCOM_RPM_MSM8660_PXO_OFF ||
+	    limits->vdd_dig <= QCOM_RPM_MSM8660_VDD_RET_HIGH)
+		return qcom_mpm_msm8660_wake_supported(
+			limits->vdd_dig_upper_bound <= QCOM_RPM_MSM8660_VDD_RET_HIGH);
+	return true;
+}
+
+int qcom_rpm_msm8660_rpmrs_select_sleep_noirq(u32 latency_us, u32 sleep_us,
+	struct qcom_rpm_msm8660_rpmrs_limits *limits,
+	enum qcom_rpm_msm8660_sleep_mode *mode, unsigned int *index)
+{
+	struct msm8660_rpmrs_votes votes;
+	unsigned long flags;
+	u64 best_power = U64_MAX;
+	int best = -1;
+	unsigned int i;
+
+	if (WARN_ON_ONCE(!irqs_disabled()))
+		return -EPERM;
+	spin_lock_irqsave(&msm8660_rpmrs_lock, flags);
+	votes = msm8660_rpmrs_votes;
+	spin_unlock_irqrestore(&msm8660_rpmrs_lock, flags);
+	for (i = 0; i < ARRAY_SIZE(msm8660_rpmrs_levels); i++) {
+		const struct msm8660_rpmrs_level *level = &msm8660_rpmrs_levels[i];
+		u64 power;
+
+		if (latency_us < level->latency_us || sleep_us <= level->time_overhead_us)
+			continue;
+		if (level->mode == QCOM_RPM_MSM8660_SLEEP_RPM &&
+		    !msm8660_rpmrs_level_available(&votes, &level->limits))
+			continue;
+		power = level->steady_power;
+		if ((sleep_us >> 10) <= level->time_overhead_us) {
+			power -= div_u64((u64)level->time_overhead_us * level->steady_power, sleep_us);
+			power += div_u64(level->energy_overhead, sleep_us);
+		}
+		if (power <= best_power) {
+			best_power = power;
+			best = i;
+		}
+	}
+	if (best < 0)
+		best = 0; /* The always-safe WFI fallback. */
+	*limits = msm8660_rpmrs_levels[best].limits;
+	*mode = msm8660_rpmrs_levels[best].mode;
+	*index = best;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(qcom_rpm_msm8660_rpmrs_select_sleep_noirq);
+
+static int msm8660_rpmrs_aggregate_vdd(struct msm8660_rpmrs_vote *vote,
+					const u16 *levels, u32 level,
+					u32 upper_bound)
+{
+	u32 mv;
+
+	if (!vote->valid)
+		return 0;
+	if (level > QCOM_RPM_MSM8660_VDD_MAX ||
+	    upper_bound > QCOM_RPM_MSM8660_VDD_MAX)
+		return -EINVAL;
+
+	mv = vote->data[0] & MSM8660_RPMRS_VDD_MASK;
+	if (mv > levels[upper_bound])
+		return -EBUSY;
+
+	if (levels[level] > mv) {
+		vote->data[0] &= ~MSM8660_RPMRS_VDD_MASK;
+		vote->data[0] |= levels[level];
+	}
+
+	return 0;
+}
+
+static int msm8660_rpmrs_program_sleep_noirq(
+	u32 sclk_count, const struct qcom_rpm_msm8660_rpmrs_limits *limits)
+{
+	struct msm8660_rpmrs_votes votes;
+	struct qcom_rpm_request reqs[5];
+	struct qcom_rpm *rpm;
+	unsigned long flags;
+	u32 timed[2] = { 0, sclk_count };
+	u32 pxo;
+	u32 l2;
+	size_t nreqs = 0;
+	int ret;
+
+	if (WARN_ON_ONCE(!irqs_disabled()))
+		return -EPERM;
+	if (!limits)
+		return -EINVAL;
+	if (limits->pxo > QCOM_RPM_MSM8660_PXO_ON ||
+	    limits->l2_cache > QCOM_RPM_MSM8660_L2_ACTIVE ||
+	    limits->vdd_mem > QCOM_RPM_MSM8660_VDD_MAX ||
+	    limits->vdd_mem_upper_bound > QCOM_RPM_MSM8660_VDD_MAX ||
+	    limits->vdd_dig > QCOM_RPM_MSM8660_VDD_MAX ||
+	    limits->vdd_dig_upper_bound > QCOM_RPM_MSM8660_VDD_MAX)
+		return -EINVAL;
+
+	rpm = READ_ONCE(msm8660_rpm);
+	if (!rpm)
+		return -ENODEV;
+
+	spin_lock_irqsave(&msm8660_rpmrs_lock, flags);
+	votes = msm8660_rpmrs_votes;
+	spin_unlock_irqrestore(&msm8660_rpmrs_lock, flags);
+
+	/*
+	 * Sony's ordering makes larger PXO/L2 values less aggressive. Refuse
+	 * buffered requirements deeper than the selected level, then raise any
+	 * lower-power buffered vote up to the chosen conservative limit.
+	 */
+	pxo = votes.pxo_valid ? votes.pxo : limits->pxo;
+	if (pxo > limits->pxo)
+		return -EBUSY;
+	if (limits->pxo > pxo)
+		pxo = limits->pxo;
+
+	l2 = votes.l2_valid ? votes.l2 : limits->l2_cache;
+	if (l2 > limits->l2_cache)
+		return -EBUSY;
+	if (limits->l2_cache > l2)
+		l2 = limits->l2_cache;
+
+	ret = msm8660_rpmrs_aggregate_vdd(&votes.vdd_mem,
+					  msm8660_vdd_mem_levels,
+					  limits->vdd_mem,
+					  limits->vdd_mem_upper_bound);
+	if (ret)
+		return ret;
+
+	ret = msm8660_rpmrs_aggregate_vdd(&votes.vdd_dig,
+					  msm8660_vdd_dig_levels,
+					  limits->vdd_dig,
+					  limits->vdd_dig_upper_bound);
+	if (ret)
+		return ret;
+
+	reqs[nreqs++] = (struct qcom_rpm_request) {
+		.resource = QCOM_RPM_MSM8660_TRIGGER_TIMED,
+		.data = timed,
+		.count = ARRAY_SIZE(timed),
+	};
+	reqs[nreqs++] = (struct qcom_rpm_request) {
+		.resource = QCOM_RPM_PXO_CLK,
+		.data = &pxo,
+		.count = 1,
+	};
+	reqs[nreqs++] = (struct qcom_rpm_request) {
+		.resource = QCOM_RPM_APPS_L2_CACHE_CTL,
+		.data = &l2,
+		.count = 1,
+	};
+
+	if (votes.vdd_mem.valid)
+		reqs[nreqs++] = (struct qcom_rpm_request) {
+			.resource = QCOM_RPM_PM8058_SMPS0,
+			.data = votes.vdd_mem.data,
+			.count = ARRAY_SIZE(votes.vdd_mem.data),
+		};
+
+	if (votes.vdd_dig.valid)
+		reqs[nreqs++] = (struct qcom_rpm_request) {
+			.resource = QCOM_RPM_PM8058_SMPS1,
+			.data = votes.vdd_dig.data,
+			.count = ARRAY_SIZE(votes.vdd_dig.data),
+		};
+
+	return qcom_rpm_write_noirq(rpm, QCOM_RPM_SLEEP_STATE,
+				    reqs, nreqs);
+}
+
+/* Sony uses MPM only when PXO or the APSS digital supply cannot retain wake. */
+static bool msm8660_rpmrs_use_mpm(const struct qcom_rpm_msm8660_rpmrs_limits *limits)
+{
+	return limits->pxo == QCOM_RPM_MSM8660_PXO_OFF ||
+	       limits->vdd_dig <= QCOM_RPM_MSM8660_VDD_RET_HIGH;
+}
+
+int qcom_rpm_msm8660_rpmrs_enter_sleep_noirq(
+	u32 sclk_count, const struct qcom_rpm_msm8660_rpmrs_limits *limits)
+{
+	const struct qcom_rpm_msm8660_rpmrs_limits safe_limits =
