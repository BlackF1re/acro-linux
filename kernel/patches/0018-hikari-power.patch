+/*
+ * Sony Fuji RPMRS resource policy.  The old regulator framework buffered
+ * SLEEP-context votes and RPMRS raised their voltage fields to the selected
+ * sleep level immediately before sending the batch.  Mainline does not yet
+ * produce those sleep votes, so keep the buffers optional: PXO/L2 are always
+ * made explicit, while VDD_MEM/VDD_DIG are sent only after a real vote exists.
+ */
+#define MSM8660_RPMRS_VDD_MASK	0x0fff
+
