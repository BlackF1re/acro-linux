+static void msm8660_mpm_replay(struct qcom_mpm_priv *priv);
+
+void qcom_mpm_msm8660_exit_sleep(void)
+{
+	struct qcom_mpm_priv *priv = READ_ONCE(msm8660_mpm);
+	unsigned long flags;
+	int i;
+
+	if (!priv)
+		return;
+	if (WARN_ON_ONCE(!irqs_disabled()))
+		return;
+
+	raw_spin_lock_irqsave(&priv->lock, flags);
+	if (!priv->armed)
+		goto unlock;
+	for (i = 0; i < MSM8660_MPM_BANKS; i++) {
+		priv->wake_status[i] = qcom_mpm_read(priv, MPM_REG_STATUS, i) &
+				       priv->wake_enable[i];
+		qcom_mpm_write(priv, MPM_REG_ENABLE, i, 0);
+		qcom_mpm_write(priv, MPM_REG_STATUS, i, 0);
+	}
+	msm8660_mpm_notify(priv);
+	/* Restore the AP-owned runtime buffer, without rearming physical MPM. */
+	for (i = 0; i < MSM8660_MPM_BANKS; i++)
+		qcom_mpm_write(priv, MPM_REG_ENABLE, i, priv->saved_enable[i]);
+	priv->armed = false;
+unlock:
+	raw_spin_unlock_irqrestore(&priv->lock, flags);
+	msm8660_mpm_replay(priv);
+}
