index 88cbc2a7aea86b9e51971105fbd7e3c46d722ee1..722c3e711405f633d0c280b544406ee85e041bc5 100644
--- a/drivers/cpuidle/Makefile
+++ b/drivers/cpuidle/Makefile
@@ -46,3 +46,4 @@ obj-$(CONFIG_RISCV_SBI_CPUIDLE)		+= cpuidle-riscv-sbi.o
 ###############################################################################
 # S390 drivers
