+static int mdp4_suspend_noirq(struct device *dev)
+{
+	struct msm_drm_private *priv = dev_get_drvdata(dev);
+
+	if (priv && priv->kms)
+		to_mdp4_kms(to_mdp_kms(priv->kms))->needs_resume_init = true;
+	return 0;
+}
+
+static void mdp4_pm_complete(struct device *dev)
+{
+	struct msm_drm_private *priv = dev_get_drvdata(dev);
+	struct mdp4_kms *mdp4_kms;
+	struct mdp_kms *mdp_kms;
+	int ret;
+
+	if (!priv || !priv->kms)
+		return;
+	mdp_kms = to_mdp_kms(priv->kms);
+	mdp4_kms = to_mdp4_kms(mdp_kms);
+	if (mdp4_kms->needs_resume_init) {
+		/* Domain collapse loses fetch configuration and IRQ enables. */
+		ret = mdp4_hw_init(priv->kms);
+		if (ret)
+			goto fail;
+		ret = mdp4_enable(mdp4_kms);
+		if (ret)
+			goto fail;
+		mdp4_set_irqmask(mdp_kms, mdp_kms->cur_irq_mask, 0);
+		mdp4_disable(mdp4_kms);
+		mdp4_kms->needs_resume_init = false;
+	}
+	msm_kms_pm_complete(dev);
+	return;
+fail:
+	dev_err(dev, "MDP4 resume initialization failed: %d\n", ret);
+}
+
 static const struct dev_pm_ops mdp4_pm_ops = {
 	.prepare = msm_kms_pm_prepare,
-	.complete = msm_kms_pm_complete,
+	.suspend_noirq = mdp4_suspend_noirq,
+	.complete = mdp4_pm_complete,
 };
 
