+static struct msm8660_rpmrs_votes msm8660_rpmrs_votes;
+static struct qcom_rpm *msm8660_rpm;
+
+enum msm8660_rpmrs_sleep_state {
+	MSM8660_RPMRS_SLEEP_IDLE,
+	MSM8660_RPMRS_SLEEP_ENTERING,
+	MSM8660_RPMRS_SLEEP_ARMED,
+	MSM8660_RPMRS_SLEEP_EXITING,
+	MSM8660_RPMRS_SLEEP_UNCERTAIN,
+};
+
+static atomic_t msm8660_rpmrs_sleep_state =
+	ATOMIC_INIT(MSM8660_RPMRS_SLEEP_IDLE);
+
+int qcom_rpm_msm8660_rpmrs_set_sleep_vote(int resource,
+					   const u32 *data, size_t count)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	if (!data)
+		return -EINVAL;
+
+	spin_lock_irqsave(&msm8660_rpmrs_lock, flags);
+
+	switch (resource) {
+	case QCOM_RPM_PXO_CLK:
+		if (count != 1) {
+			ret = -EINVAL;
+			break;
+		}
+		msm8660_rpmrs_votes.pxo = data[0];
+		msm8660_rpmrs_votes.pxo_valid = true;
+		break;
+	case QCOM_RPM_APPS_L2_CACHE_CTL:
+		if (count != 1) {
+			ret = -EINVAL;
+			break;
+		}
+		msm8660_rpmrs_votes.l2 = data[0];
+		msm8660_rpmrs_votes.l2_valid = true;
+		break;
+	case QCOM_RPM_PM8058_SMPS0:
+		if (count != 2) {
+			ret = -EINVAL;
+			break;
+		}
+		memcpy(msm8660_rpmrs_votes.vdd_mem.data, data,
+		       sizeof(msm8660_rpmrs_votes.vdd_mem.data));
+		msm8660_rpmrs_votes.vdd_mem.valid = true;
+		break;
+	case QCOM_RPM_PM8058_SMPS1:
+		if (count != 2) {
+			ret = -EINVAL;
+			break;
+		}
+		memcpy(msm8660_rpmrs_votes.vdd_dig.data, data,
+		       sizeof(msm8660_rpmrs_votes.vdd_dig.data));
+		msm8660_rpmrs_votes.vdd_dig.valid = true;
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	spin_unlock_irqrestore(&msm8660_rpmrs_lock, flags);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_rpm_msm8660_rpmrs_set_sleep_vote);
+
+int qcom_rpm_msm8660_rpmrs_clear_sleep_vote(int resource)
+{
