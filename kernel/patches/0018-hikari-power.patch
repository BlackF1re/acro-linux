diff --git a/arch/arm/mach-qcom/msm8660-sleep.S b/arch/arm/mach-qcom/msm8660-sleep.S
new file mode 100644
index 0000000000000000000000000000000000000000..889da56f16cda788599cc6c70b12818c0dac4cc3
--- /dev/null
+++ b/arch/arm/mach-qcom/msm8660-sleep.S
@@ -0,0 +1,69 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * MSM8x60 Scorpion power-collapse resume glue.
+ *
+ * Sony/CAF restored Scorpion L2CR1 while still running with the MMU off,
+ * before restoring the generic ARMv7 MMU context.  Generic cpu_suspend()
+ * does not know about this Qualcomm-specific register, so restore it here
+ * and then continue through the normal ARM cpu_resume_arm path.
+ */
+
+#include <linux/linkage.h>
+#include <asm/assembler.h>
+
+	.arm
+
+	.pushsection ".idmap.text", "ax"
+	.align 5
+
+SYM_CODE_START(msm8660_cpu_warm_boot)
+	ARM_BE8(setend be)
+
+	/* MPIDR[0] selects Scorpion CPU0/CPU1 on MSM8x60. */
+	mrc	p15, 0, r0, c0, c0, 5
+	and	r0, r0, #1
+
+	/*
+	 * CPU1 hotplug has no cpu_suspend() context to restore. Route only
+	 * that case back through the generic secondary startup path; cpuidle
+	 * and CPU0 system suspend continue through cpu_resume_arm.
+	 */
+	adr_l	r1, msm8660_hotplug_resume
+	ldr	r2, [r1, r0, lsl #2]
+	cmp	r2, #0
+	beq	1f
+
+	/* Sony's hotplug holding pen waits for fresh secondary_data. */
+2:	ldr	r2, [r1, r0, lsl #2]
+	cmp	r2, #2
+	bne	2b
+	b	secondary_startup_arm
+1:
+
+	/*
+	 * adr_l is PC-relative.  Since this code executes at its physical
+	 * address with the MMU off, it obtains the physical address of the
+	 * saved array as required.
+	 */
+	adr_l	r1, msm8660_l2cr1_save
+	ldr	r1, [r1, r0, lsl #2]
+
+	/* Scorpion L2 cache control register 1. */
+	mcr	p15, 3, r1, c15, c0, 3
+	isb
+
+	b	cpu_resume_arm
+SYM_CODE_END(msm8660_cpu_warm_boot)
+
+	.popsection
+
+	.data
+	.align 3
+SYM_DATA_START(msm8660_l2cr1_save)
+	.space	8
+SYM_DATA_END(msm8660_l2cr1_save)
+
+	.align 3
+SYM_DATA_START(msm8660_hotplug_resume)
+	.space	8
+SYM_DATA_END(msm8660_hotplug_resume)
diff --git a/arch/arm/mach-qcom/platsmp.c b/arch/arm/mach-qcom/platsmp.c
index eca2fe0f4314b12e6e1220e9409afabbedca2f94..1fce9ee10a589ea2d7b5a5688b77042effa32016 100644
--- a/arch/arm/mach-qcom/platsmp.c
+++ b/arch/arm/mach-qcom/platsmp.c
@@ -15,7 +15,9 @@
 #include <linux/smp.h>
 #include <linux/io.h>
 #include <linux/firmware/qcom/qcom_scm.h>
+#include <linux/regulator/qcom-msm8660-saw.h>
 
+#include <asm/cacheflush.h>
 #include <asm/smp_plat.h>
 
 
@@ -49,6 +51,101 @@ static void qcom_cpu_die(unsigned int cpu)
 {
 	wfi();
 }
+
+#ifdef CONFIG_ARM_QCOM_MSM8660_CPUIDLE
+extern u32 msm8660_hotplug_resume[2];
+extern u32 msm8660_avs_disable(void);
+extern void msm8660_avs_restore(u32 avsdscr);
+
+static u32 msm8660_hotplug_avsdscr[2];
+
+static void msm8660_cpu_die(unsigned int cpu)
+{
+	u32 sctlr;
+	u32 disabled;
+	u32 release;
+	int ret;
+
+	if (WARN_ON_ONCE(cpu != raw_smp_processor_id() || cpu >= 2))
+		return;
+
+	/*
+	 * The warm-boot address is system-wide. Mark this CPU before the
+	 * collapse so the MMU-off trampoline can distinguish hotplug from a
+	 * normal cpu_suspend() resume.
+	 */
+	WRITE_ONCE(msm8660_hotplug_resume[cpu], 1);
+	sync_cache_w(&msm8660_hotplug_resume[cpu]);
+
+	msm8660_hotplug_avsdscr[cpu] = msm8660_avs_disable();
+	/* __cpu_disable() masked all SGIs, including our only wake signal. */
+	arch_enable_wakeup_ipi();
+
+	ret = msm8660_saw_set_power_collapse(cpu, true,
+					     MSM8660_SAW_COLLAPSE_STANDALONE);
+	if (ret)
+		goto restore_avs;
+
+	asm volatile("mrc p15, 0, %0, c1, c0, 0"
+		     : "=r" (sctlr));
+
+	disabled = sctlr & ~(BIT(2) | BIT(12));
+	flush_cache_all();
+
+	asm volatile(
+		"mcr p15, 0, %2, c1, c0, 0\n\t"
+		"isb\n\t"
+		"dsb\n\t"
+		"1: wfi\n\t"
+		"ldr %0, [%3]\n\t"
+		"cmp %0, #2\n\t"
+		"bne 1b\n\t"
+		"mcr p15, 0, %1, c1, c0, 0\n\t"
+		"isb\n\t"
+		: "=&r" (release)
+		: "r" (sctlr), "r" (disabled),
+		  "r" (&msm8660_hotplug_resume[cpu])
+		: "cc", "memory");
+
+	/* WFI returned, so the core did not actually collapse. */
+	ret = msm8660_saw_set_power_collapse(cpu, false,
+					     MSM8660_SAW_COLLAPSE_STANDALONE);
+	if (ret)
+		pr_warn("CPU%u: failed to restore SAW after aborted hotplug: %d\n",
+			cpu, ret);
+
+restore_avs:
+	msm8660_avs_restore(msm8660_hotplug_avsdscr[cpu]);
+	/* Failed/aborted collapse must also wait for a requested online. */
+	while (READ_ONCE(msm8660_hotplug_resume[cpu]) != 2)
+		cpu_relax();
+	WRITE_ONCE(msm8660_hotplug_resume[cpu], 0);
+	sync_cache_w(&msm8660_hotplug_resume[cpu]);
+}
+
+static void msm8660_secondary_init(unsigned int cpu)
+{
+	int ret;
+
+	if (cpu >= 2 || !READ_ONCE(msm8660_hotplug_resume[cpu]))
+		return;
+
+	/*
+	 * A successfully collapsed CPU never returns through cpu_die().
+	 * Restore SAW clock-gating mode and the Sony AVS state here instead.
+	 */
+	ret = msm8660_saw_set_power_collapse(cpu, false,
+					     MSM8660_SAW_COLLAPSE_STANDALONE);
+	if (ret)
+		pr_warn("CPU%u: failed to restore SAW after hotplug: %d\n",
+			cpu, ret);
+
+	msm8660_avs_restore(msm8660_hotplug_avsdscr[cpu]);
+
+	WRITE_ONCE(msm8660_hotplug_resume[cpu], 0);
+	sync_cache_w(&msm8660_hotplug_resume[cpu]);
+}
+#endif
 #endif
 
 static int scss_release_secondary(unsigned int cpu)
@@ -335,6 +432,13 @@ static int qcom_boot_secondary(unsigned int cpu, int (*func)(unsigned int))
 
 static int msm8660_boot_secondary(unsigned int cpu, struct task_struct *idle)
 {
+#ifdef CONFIG_ARM_QCOM_MSM8660_CPUIDLE
+	/* __cpu_up() has published new secondary_data before this callback. */
+	if (cpu < 2 && READ_ONCE(msm8660_hotplug_resume[cpu])) {
+		WRITE_ONCE(msm8660_hotplug_resume[cpu], 2);
+		sync_cache_w(&msm8660_hotplug_resume[cpu]);
+	}
+#endif
 	return qcom_boot_secondary(cpu, scss_release_secondary);
 }
 
@@ -371,8 +475,13 @@ static const struct smp_operations smp_msm8660_ops __initconst = {
 	.smp_prepare_cpus	= qcom_smp_prepare_cpus,
 	.smp_boot_secondary	= msm8660_boot_secondary,
 #ifdef CONFIG_HOTPLUG_CPU
+#ifdef CONFIG_ARM_QCOM_MSM8660_CPUIDLE
+	.smp_secondary_init	= msm8660_secondary_init,
+	.cpu_die		= msm8660_cpu_die,
+#else
 	.cpu_die		= qcom_cpu_die,
 #endif
+#endif
 };
 CPU_METHOD_OF_DECLARE(qcom_smp, "qcom,gcc-msm8660", &smp_msm8660_ops);
 
