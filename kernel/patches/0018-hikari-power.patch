+/* Arm the opposite edge for a dual-edge TLMM wake source, while TLMM is on. */
+static int msm8660_mpm_gpio_level(struct qcom_mpm_priv *priv, unsigned int pin)
+{
+	struct irq_desc *desc;
+	unsigned int irq;
+
+	for_each_irq_desc(irq, desc) {
+		struct irq_data *leaf = irq_desc_get_irq_data(desc);
+		struct irq_data *data;
+		struct gpio_chip *chip = irq_data_get_irq_chip_data(leaf);
+
+		if (strcmp(irq_data_get_irq_chip(leaf)->name ?: "", "msmgpio"))
+			continue;
+		if (!chip || chip->can_sleep || !chip->get)
+			return -EOPNOTSUPP;
+		for (data = leaf->parent_data; data; data = data->parent_data)
+			if (data->domain == priv->domain && data->hwirq == pin &&
+			    leaf->hwirq < chip->ngpio)
+				return chip->get(chip, leaf->hwirq);
+	}
+	return -EOPNOTSUPP;
+}
