+/* Called with local IRQs off, before resume_device_irqs() clears wake arming. */
+static void msm8660_mpm_replay(struct qcom_mpm_priv *priv)
+{
+	int i, bit;
+
+	for (i = 0; i < MSM8660_MPM_BANKS; i++) {
+		unsigned long pending = priv->wake_status[i];
+
+		priv->wake_status[i] = 0;
+		for_each_set_bit(bit, &pending, 32) {
+			unsigned int pin = i * 32 + bit;
+			struct irq_desc *desc = irq_resolve_mapping(priv->domain, pin);
+			struct irq_data *d;
+			int ret;
+
+			if (!desc)
+				continue;
+			d = irq_desc_get_irq_data(desc);
+			/* Levels reassert in hardware; do not duplicate an observed wake. */
+			if (irqd_is_level_type(d) || !irqd_is_wakeup_armed(d))
+				continue;
+			if (get_mpm_gic_map(priv, pin)) {
+				ret = irq_set_irqchip_state(d->irq, IRQCHIP_STATE_PENDING, true);
+			} else {
+				/*
+				 * TLMM INTR_STATUS is W1C, not a pending-set register.
+				 * Its armed edge flow invokes irq_pm_handle_wakeup():
+				 * mark suspended/pending without running device actions.
+				 * Generic IRQ resume then performs software resend.
+				 */
+				ret = generic_handle_irq_safe(d->irq);
+			}
+			if (ret)
+				pr_err_ratelimited("MSM8660 MPM: cannot replay pin %u IRQ %u: %d\n",
+						   pin, d->irq, ret);
+		}
+	}
+}
