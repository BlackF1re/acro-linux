@@ -0,0 +1,106 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/interrupt-controller/qcom,msm8660-mpm.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm MSM8660 legacy MPM wake interrupt controller
+
+maintainers:
+  - BlackF1re <55582873+BlackF1re@users.noreply.github.com>
+
+description: |
+  MSM8660 uses separate request and pending-status windows in RPM message
+  RAM, with 64 wake pins. Unlike later vMPM controllers, it has one edge
+  detection bank, no MPM timer words and a write-one-to-clear request bank.
+  RPM notification uses the APSS IPC register. The message RAM subranges
+  are shared with the RPM resource controller.
+
+allOf:
+  - $ref: /schemas/interrupt-controller.yaml#
+
+properties:
+  compatible:
+    const: qcom,msm8660-mpm
+
+  reg:
+    items:
+      - description: Request window (enable, detect, polarity, clear)
+      - description: Read-only pending status window
+
+  reg-names:
+    items:
+      - const: request
+      - const: status
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: ram
+
+  qcom,ipc:
+    description: APSS IPC register and doorbell bit used to notify RPM.
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    items:
+      - items:
+          - description: APSS IPC register provider
+          - description: Register offset
+          - description: IPC bit number
+
+  interrupt-controller: true
+
+  '#interrupt-cells':
+    const: 2
+
+  qcom,mpm-pin-count:
+    const: 64
+
+  qcom,mpm-pin-map:
+    description: Mapping of MPM wake pins to GIC SPI interrupt numbers.
+    $ref: /schemas/types.yaml#/definitions/uint32-matrix
+    items:
+      items:
+        - description: MPM pin
+          minimum: 0
+          maximum: 63
+        - description: GIC SPI number (excluding the 32 SGI/PPI entries)
+          minimum: 0
+          maximum: 987
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - clocks
+  - clock-names
+  - qcom,ipc
+  - interrupt-controller
+  - '#interrupt-cells'
+  - qcom,mpm-pin-count
+  - qcom,mpm-pin-map
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/qcom,gcc-msm8660.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    interrupt-controller@1049d8 {
+        compatible = "qcom,msm8660-mpm";
+        reg = <0x001049d8 0x20>, <0x00104df8 0x8>;
+        reg-names = "request", "status";
+        interrupts = <GIC_SPI 20 IRQ_TYPE_EDGE_RISING>;
+        interrupt-parent = <&intc>;
+        clocks = <&gcc RPM_MSG_RAM_H_CLK>;
+        clock-names = "ram";
+        qcom,ipc = <&l2cc 0x8 1>;
+        interrupt-controller;
+        #interrupt-cells = <2>;
+        qcom,mpm-pin-count = <64>;
+        qcom,mpm-pin-map = <25 100>, <26 50>, <27 79>;
+    };
