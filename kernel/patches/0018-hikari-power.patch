 }
 EXPORT_SYMBOL(qcom_rpm_write);
 
+int qcom_rpm_write_noirq(struct qcom_rpm *rpm, int state,
+			 const struct qcom_rpm_request *reqs, size_t nreqs)
+{
+	const struct qcom_rpm_data *data = rpm->data;
+	u32 sel_mask[RPM_MAX_SEL_SIZE] = { 0 };
+	u32 ack_sel[RPM_MAX_SEL_SIZE] = { 0 };
+	u32 expected_ctx;
+	u32 ack;
+	unsigned int timeout;
+	size_t n;
+	int ret = 0;
+	int i;
+
+	if (WARN_ON_ONCE(!irqs_disabled()))
+		return -EPERM;
+	if (!reqs || !nreqs)
+		return -EINVAL;
+	if (state != QCOM_RPM_ACTIVE_STATE && state != QCOM_RPM_SLEEP_STATE)
+		return -EINVAL;
+	if (!rpm->ipc_base)
+		return -ENODEV;
+	if (atomic_cmpxchg(&rpm->busy, 0, 1))
+		return -EBUSY;
+
+	expected_ctx = BIT(state);
+
+	for (n = 0; n < nreqs; n++) {
+		const struct qcom_rpm_resource *res;
+		const struct qcom_rpm_request *req = &reqs[n];
+
+		if (req->resource < 0 || req->resource >= data->n_resources) {
+			ret = -EINVAL;
+			goto out_busy;
+		}
+
+		res = &data->resource_table[req->resource];
+		if (!req->data || res->size != req->count ||
+		    res->select_id >= data->req_sel_size * 32) {
+			ret = -EINVAL;
+			goto out_busy;
+		}
+
+		for (i = 0; i < res->size; i++)
+			writel_relaxed(req->data[i],
+				       RPM_REQ_REG(rpm, res->target_id + i));
+
+		sel_mask[res->select_id / 32] |= BIT(res->select_id % 32);
+	}
+
+	/*
+	 * The noirq path owns the ACK handshake. Mask the interrupt handlers
+	 * while polling message RAM, matching the old Sony msm_rpm_set_noirq()
+	 * contract. A delayed ACK interrupt is harmless: the handler ignores
+	 * an already-cleared ACK_CTX.
+	 */
