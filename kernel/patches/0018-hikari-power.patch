+/*
+ * Program the exact MSM8x60/Fuji power-collapse SAW sequence.
+ *
+ * Sony/CAF uses the same POWER_COLLAPSE mode and PMIC levels for both
+ * standalone and RPM-coordinated collapse. The only SAW v1 difference is
+ * SPM_CTL[3]: standalone bypasses RPM, while full system collapse clears the
+ * bypass bit so SAW notifies RPM.
+ *
+ * The awake voltage is taken from live SAW status because modern cpufreq
+ * changes it dynamically rather than leaving the historical 0xa0 constant.
+ * Disabling collapse always returns to CLOCK_GATING with RPM bypassed, just
+ * like msm_spm_set_low_power_mode(CLOCK_GATING, false).
+ *
+ * This must run on the CPU controlled by this SAW.
+ */
+int msm8660_saw_set_power_collapse(unsigned int cpu, bool enable,
+				   enum msm8660_saw_collapse_mode mode)
+{
+	struct msm8660_saw *saw;
+	u32 spm_ctl;
+	u32 pmic_ctl;
+	u32 sts;
+	u8 awake_vlevel;
+
+	if (cpu >= NR_SCORPION_CPUS || cpu != raw_smp_processor_id())
+		return -EINVAL;
+	if (mode != MSM8660_SAW_COLLAPSE_STANDALONE &&
+	    mode != MSM8660_SAW_COLLAPSE_NOTIFY_RPM)
+		return -EINVAL;
+
+	saw = READ_ONCE(msm8660_saw_cpus[cpu]);
+	if (!saw)
+		return -ENODEV;
+
+	spm_ctl = readl_relaxed(saw->base + SAW_SPM_CTL);
+	pmic_ctl = readl_relaxed(saw->base + SAW_PMIC_CTL);
+
+	/* Clear mode and RPM-bypass fields. */
+	spm_ctl &= ~0x0f;
+
+	if (enable) {
+		sts = readl_relaxed(saw->base + SAW_STS);
+		if (SAW_STS_PMIC_STATE(sts) != 0)
+			return -EBUSY;
+
+		awake_vlevel = SAW_STS_PMIC_DATA(sts);
+
+		/*
+		 * Historical MSM_SPM_MODE_POWER_COLLAPSE encoding is 0x02.
+		 * SPM_CTL[3] is RPM bypass: set it only for standalone PC.
+		 */
+		spm_ctl |= 0x02;
+		if (mode == MSM8660_SAW_COLLAPSE_STANDALONE)
+			spm_ctl |= 0x08;
+
+		pmic_ctl = (HIKARI_COLLAPSE_MID_VLEVEL << 16) |
+			   (awake_vlevel << 8) |
+			   HIKARI_COLLAPSE_VLEVEL;
