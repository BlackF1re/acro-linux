diff --git a/drivers/cpuidle/cpuidle-qcom-msm8660.c b/drivers/cpuidle/cpuidle-qcom-msm8660.c
new file mode 100644
index 0000000000000000000000000000000000000000..9995be79b60573d93f13cb4880ac3ea08b70aabf
--- /dev/null
+++ b/drivers/cpuidle/cpuidle-qcom-msm8660.c
@@ -0,0 +1,392 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Sony/CAF-style MSM8260/MSM8660 Scorpion power collapse.
+ *
+ * CPU idle uses standalone power collapse:
+ *
+ *   cpu_pm_enter()
+ *     -> SAW POWER_COLLAPSE, RPM bypassed
+ *     -> save Scorpion L2CR1
+ *     -> cpu_suspend()
+ *     -> full cache flush
+ *     -> disable I/D cache
+ *     -> WFI / core power collapse
+ *     -> TrustZone warm boot
+ *     -> restore L2CR1 with MMU off
+ *     -> generic cpu_resume_arm
+ *     -> SAW CLOCK_GATING
+ *   cpu_pm_exit()
+ *
+ * System suspend additionally enters the conservative RPM sleep set and
+ * uses SAW's RPM-notified collapse mode. Both paths share the same CPU
+ * context and warm-resume sequence.
+ */
+
+#include <linux/bitops.h>
+#include <linux/cpu.h>
+#include <linux/cpu_pm.h>
+#include <linux/cpuidle.h>
+#include <linux/cpufreq/qcom-msm8660.h>
+#include <linux/cpumask.h>
+#include <linux/firmware/qcom/qcom_scm.h>
+#include <linux/mfd/qcom_rpm.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/qcom-msm8660-saw.h>
+#include <linux/smp.h>
+#include <linux/suspend.h>
+
+#include <asm/cacheflush.h>
+#include <asm/proc-fns.h>
+#include <asm/suspend.h>
+
+#define MSM8660_NR_CPUS	2
+
+extern void msm8660_cpu_warm_boot(void);
+extern u32 msm8660_l2cr1_save[MSM8660_NR_CPUS];
+
+static struct cpuidle_driver msm8660_idle_drivers[MSM8660_NR_CPUS];
+
+u32 msm8660_avs_disable(void)
+{
+	u32 avsdscr;
+	u32 disable = 0;
+
+	/*
+	 * Sony/CAF saves the Scorpion AVS delay synthesizer setting and then
+	 * clears AVSCSR before any power-collapse sequence.
+	 */
+	asm volatile(
+		"mrc p15, 7, %0, c15, c0, 6\n\t"
+		"mcr p15, 7, %1, c15, c1, 7"
+		: "=&r" (avsdscr)
+		: "r" (disable)
+		: "memory");
+
+	return avsdscr;
+}
+
+void msm8660_avs_restore(u32 avsdscr)
+{
+	u32 readback;
+	u32 enable = 0x61;
+
+	/*
+	 * Match avs_reset_delays(): program AVSDSCR, force a readback, then
+	 * enable the CPU, voltage and L2 AVS modules through AVSCSR.
+	 */
+	asm volatile(
+		"mcr p15, 7, %1, c15, c0, 6\n\t"
+		"mrc p15, 7, %0, c15, c0, 6\n\t"
+		"mcr p15, 7, %2, c15, c1, 7"
+		: "=&r" (readback)
+		: "r" (avsdscr), "r" (enable)
+		: "memory");
+
+	(void)readback;
+}
+
+static void msm8660_save_l2cr1(unsigned int cpu)
+{
+	u32 value;
+
+	/* Scorpion-specific L2 cache control register 1. */
+	asm volatile("mrc p15, 3, %0, c15, c0, 3"
+		     : "=r" (value));
+
+	WRITE_ONCE(msm8660_l2cr1_save[cpu], value);
+
+	/*
+	 * Warm resume reads this with the MMU and caches off.  Push the
+	 * Scorpion-specific state through every cache level to main memory.
+	 */
+	sync_cache_w(&msm8660_l2cr1_save[cpu]);
+}
+
+/*
+ * cpu_suspend() has already saved the generic ARM context when this runs.
+ *
+ * The historical Scorpion collapse code flushed the complete cache
+ * hierarchy, disabled D/I cache in SCTLR and executed WFI.  If an
+ * interrupt was already pending, WFI returned instead of collapsing;
+ * in that case restore SCTLR and report an aborted collapse.
+ */
+static int msm8660_collapse_finisher(unsigned long unused)
+{
+	u32 sctlr;
+	u32 disabled;
+
+	(void)unused;
+
+	asm volatile("mrc p15, 0, %0, c1, c0, 0"
+		     : "=r" (sctlr));
+
+	disabled = sctlr & ~(BIT(2) | BIT(12));
+
+	/*
+	 * This also pushes msm8660_l2cr1_save[] to the memory visible to
+	 * the MMU-off warm-resume trampoline.
+	 */
+	flush_cache_all();
+
+	asm volatile(
+		"mcr p15, 0, %0, c1, c0, 0\n\t"
+		"dsb\n\t"
+		"wfi\n\t"
+		"mcr p15, 0, %1, c1, c0, 0\n\t"
+		"isb\n\t"
+		:
+		: "r" (disabled), "r" (sctlr)
+		: "memory");
+
+	/* WFI returned without the core actually collapsing. */
+	return -1;
+}
+
+static int msm8660_cpu_collapse(bool manage_avs,
+				enum msm8660_saw_collapse_mode mode,
+				bool *collapsed)
+{
+	unsigned int cpu = raw_smp_processor_id();
+	u32 avsdscr = 0;
+	int ret;
+	int restore_ret;
+
+	if (collapsed)
+		*collapsed = false;
+
+	if (cpu >= MSM8660_NR_CPUS)
+		return -EINVAL;
+
+	if (manage_avs)
+		avsdscr = msm8660_avs_disable();
+
+	ret = msm8660_saw_set_power_collapse(cpu, true, mode);
+	if (ret)
+		goto restore_avs;
+
+	/*
+	 * Sony saved L2CR1 as part of the architectural collapse context.
+	 * Generic ARMv7 cpu_suspend() saves everything else we need.
+	 */
+	msm8660_save_l2cr1(cpu);
+
+	ret = cpu_suspend(0, msm8660_collapse_finisher);
+	if (!ret && collapsed)
+		*collapsed = true;
+
+	/*
+	 * We arrive here both after a successful warm resume (ret == 0) and
+	 * after an aborted WFI. Never leave SAW armed for collapse.
+	 */
+	restore_ret = msm8660_saw_set_power_collapse(cpu, false, mode);
+	if (!ret && restore_ret)
+		ret = restore_ret;
+
+restore_avs:
+	if (manage_avs)
+		msm8660_avs_restore(avsdscr);
+	return ret;
+}
+
+static int msm8660_cpu_spc_common(bool manage_avs)
+{
+	return msm8660_cpu_collapse(manage_avs,
+				    MSM8660_SAW_COLLAPSE_STANDALONE, NULL);
+}
+
+static int msm8660_cpu_spc(void *unused)
+{
+	(void)unused;
+	return msm8660_cpu_spc_common(true);
+}
+
+static __cpuidle int msm8660_enter_idle(struct cpuidle_device *dev,
+				       struct cpuidle_driver *drv,
+				       int index)
+{
+	/* cpuidle core already brackets this callback with context tracking. */
+	return CPU_PM_CPU_IDLE_ENTER_PARAM_RCU(msm8660_cpu_spc, index, NULL);
+}
+
+static const struct cpuidle_driver msm8660_idle_template = {
+	.name = "msm8660-saw",
+	.owner = THIS_MODULE,
+	.states = {
+		{
+			.enter = msm8660_enter_idle,
+			.exit_latency = 1,
+			.target_residency = 1,
+			.name = "WFI",
+			.desc = "ARM WFI",
+		},
+		{
+			.enter = msm8660_enter_idle,
+			.exit_latency = 100,
+			.target_residency = 500,
+			.name = "SPC",
+			.desc = "standalone power collapse",
+		},
+	},
+	.state_count = 2,
+	.safe_state_index = 0,
+};
+
+static int msm8660_suspend_enter(suspend_state_t state)
+{
+	const struct qcom_rpm_msm8660_rpmrs_limits sleep_limits =
+		QCOM_RPM_MSM8660_RPMRS_CONSERVATIVE_LIMITS;
+	struct msm8660_pc_clock_state clock_state = { };
+	bool rpmrs_armed = false;
+	bool collapsed = false;
+	u32 avsdscr;
+	int ret;
+	int restore_ret;
+
+	if (state != PM_SUSPEND_MEM)
+		return -EINVAL;
+	if (raw_smp_processor_id() != 0 || num_online_cpus() != 1)
+		return -EBUSY;
+
+	/* Prepare the conservative Sony/Fuji sleep set before touching SAW. */
+	ret = qcom_rpm_msm8660_rpmrs_enter_sleep_noirq(0, &sleep_limits);
+	if (ret)
+		return ret;
+	rpmrs_armed = true;
+
+	/* Match Sony's AVS and CPU/L2 clock ordering for full collapse. */
+	avsdscr = msm8660_avs_disable();
+
+	ret = msm8660_cpufreq_power_collapse_enter(0, &clock_state);
+	if (ret)
+		goto restore_avs;
+
+	ret = cpu_pm_enter();
+	if (ret)
+		goto restore_clocks;
+
+	ret = msm8660_cpu_collapse(false, MSM8660_SAW_COLLAPSE_NOTIFY_RPM,
+				   &collapsed);
+	cpu_pm_exit();
+
+restore_clocks:
+	restore_ret = msm8660_cpufreq_power_collapse_exit(0, &clock_state);
+	if (!ret && restore_ret)
+		ret = restore_ret;
+
+restore_avs:
+	msm8660_avs_restore(avsdscr);
+	if (rpmrs_armed) {
+		restore_ret = qcom_rpm_msm8660_rpmrs_exit_sleep_noirq(collapsed);
+		if (!ret && restore_ret)
+			ret = restore_ret;
+	}
+
+	/* A pending wake IRQ may abort WFI before collapse; treat it as wake. */
+	return ret == -1 ? 0 : ret;
+}
+
+static const struct platform_suspend_ops msm8660_suspend_ops = {
+	.enter = msm8660_suspend_enter,
+	.valid = suspend_valid_only_mem,
+};
+
+static int msm8660_cpuidle_probe(struct platform_device *pdev)
+{
+	bool registered[MSM8660_NR_CPUS] = { };
+	int cpu;
+	int ret;
+	int i;
+
+	if (!qcom_scm_is_available())
+		return -EPROBE_DEFER;
+
+	/*
+	 * Do not partially register cpuidle while one of the two SAWs is still
+	 * probing.  Deferred probing will bring us back once both are ready.
+	 */
+	for_each_present_cpu(cpu) {
+		if (cpu >= MSM8660_NR_CPUS)
+			return dev_err_probe(&pdev->dev, -EINVAL,
+					     "unexpected CPU%u\n", cpu);
+
+		if (!msm8660_saw_cpu_ready(cpu))
+			return -EPROBE_DEFER;
+	}
+
+	/*
+	 * Sony's MSM8x60 boot mode is TrustZone-controlled.  Mainline's
+	 * legacy SCM implementation uses the same warm-boot flag encoding.
+	 */
+	ret = qcom_scm_set_warm_boot_addr(msm8660_cpu_warm_boot);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "failed to program warm boot address\n");
+
+	for_each_present_cpu(cpu) {
+		msm8660_idle_drivers[cpu] = msm8660_idle_template;
+		msm8660_idle_drivers[cpu].cpumask =
+			(struct cpumask *)cpumask_of(cpu);
+
+		ret = cpuidle_register(&msm8660_idle_drivers[cpu], NULL);
+		if (ret) {
+			dev_err(&pdev->dev,
+				"failed to register CPU%u cpuidle: %d\n",
+				cpu, ret);
+			goto unregister;
+		}
+
+		registered[cpu] = true;
+	}
+
+	suspend_set_ops(&msm8660_suspend_ops);
+
+	dev_info(&pdev->dev,
+		 "MSM8660 standalone power collapse and system suspend registered\n");
+
+	return 0;
+
+unregister:
+	for (i = 0; i < MSM8660_NR_CPUS; i++)
+		if (registered[i])
+			cpuidle_unregister(&msm8660_idle_drivers[i]);
+
+	return ret;
+}
+
+static struct platform_driver msm8660_cpuidle_driver = {
+	.probe = msm8660_cpuidle_probe,
+	.driver = {
+		.name = "qcom-msm8660-cpuidle",
+		.suppress_bind_attrs = true,
+	},
+};
+
+static int __init msm8660_cpuidle_init(void)
+{
+	struct platform_device *pdev;
+	int ret;
+
+	/* The voltage/SAW data in this driver is specifically Fuji/Hikari. */
+	if (!of_machine_is_compatible("sony,hikari"))
+		return 0;
+
+	ret = platform_driver_register(&msm8660_cpuidle_driver);
+	if (ret)
+		return ret;
+
+	pdev = platform_device_register_simple("qcom-msm8660-cpuidle",
+					       -1, NULL, 0);
+	if (IS_ERR(pdev)) {
+		ret = PTR_ERR(pdev);
+		platform_driver_unregister(&msm8660_cpuidle_driver);
+		return ret;
+	}
+
+	return 0;
+}
+device_initcall(msm8660_cpuidle_init);
+
+MODULE_DESCRIPTION("Sony-style MSM8660 Scorpion CPU idle and system suspend");
+MODULE_LICENSE("GPL");
