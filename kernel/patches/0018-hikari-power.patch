+int qcom_mpm_msm8660_enter_sleep(void)
+{
+	struct qcom_mpm_priv *priv = READ_ONCE(msm8660_mpm);
+	unsigned long flags;
+	int i;
+
+	if (!priv)
+		return -ENODEV;
+	if (WARN_ON_ONCE(!irqs_disabled()))
+		return -EINVAL;
+
+	raw_spin_lock_irqsave(&priv->lock, flags);
+	if (priv->armed) {
+		raw_spin_unlock_irqrestore(&priv->lock, flags);
+		return -EBUSY;
+	}
+	for (i = 0; i < MSM8660_MPM_BANKS; i++) {
+		u32 both = priv->wake_enable[i] & priv->dual_edge[i];
+		u32 polarity = qcom_mpm_read(priv, MPM_REG_POLARITY, i);
+
+		while (both) {
+			unsigned int bit = __ffs(both);
+			int level = msm8660_mpm_gpio_level(priv, i * 32 + bit);
+
+			if (level < 0) {
+				raw_spin_unlock_irqrestore(&priv->lock, flags);
+				return level;
+			}
+			if (level)
+				polarity &= ~BIT(bit);
+			else
+				polarity |= BIT(bit);
+			both &= ~BIT(bit);
+		}
+		qcom_mpm_write(priv, MPM_REG_POLARITY, i, polarity);
+	}
+	for (i = 0; i < MSM8660_MPM_BANKS; i++) {
+		priv->saved_enable[i] = qcom_mpm_read(priv, MPM_REG_ENABLE, i);
+		priv->wake_status[i] = 0;
+		qcom_mpm_write(priv, MPM_REG_ENABLE, i, priv->wake_enable[i]);
+		/* Replay the full Sony ENABLE -> DETECT -> POLARITY -> CLEAR set. */
+		qcom_mpm_write(priv, MPM_REG_RISING_EDGE, i,
+			       qcom_mpm_read(priv, MPM_REG_RISING_EDGE, i));
+		qcom_mpm_write(priv, MPM_REG_POLARITY, i,
+			       qcom_mpm_read(priv, MPM_REG_POLARITY, i));
+		qcom_mpm_write(priv, MPM_REG_STATUS, i, 0);
+	}
+	priv->armed = true;
+	msm8660_mpm_notify(priv);
+	raw_spin_unlock_irqrestore(&priv->lock, flags);
+	return 0;
+}
