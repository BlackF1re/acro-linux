+		if (!(cfg & BIT(g->intr_enable_bit)))
+			continue;
+		msm_writel_intr_cfg(cfg & ~BIT(g->intr_enable_bit), pctrl, g);
+		msm_readl_intr_cfg(pctrl, g);
+		masked++;
+	}
+	dev_info(pctrl->dev, "masked %u inherited APPS GPIO IRQs\n", masked);
