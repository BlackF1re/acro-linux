From d6ef3f7bd15c64065c71df568972d63e37041503 Mon Sep 17 00:00:00 2001
From: Hikari Patch Materializer <hikari-materializer@localhost>
Date: Sat, 5 Sep 2026 11:34:10 +0700
Subject: [PATCH] iommu/msm: enable clocks during hardware probe

---
 drivers/iommu/msm_iommu.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/drivers/iommu/msm_iommu.c b/drivers/iommu/msm_iommu.c
index 4ef1e8c82..100b3a15c 100644
--- a/drivers/iommu/msm_iommu.c
+++ b/drivers/iommu/msm_iommu.c
@@ -757,14 +757,27 @@ static int msm_iommu_probe(struct platform_device *pdev)
 	}
 	iommu->ncb = val;
 
+	/*
+	 * The reset and V2P presence test below access both the interface and
+	 * IOMMU core.  devm_clk_get_prepared() deliberately leaves those clocks
+	 * disabled; enable them just as the original MSM8x60 driver did.
+	 */
+	ret = __enable_clocks(iommu);
+	if (ret)
+		return dev_err_probe(iommu->dev, ret,
+				     "could not enable IOMMU clocks\n");
+
 	msm_iommu_reset(iommu->base, iommu->ncb);
 	SET_M(iommu->base, 0, 1);
 	SET_PAR(iommu->base, 0, 0);
 	SET_V2PCFG(iommu->base, 0, 1);
 	SET_V2PPR(iommu->base, 0, 0);
+	mb();
 	par = GET_PAR(iommu->base, 0);
 	SET_V2PCFG(iommu->base, 0, 0);
 	SET_M(iommu->base, 0, 0);
+	mb();
+	__disable_clocks(iommu);
 
 	if (!par) {
 		pr_err("Invalid PAR value detected\n");
-- 
