--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -775,6 +775,16 @@ config CHARGER_BQ2415X
 	  Say Y to enable support for the TI BQ2415x battery charger
 	  PMICs.
 
+config CHARGER_BQ24160
+	tristate "TI BQ24160 battery charger driver"
+	depends on I2C
+	select REGMAP_I2C
+	help
+	  Say Y to enable the TI BQ24160 USB/IN power-path charger.
+
+	  The driver supports conservative USB charging policy, the charger
+	  watchdog, status/fault reporting, and a power_supply interface.
+
 	  You'll need this driver to charge batteries on e.g. Nokia
 	  RX-51/N900.
 
