diff --git a/Documentation/devicetree/bindings/power/supply/ti,bq24160.yaml b/Documentation/devicetree/bindings/power/supply/ti,bq24160.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..301417e7b09da7a1283c8ef0f3cf997a50be2666
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/ti,bq24160.yaml
@@ -0,0 +1,78 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/ti,bq24160.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Texas Instruments BQ24160 USB/IN power-path battery charger
+
+maintainers:
+  - Hikari Linux Project <noreply@example.invalid>
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: ti,bq24160
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  fuel-gauge:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Reference to the fuel gauge used for safe temperature and voltage policy.
+
+  ti,usb-input-current-limit-microamp:
+    description: Conservative USB input limit for an otherwise unknown source.
+    enum: [100000, 150000, 500000, 800000, 900000, 1500000]
+
+  ti,constant-charge-current-max-microamp:
+    minimum: 550000
+    maximum: 2500000
+
+  ti,constant-charge-voltage-max-microvolt:
+    minimum: 3500000
+    maximum: 4440000
+    multipleOf: 20000
+
+  ti,charge-term-current-microamp:
+    minimum: 50000
+    maximum: 400000
+    multipleOf: 50000
+
+  wakeup-source: true
+
+required:
+  - compatible
+  - reg
+  - fuel-gauge
+  - ti,usb-input-current-limit-microamp
+  - ti,constant-charge-current-max-microamp
+  - ti,constant-charge-voltage-max-microvolt
+  - ti,charge-term-current-microamp
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+    i2c {
+      #address-cells = <1>;
+      #size-cells = <0>;
+
+      charger@6b {
+        compatible = "ti,bq24160";
+        reg = <0x6b>;
+        interrupts = <7 IRQ_TYPE_EDGE_BOTH>;
+        fuel-gauge = <&fuel_gauge>;
+        ti,usb-input-current-limit-microamp = <500000>;
+        ti,constant-charge-current-max-microamp = <1525000>;
+        ti,constant-charge-voltage-max-microvolt = <4200000>;
+        ti,charge-term-current-microamp = <50000>;
+      };
+    };
+...
diff --git a/arch/arm/boot/dts/qcom/qcom-msm8260-sony-hikari.dts b/arch/arm/boot/dts/qcom/qcom-msm8260-sony-hikari.dts
index d0f331e365126b968e34dc7b6c50d90c0553f039..b306d2bd03ae2ab69373f975cb9754d16bd8f564 100644
--- a/arch/arm/boot/dts/qcom/qcom-msm8260-sony-hikari.dts
+++ b/arch/arm/boot/dts/qcom/qcom-msm8260-sony-hikari.dts
@@ -33,6 +33,18 @@ ramoops@7ffe0000 {
 		};
 	};
 
+	/* Sony-programmed BQ27520 gauge data is read-only to this kernel. */
+	battery: battery {
+		compatible = "simple-battery";
+		device-chemistry = "lithium-ion";
+		charge-full-design-microamp-hours = <1900000>;
+		voltage-min-design-microvolt = <3000000>;
+		voltage-max-design-microvolt = <4200000>;
+		constant-charge-current-max-microamp = <1525000>;
+		constant-charge-voltage-max-microvolt = <4200000>;
+		charge-term-current-microamp = <50000>;
+	};
+
 	/*
 	 * The low bank starts at the historical MSM8x60 shared-memory physical
 	 * base.  CONFIG_ARCH_QCOM_RESERVE_SMEM then retains its first 2 MiB for
@@ -279,4 +291,26 @@ backlight@40 {
 		reg = <0x40>;
 		status = "okay";
 	};
+
+	/* Exact Fuji/Hikari GSBI8 addresses: BQ27520 = 0x55, BQ24160 = 0x6b. */
+	bq27520: fuel-gauge@55 {
+		compatible = "ti,bq27520";
+		reg = <0x55>;
+		monitored-battery = <&battery>;
+		status = "okay";
+	};
+
+	charger@6b {
+		compatible = "ti,bq24160";
+		reg = <0x6b>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <125 IRQ_TYPE_EDGE_BOTH>;
+		fuel-gauge = <&bq27520>;
+		ti,usb-input-current-limit-microamp = <500000>;
+		ti,constant-charge-current-max-microamp = <1525000>;
+		ti,constant-charge-voltage-max-microvolt = <4200000>;
+		ti,charge-term-current-microamp = <50000>;
+		wakeup-source;
+		status = "okay";
+	};
 };
diff --git a/drivers/power/supply/Kconfig b/drivers/power/supply/Kconfig
