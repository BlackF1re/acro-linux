+	{3,0xb9,0x01,0x00,0x75},{1,0xbb,0x00},{6,0xbe,0xff,0x0f,0x1a,0x18,0x02,0x40},
+	{5,0xc0,0x40,0x02,0x7f,0xc8,0x08},{15,0xc1,0x00,0xa8,0x00,0x00,0x00,0x00,0x00,0x9c,0x08,0x24,0x0b,0x00,0x00,0x00,0x00},
+	{5,0xc2,0x00,0x00,0x0b,0x00,0x00},{1,0xc3,0x04},{3,0xc4,0x4d,0x83,0x00},
+	{10,0xc6,0x13,0x00,0x08,0x71,0x00,0x00,0x00,0x00,0x00,0x00},{1,0xc7,0x22},{4,0xc8,0x07,0x00,0x07,0x00},
+	{13,0xc9,0x43,0x25,0x3b,0x39,0x31,0x23,0x27,0x2c,0x26,0x29,0x40,0x2d,0x74},
+	{13,0xca,0x7c,0x1a,0x24,0x26,0x2e,0x3c,0x38,0x33,0x39,0x36,0x1f,0x12,0x4b},
+	{13,0xcb,0x43,0x25,0x3b,0x39,0x31,0x23,0x27,0x2c,0x26,0x29,0x40,0x2d,0x74},
+	{13,0xcc,0x7c,0x1a,0x24,0x26,0x2e,0x3c,0x38,0x33,0x39,0x36,0x1f,0x12,0x4b},
+	{13,0xcd,0x43,0x25,0x3b,0x39,0x31,0x23,0x27,0x2c,0x26,0x29,0x40,0x2d,0x74},
+	{13,0xce,0x7c,0x1a,0x24,0x26,0x2e,0x3c,0x38,0x33,0x39,0x36,0x1f,0x12,0x4b},
+	{3,0xd0,0x69,0x65,0x01},{2,0xd1,0x77,0xd4},{1,0xd3,0x33},{2,0xd5,0x0c,0x0c},{6,0xd8,0x34,0x64,0x23,0x25,0x62,0x32},
+	{11,0xde,0x01,0x00,0x31,0x46,0x00,0x00,0x00,0x00,0x00,0x00,0x00},{1,0xe2,0x00},
+};
+static const u8 mdv22_post_sleep[][17] = {
+	{4,0xc8,0x4c,0x0c,0x0c,0x0c},{13,0xc9,0x00,0x40,0x00,0x16,0x32,0x2e,0x3a,0x43,0x3e,0x3c,0x45,0x79,0x3f},
+	{13,0xca,0x00,0x46,0x1a,0x23,0x21,0x1c,0x25,0x31,0x2d,0x49,0x5f,0x7f,0x3f},
+	{13,0xcb,0x00,0x4c,0x20,0x3a,0x42,0x40,0x47,0x4b,0x42,0x3e,0x46,0x7e,0x3f},
+	{13,0xcc,0x00,0x41,0x19,0x21,0x1d,0x14,0x18,0x1f,0x1d,0x25,0x3f,0x73,0x3f},
+	{13,0xcd,0x23,0x79,0x5a,0x5f,0x57,0x4c,0x51,0x51,0x45,0x3f,0x4b,0x7f,0x3f},
+	{13,0xce,0x00,0x40,0x14,0x20,0x1a,0x0e,0x0e,0x13,0x08,0x00,0x05,0x46,0x1c},
+	{11,0xde,0x10,0x7b,0x11,0x0a,0x00,0x00,0x00,0x00,0x00,0x00,0x00},
+};
+static int mdv22_send(struct mipi_dsi_device *dsi, const u8 t[][17], size_t n)
+{ size_t i; int ret; for (i=0;i<n;i++) { ret=mipi_dsi_generic_write(dsi, &t[i][1], t[i][0]+1); if (ret<0) return ret; } return 0; }
+static int mdv22_prepare(struct drm_panel *panel)
+{ struct mdv22 *m=to_mdv22(panel); int ret;
+	ret=regulator_bulk_enable(2,m->supplies); if(ret) return ret;
+	gpiod_set_value_cansleep(m->reset, 0);
+	msleep(10);
+	gpiod_set_value_cansleep(m->reset, 1);
+	msleep(10);
+	gpiod_set_value_cansleep(m->power, 1);
+	msleep(50);
+	ret=mdv22_send(m->dsi,mdv22_init,ARRAY_SIZE(mdv22_init)); if(ret) goto power_off;
+	ret=mipi_dsi_dcs_exit_sleep_mode(m->dsi); if(ret) goto power_off; msleep(100);
+	ret=mdv22_send(m->dsi,mdv22_post_sleep,ARRAY_SIZE(mdv22_post_sleep)); if(ret) goto power_off; msleep(20);
+	ret=mipi_dsi_dcs_set_display_on(m->dsi); if(ret) goto power_off;
+	return 0;
+power_off:
+	gpiod_set_value_cansleep(m->reset,0);
+	gpiod_set_value_cansleep(m->power,0);
+	regulator_bulk_disable(2,m->supplies);
+	return ret;
+}
+static int mdv22_unprepare(struct drm_panel *panel)
+{
+	struct mdv22 *m = to_mdv22(panel);
+
+	mipi_dsi_dcs_enter_sleep_mode(m->dsi);
+	msleep(80);
+	gpiod_set_value_cansleep(m->power, 0);
+	msleep(50);
+	gpiod_set_value_cansleep(m->reset, 0);
+	msleep(10);
+	regulator_bulk_disable(2, m->supplies);
+	return 0;
+}
+static int mdv22_enable(struct drm_panel *panel)
+{ return 0; }
+static int mdv22_disable(struct drm_panel *panel)
+{ return 0; }
+static const struct drm_display_mode mdv22_mode = { .clock=69673,.hdisplay=720,.hsync_start=848,.hsync_end=851,.htotal=896,.vdisplay=1280,.vsync_start=1289,.vsync_end=1293,.vtotal=1296,.width_mm=53,.height_mm=95,.type=DRM_MODE_TYPE_DRIVER|DRM_MODE_TYPE_PREFERRED };
+static int mdv22_modes(struct drm_panel *panel, struct drm_connector *c) { struct drm_display_mode *m=drm_mode_duplicate(c->dev,&mdv22_mode); if(!m)return -ENOMEM; drm_mode_set_name(m); drm_mode_probed_add(c,m); c->display_info.width_mm=53; c->display_info.height_mm=95; return 1; }
+static const struct drm_panel_funcs mdv22_funcs = { .prepare=mdv22_prepare,.enable=mdv22_enable,.disable=mdv22_disable,.unprepare=mdv22_unprepare,.get_modes=mdv22_modes };
+static int mdv22_probe(struct mipi_dsi_device *dsi)
+{
+	struct mdv22 *m;
+	int ret;
+
+	m = devm_drm_panel_alloc(&dsi->dev, struct mdv22, panel,
+				 &mdv22_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(m))
+		return PTR_ERR(m);
+
+	/* The MSM8x60 DSI host and PHY must be active before panel commands. */
+	m->panel.prepare_prev_first = true;
+
+	m->dsi = dsi;
+	m->supplies[0].supply = "vci";
+	m->supplies[1].supply = "vddio";
+	ret = devm_regulator_bulk_get(&dsi->dev, 2, m->supplies);
+	if (ret)
+		return ret;
+	m->power = devm_gpiod_get(&dsi->dev, "power", GPIOD_OUT_LOW);
+	if (IS_ERR(m->power))
+		return PTR_ERR(m->power);
+	m->reset = devm_gpiod_get(&dsi->dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(m->reset))
+		return PTR_ERR(m->reset);
+	ret = drm_panel_of_backlight(&m->panel);
+	if (ret)
+		return dev_err_probe(&dsi->dev, ret, "failed to get backlight\n");
+	ret = devm_drm_panel_add(&dsi->dev, &m->panel);
+	if (ret)
+		return ret;
+
+	mipi_dsi_set_drvdata(dsi, m);
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	/* Fuji MDV22 specifies non-burst synchronous-event, with HSA/HE pulses. */
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_HSE;
+	ret = mipi_dsi_attach(dsi);
+	if (ret)
+		return dev_err_probe(&dsi->dev, ret, "failed to attach DSI host\n");
+
+	return 0;
+}
+static void mdv22_remove(struct mipi_dsi_device *dsi)
+{
+	mipi_dsi_detach(dsi);
+}
+static const struct of_device_id mdv22_of[]={ { .compatible="sony,hikari-r63306-tmd-mdv22" },{} };MODULE_DEVICE_TABLE(of,mdv22_of);
+static struct mipi_dsi_driver mdv22_driver={.probe=mdv22_probe,.remove=mdv22_remove,.driver={.name="panel-renesas-r63306-tmd-mdv22",.of_match_table=mdv22_of}};module_mipi_dsi_driver(mdv22_driver);MODULE_LICENSE("GPL");
