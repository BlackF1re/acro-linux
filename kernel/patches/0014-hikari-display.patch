+struct mdv22 { struct drm_panel panel; struct mipi_dsi_device *dsi;
+	struct regulator_bulk_data supplies[2]; struct gpio_desc *power, *reset; };
+#define to_mdv22(p) container_of(p, struct mdv22, panel)
+
+/* Exact ID00/ID01 MDV22 sequence from Sony mipi_tmd_video_wxga_mdv22.c. */
+static const u8 mdv22_init[][17] = {
