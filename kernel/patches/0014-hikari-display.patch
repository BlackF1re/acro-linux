+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/sony,hikari-r63306-tmd-mdv22.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Renesas R63306 TMD MDV22 DSI panel used by Sony Hikari
+
+maintainers:
+  - Xperia acro S Linux Project <noreply@example.invalid>
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: sony,hikari-r63306-tmd-mdv22
+  reg:
+    maxItems: 1
+  vci-supply: true
+  vddio-supply: true
+  power-gpios:
+    maxItems: 1
+  reset-gpios:
+    maxItems: 1
+  port:
+    $ref: /schemas/graph.yaml#/properties/port
+
+required:
+  - compatible
+  - reg
+  - vci-supply
+  - vddio-supply
+  - power-gpios
+  - reset-gpios
+  - port
+
+unevaluatedProperties: false
