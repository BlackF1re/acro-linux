diff --git a/drivers/gpu/drm/msm/dsi/phy/dsi_phy_45nm.c b/drivers/gpu/drm/msm/dsi/phy/dsi_phy_45nm.c
new file mode 100644
index 0000000000000000000000000000000000000000..0f9e366a6903bdf55e8017217a1342dd70591eed
--- /dev/null
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy_45nm.c
@@ -0,0 +1,207 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MSM8x60 45nm DSI PHY
+ *
+ * The first implementation deliberately supports the one source-verified
+ * Sony Hikari MDV22 profile (four lanes, 418.037760 MHz).  Values are from
+ * the Fuji downstream msm_dss_io_8x60.c PHY database, not from later 28nm
+ * PHYs.  It is a bootstrap implementation, kept separate from newer PHYs
+ * so the hardware is not misidentified.
+ */
+#include <linux/clk-provider.h>
+#include <linux/delay.h>
+
+#include "dsi_phy.h"
+
+#define HIKARI_BITCLK	418037760UL
+#define HIKARI_LEGACY_BITCLK	418000000UL
+#define HIKARI_BYTECLK	(HIKARI_BITCLK / 8)
+/*
+ * The PHY's non-byte output feeds DSI_SRC, not the final pixel clock.
+ * Fuji's 418 MHz profile uses an 836 MHz VCO / 4 DSI divider, hence the
+ * 209.018880 MHz source from which MMCC derives the 69.672960 MHz pixel
+ * clock. DSI_PIXEL_PLL_CLK is the historical binding name for that output.
+ */
+#define HIKARI_DSI_SRC_CLK	(HIKARI_BITCLK / 2)
+#define HIKARI_PHY_RESOURCE_OFFSET	0xf0
+
+#define PHY_REG(_absolute_offset)	((_absolute_offset) - HIKARI_PHY_RESOURCE_OFFSET)
+
+static const u8 hikari_regulator[] = { 0x13, 0x01, 0x01, 0x00 };
+static const u8 hikari_timing[] = { 0x78, 0x1b, 0x11, 0x00, 0x3e, 0x43,
+	0x16, 0x1e, 0x1d, 0x03, 0x04 };
+static const u8 hikari_ctrl[] = { 0x7f, 0x00, 0x00, 0x89 };
+static const u8 hikari_strength[] = { 0xdd, 0x02, 0x86, 0x00 };
+static const u8 hikari_pll[] = { 0x40, 0x91, 0xb1, 0xd9, 0x00, 0x2f,
+	0x48, 0x63, 0x31, 0x0f, 0x03, 0x05, 0x14, 0x03, 0x00, 0x00,
+	0x54, 0x06, 0x10, 0x04, 0x00 };
+
+static void write_table(void __iomem *base, u32 offset, const u8 *table,
+			size_t count)
+{
+	while (count--) {
+		writel(*table++, base + offset);
+		offset += 4;
+	}
+}
+
+static bool hikari_rate_is_supported(unsigned long rate)
+{
+	/* The BSP table is for 418 MHz; CCF rounding yields 418.000 or 418.038. */
+	return rate >= HIKARI_LEGACY_BITCLK - 100000 &&
+		rate <= HIKARI_BITCLK + 100000;
+}
+
+static int dsi_45nm_pll_init(struct msm_dsi_phy *phy)
+{
+	struct device *dev = &phy->pdev->dev;
+	struct clk_hw *hw;
+
+	hw = devm_clk_hw_register_fixed_rate(dev, "dsi1pllbyte", NULL, 0,
+					    HIKARI_BYTECLK);
+	if (IS_ERR(hw))
+		return PTR_ERR(hw);
+	phy->provided_clocks->hws[DSI_BYTE_PLL_CLK] = hw;
+	hw = devm_clk_hw_register_fixed_rate(dev, "dsi1pll", NULL, 0,
+					    HIKARI_DSI_SRC_CLK);
+	if (IS_ERR(hw))
+		return PTR_ERR(hw);
+	phy->provided_clocks->hws[DSI_PIXEL_PLL_CLK] = hw;
+	return 0;
+}
+
+/*
+ * The raw MDV22 PHY table provides PLL defaults, then the Sony 8x60 BSP
+ * overrides these divider fields for the selected link rate. Keep that
+ * ordering: omitting these writes leaves the PLL off the Hikari profile.
+ */
+static void dsi_45nm_program_hikari_dividers(void __iomem *base)
+{
+	u32 val;
+
+	/* VCO 836 MHz, ref divider 27, bit divider 2, byte 16, DSI 4. */
+	writel(417 & 0xff, base + PHY_REG(0x204));
+	val = readl(base + PHY_REG(0x208));
+	val &= ~0x07;
+	val |= (417 >> 8) & 0x07;
+	writel(val, base + PHY_REG(0x208));
+	val = readl(base + PHY_REG(0x20c));
+	val &= ~0x3f;
+	val |= 26;
+	writel(val, base + PHY_REG(0x20c));
+	val = readl(base + PHY_REG(0x220));
+	val &= ~0x0f;
+	val |= 1;
+	writel(val, base + PHY_REG(0x220));
+	writel(15, base + PHY_REG(0x224));
+	writel(3, base + PHY_REG(0x228));
+}
+
+static int dsi_45nm_enable(struct msm_dsi_phy *phy,
+			   struct msm_dsi_phy_clk_request *clk_req)
+{
+	void __iomem *base = phy->base;
+	u32 val;
+	int i;
+
+	if (!hikari_rate_is_supported(clk_req->bitclk_rate))
+		return -EINVAL;
+
+	/* Exact MDV22 host clock-lane timing from Sony's Hikari panel data. */
+	phy->timing.shared_timings.clk_post = 0x04;
+	phy->timing.shared_timings.clk_pre = 0x1b;
+	phy->timing.shared_timings.clk_pre_inc_by_2 = false;
+	phy->timing.shared_timings.byte_intf_clk_div_2 = false;
+
+	/* Sony applies the analog pre-enable controls before PHY programming. */
+	writel(0x050, base + PHY_REG(0x214));
+	writel(0x00f, base + PHY_REG(0x258));
+	writel(0, base + PHY_REG(0x25c));
+
+	/* Same reset/calibration sequencing as the exact MSM8x60 BSP. */
+	writel(1, base + PHY_REG(0x128));
+	wmb();
+	usleep_range(1, 2);
+	writel(0, base + PHY_REG(0x128));
+	wmb();
+	usleep_range(1, 2);
+	write_table(base, PHY_REG(0x2cc), hikari_regulator, ARRAY_SIZE(hikari_regulator));
+	write_table(base, PHY_REG(0x260), hikari_timing, ARRAY_SIZE(hikari_timing));
+	write_table(base, PHY_REG(0x290), hikari_ctrl, ARRAY_SIZE(hikari_ctrl));
+	write_table(base, PHY_REG(0x2a0), hikari_strength, ARRAY_SIZE(hikari_strength));
+	writel(0x0000ff11, base + PHY_REG(0x0f4));
+	writel(1, base + PHY_REG(0x0f0));
+	/* The legacy BSP polls until calibration completes; bound it at 20 ms. */
+	for (i = 0; i < 2000; i++) {
+		val = readl(base + PHY_REG(0x0fc));
+		if (!(val & BIT(28)))
+			break;
+		udelay(10);
+	}
+	if (val & BIT(28))
+		return -ETIMEDOUT;
+	/* Legacy hardware requires PLL_CTRL_0 to be committed last. */
+	write_table(base, PHY_REG(0x204), &hikari_pll[1], ARRAY_SIZE(hikari_pll) - 1);
+	dsi_45nm_program_hikari_dividers(base);
+	/*
+	 * Sony enables the 45 nm PLL separately from programming its table.
+	 * Fixed-rate CCF providers describe the two outputs but cannot turn the
+	 * underlying hardware on, so commit PLL_CTRL_0 with ENABLE set only after
+	 * every other PHY/PLL register is configured.
+	 */
+	writel(hikari_pll[0] | BIT(0), base + PHY_REG(0x200));
+	wmb();
+	dev_info(&phy->pdev->dev,
+		 "Hikari 45nm DSI PHY enabled: bit %lu, byte %lu, source %lu Hz, PLL_CTRL_0 %#x\n",
+		 HIKARI_BITCLK, HIKARI_BYTECLK, HIKARI_DSI_SRC_CLK,
+		 readl(base + PHY_REG(0x200)));
+	return 0;
+}
+
+static void dsi_45nm_disable(struct msm_dsi_phy *phy)
+{
+	void __iomem *base = phy->base;
+
+	/* Match Sony's clock-disable path before powering down the PHY. */
+	writel(hikari_pll[0], base + PHY_REG(0x200));
+	writel(0x05f, base + PHY_REG(0x214));
+	writel(0x08f, base + PHY_REG(0x258));
+	writel(1, base + PHY_REG(0x25c));
+	writel(2, base + PHY_REG(0x2cc));
+	writel(0, base + PHY_REG(0x290));
+	writel(0x7f, base + PHY_REG(0x294));
+	writel(0, base + PHY_REG(0x118));
+	wmb();
+}
+
+static void dsi_45nm_quiesce_boot_state(struct msm_dsi_phy *phy)
+{
+	/*
+	 * Fuji's no-continuous-splash handoff clears PLL_CTRL_0 before the
+	 * DSI AHB branches are gated.  This is separate from the normal PHY
+	 * disable path because the DRM driver has not enabled the PHY yet.
+	 */
+	writel(0, phy->pll_base);
+	/* Flush the posted write while the DSI slave AHB clock is still on. */
+	readl(phy->pll_base);
+}
+
+static const struct regulator_bulk_data dsi_45nm_regulators[] = {
+	{ .supply = "vdda", .init_load_uA = 100000 }, /* PM8058 L0, 1.2 V */
+};
+
+const struct msm_dsi_phy_cfg dsi_phy_45nm_msm8x60_cfgs = {
+	.regulator_data = dsi_45nm_regulators,
+	.num_regulators = ARRAY_SIZE(dsi_45nm_regulators),
+	.ops = {
+		.enable = dsi_45nm_enable,
+		.disable = dsi_45nm_disable,
+		.quiesce_boot_state = dsi_45nm_quiesce_boot_state,
+		.pll_init = dsi_45nm_pll_init,
+	},
+	.min_pll_rate = HIKARI_BITCLK,
+	.max_pll_rate = HIKARI_BITCLK,
+	/* The 45nm register map is addressed from the DSI block base. */
+	.io_start = { 0x047000f0 },
+	.num_dsi_phy = 1,
+};
