@@ -0,0 +1,36 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/qcom,dsi-phy-45nm-msm8x60.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm MSM8x60 45nm DSI PHY
+
+maintainers:
+  - Xperia acro S Linux Project <noreply@example.invalid>
+
+properties:
+  compatible:
+    const: qcom,dsi-phy-45nm-msm8x60
+  reg:
+    minItems: 2
+    maxItems: 2
+  reg-names:
+    items:
+      - const: dsi_phy
+      - const: dsi_pll
+  vdda-supply: true
+  '#clock-cells':
+    const: 1
+  '#phy-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - vdda-supply
+  - '#clock-cells'
+  - '#phy-cells'
+
+additionalProperties: false
diff --git a/arch/arm/boot/dts/qcom/Makefile b/arch/arm/boot/dts/qcom/Makefile
index 026d5b682b2b3bf2722fd954acf625e2ddc1df36..74ef2b7bd8c6ffc6493b33a86ecd99ad956732e2 100644
--- a/arch/arm/boot/dts/qcom/Makefile
+++ b/arch/arm/boot/dts/qcom/Makefile
@@ -62,3 +62,4 @@ dtb-$(CONFIG_ARCH_QCOM) += \
 	qcom-sdx55-t55.dtb \
 	qcom-sdx55-telit-fn980-tlb.dtb \
