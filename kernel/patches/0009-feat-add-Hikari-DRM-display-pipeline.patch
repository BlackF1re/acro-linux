+static const u8 mdv22_post_sleep[][17] = {
+	{4,0xc8,0x4c,0x0c,0x0c,0x0c},{12,0xc9,0x00,0x40,0x00,0x16,0x32,0x2e,0x3a,0x43,0x3e,0x3c,0x45,0x79,0x3f},
+	{12,0xca,0x00,0x46,0x1a,0x23,0x21,0x1c,0x25,0x31,0x2d,0x49,0x5f,0x7f,0x3f},
