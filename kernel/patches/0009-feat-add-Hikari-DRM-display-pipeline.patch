+static int mdv22_send(struct mipi_dsi_device *dsi, const u8 t[][17], size_t n)
+{ size_t i; int ret; for (i=0;i<n;i++) { ret=mipi_dsi_generic_write(dsi, &t[i][1], t[i][0]+1); if (ret<0) return ret; } return 0; }
+static int mdv22_prepare(struct drm_panel *panel)
+{ struct mdv22 *m=to_mdv22(panel); int ret;
+	ret=regulator_bulk_enable(2,m->supplies); if(ret) return ret;
+	gpiod_set_value_cansleep(m->power,1); msleep(50); gpiod_set_value_cansleep(m->reset,0); msleep(10); gpiod_set_value_cansleep(m->reset,1); msleep(10);
