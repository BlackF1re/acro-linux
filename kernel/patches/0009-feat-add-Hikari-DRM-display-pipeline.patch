diff --git a/drivers/gpu/drm/msm/Kconfig b/drivers/gpu/drm/msm/Kconfig
index ed1c4775d1e928eef5eb0e403b30ba59d0b33226..a4932a7fe3777aaed0ffe76e74afdf60abf3559a 100644
--- a/drivers/gpu/drm/msm/Kconfig
+++ b/drivers/gpu/drm/msm/Kconfig
@@ -147,6 +147,13 @@ config DRM_MSM_DSI_28NM_PHY
 	help
 	  Choose this option if the 28nm DSI PHY is used on the platform.
 
+config DRM_MSM_DSI_45NM_PHY
+	bool "Enable MSM8x60 45nm DSI PHY driver in MSM DRM"
+	depends on DRM_MSM_DSI
+	help
+	  Support the MSM8x60-era 45nm DSI PHY.  The initial implementation
+	  contains the source-verified Sony Hikari MDV22 timing/PLL profile.
+
 config DRM_MSM_DSI_20NM_PHY
 	bool "Enable DSI 20nm PHY driver in MSM DRM"
 	depends on DRM_MSM_DSI
diff --git a/drivers/gpu/drm/msm/Makefile b/drivers/gpu/drm/msm/Makefile
index d0c3a4c6703be29fe3101fdfc4319310e4825f87..4a673668aceb55b0f190ee4b7e8ca49fd19dd570 100644
