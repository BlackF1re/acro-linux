+dtb-$(CONFIG_ARCH_QCOM) += qcom-msm8260-sony-hikari.dtb
diff --git a/arch/arm/boot/dts/qcom/qcom-msm8260-sony-hikari.dts b/arch/arm/boot/dts/qcom/qcom-msm8260-sony-hikari.dts
new file mode 100644
index 0000000000000000000000000000000000000000..5fc78c78fc78293cd3062e1565c1fddf5361da74
--- /dev/null
+++ b/arch/arm/boot/dts/qcom/qcom-msm8260-sony-hikari.dts
@@ -0,0 +1,281 @@
+// SPDX-License-Identifier: GPL-2.0
+/dts-v1/;
+
+#include <dt-bindings/soc/qcom,gsbi.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/reset/qcom,gcc-msm8660.h>
+#include <dt-bindings/clock/qcom,mmcc-msm8660.h>
+#include <dt-bindings/clock/qcom,dsi-phy-28nm.h>
+#include <dt-bindings/clock/qcom,rpmcc.h>
+#include <dt-bindings/interconnect/qcom,msm8660.h>
+#include "qcom-msm8660.dtsi"
+
+/ {
+	model = "Sony Xperia acro S (Hikari)";
+	compatible = "sony,hikari", "qcom,msm8660";
+
+	/*
+	 * The legacy Fuji/TWRP kernel and a physical TWRP /proc/iomem capture
+	 * both identify this as the 128 KiB persistent ram_console region.
+	 * Keep it mapped: ramoops writes the console itself.  Its zero ECC layout
+	 * is deliberately compatible with the legacy TWRP ram_console reader.
+	 */
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		ramoops@7ffe0000 {
+			compatible = "ramoops";
+			reg = <0x7ffe0000 0x00020000>;
+			console-size = <0x00020000>;
+			ecc-size = <0>;
+		};
+	};
+
+	/*
+	 * The low bank starts at the historical MSM8x60 shared-memory physical
+	 * base.  CONFIG_ARCH_QCOM_RESERVE_SMEM then retains its first 2 MiB for
+	 * SMEM, leaving 0x40200000 as the first normal Linux address.  The legacy
+	 * resource view starts at that latter address; see FIRST_BOOT_MEMORY.md.
+	 * This remains a deliberately minimal bring-up memory description, not a
+	 * claim that every byte of nominal RAM is currently understood.
+	 */
+};
+
+/* Override the placeholder System RAM node supplied by qcom-msm8660.dtsi. */
+&{/memory@0} {
+	reg = <0x40000000 0x02e00000>,
+	      <0x48000000 0x26600000>;
+};
+
+/*
+ * The legacy kernel directly observed a low-speed UART at 0x19c40000.  Keep
+ * this common-SoC GSBI disabled until a physical console route is known; its
+ * required mux property is nevertheless part of a schema-valid description.
+ */
+&gsbi12 {
+	qcom,mode = <GSBI_PROT_I2C_UART>;
+};
+
+/*
+ * HSUSB1 is the connector-facing ChipIdea controller.  The address and IRQ
+ * are shared MSM8x60 facts; `peripheral` and the two PHY rails come from the
+ * Fuji/Hikari downstream board code.  PMIC VBUS/ID callbacks were only used
+ * for legacy OTG role switching, so BOOT #5 deliberately supports device
+ * mode only and does not invent an extcon or host-role GPIO description.
+ */
+&{/} {
+	usb_hs1: usb@12500000 {
+		compatible = "qcom,ci-hdrc";
+		reg = <0x12500000 0x200>, <0x12500200 0x200>;
+		interrupts = <GIC_SPI 100 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&gcc USB_HS1_H_CLK>, <&gcc USB_HS1_XCVR_CLK>;
+		clock-names = "iface", "core";
+		assigned-clocks = <&gcc USB_HS1_XCVR_CLK>;
+		assigned-clock-rates = <60000000>;
+		resets = <&gcc USB_HS1_RESET>;
+		reset-names = "core";
+		phy_type = "ulpi";
+		dr_mode = "peripheral";
+		ahb-burst-config = <0>;
+		phys = <&usb_hs1_phy>;
+		phy-names = "usb-phy";
+		#reset-cells = <1>;
+		status = "okay";
+
+		ulpi {
+			usb_hs1_phy: phy {
+				compatible = "qcom,usb-hs-phy-msm8660",
+					     "qcom,usb-hs-phy";
+				clocks = <&sleep_clk>, <&cxo_board>;
+				clock-names = "sleep", "ref";
+				resets = <&usb_hs1 0>;
+				reset-names = "por";
+				v1p8-supply = <&pm8058_l7>;
+				v3p3-supply = <&pm8058_l6>;
+				#phy-cells = <0>;
+			};
+		};
+	};
+
+	/* MSM8x60 multimedia infrastructure; all clocks are fed by RPM. */
+	mmcc: clock-controller@4000000 {
+		compatible = "qcom,mmcc-msm8660";
+		reg = <0x04000000 0x1000>;
+		#clock-cells = <1>;
+		#reset-cells = <1>;
+		#power-domain-cells = <1>;
+		/* MSM8x60 GCC exposes PLL8 as the shared MMSS parent. */
+		clocks = <&pxo_board>, <&gcc PLL8_VOTE>, <&gcc PLL8_VOTE>,
+			 <&dsi_phy DSI_PIXEL_PLL_CLK>, <&dsi_phy DSI_BYTE_PLL_CLK>,
+			 <&dsi_phy DSI_PIXEL_PLL_CLK>, <&dsi_phy DSI_BYTE_PLL_CLK>;
+		clock-names = "pxo", "pll3", "pll8_vote", "dsi1pll", "dsi1pllbyte",
+			      "dsi2pll", "dsi2pllbyte";
+		status = "okay";
+	};
+
+	afab: interconnect@1000000 {
+		compatible = "qcom,msm8660-apps-fabric";
+		reg = <0x01000000 0x1000>;
+		#interconnect-cells = <1>;
+		clocks = <&rpmcc RPM_APPS_FABRIC_CLK>, <&rpmcc RPM_APPS_FABRIC_A_CLK>,
+			 <&rpmcc RPM_EBI1_CLK>, <&rpmcc RPM_EBI1_A_CLK>;
+		clock-names = "bus", "bus_a", "ebi1", "ebi1_a";
+		qcom,rpm = <&rpm>;
+		status = "okay";
+	};
+
+	sfab: interconnect@4000000 {
+		compatible = "qcom,msm8660-system-fabric";
+		reg = <0x04000000 0x1000>;
+		#interconnect-cells = <1>;
+		clocks = <&rpmcc RPM_SYS_FABRIC_CLK>, <&rpmcc RPM_SYS_FABRIC_A_CLK>;
+		clock-names = "bus", "bus_a";
+		qcom,rpm = <&rpm>;
+		status = "okay";
+	};
+
+	mmfab: interconnect@5700000 {
+		compatible = "qcom,msm8660-mmss-fabric";
+		reg = <0x05700000 0x1000>;
+		#interconnect-cells = <1>;
+		clocks = <&rpmcc RPM_MM_FABRIC_CLK>, <&rpmcc RPM_MM_FABRIC_A_CLK>,
+			 <&rpmcc RPM_SMI_CLK>, <&rpmcc RPM_SMI_A_CLK>;
+		clock-names = "bus", "bus_a", "smi", "smi_a";
+		qcom,rpm = <&rpm>;
+		status = "okay";
+	};
+
+	dfab: interconnect@6000000 {
+		compatible = "qcom,msm8660-daytona-fabric";
+		reg = <0x06000000 0x1000>;
+		#interconnect-cells = <1>;
+		clocks = <&rpmcc RPM_DAYTONA_FABRIC_CLK>, <&rpmcc RPM_DAYTONA_FABRIC_A_CLK>;
+		clock-names = "bus", "bus_a";
+		qcom,rpm = <&rpm>;
+		status = "okay";
+	};
+
+	mmss_sfpb: syscon@5700000 {
+		compatible = "qcom,msm8660-mmss-sfpb", "syscon";
+		reg = <0x05700000 0x1000>;
+	};
+
+	mdp: display-controller@5100000 {
+		compatible = "qcom,mdp4";
+		reg = <0x05100000 0x000f0000>;
+		interrupts = <GIC_SPI 75 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&mmcc MDP_CLK>, <&mmcc MDP_AHB_CLK>,
+			 <&mmcc MDP_AXI_CLK>, <&mmcc MDP_LUT_CLK>;
+		clock-names = "core", "iface", "bus", "lut";
+		power-domains = <&mmcc MDP_GDSC>;
+		interconnects = <&mmfab MMFAB_MAS_MDP_PORT0 &mmfab MMFAB_SLV_SMI>;
+		interconnect-names = "mdp-mem";
+		status = "okay";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			port@0 {
+				reg = <0>;
+				mdp_out: endpoint { remote-endpoint = <&dsi_in>; };
+			};
+		};
+	};
+
+	/* The MSM8x60 PHY and PLL share the DSI register aperture. */
+	dsi_phy: dsi-phy {
+		compatible = "qcom,dsi-phy-45nm-msm8x60";
+		reg = <0x04700000 0x400>, <0x04700000 0x400>;
+		reg-names = "dsi_phy", "dsi_pll";
+		vdda-supply = <&pm8058_l0>;
+		#clock-cells = <1>;
+		#phy-cells = <0>;
+		status = "okay";
+	};
+
+	dsi: dsi@4700000 {
+		compatible = "qcom,msm8660-dsi-ctrl";
+		reg = <0x04700000 0x200>;
+		interrupts = <GIC_SPI 82 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&mmcc DSI_M_AHB_CLK>, <&mmcc DSI_S_AHB_CLK>,
+			 <&mmcc AMP_AHB_CLK>, <&mmcc DSI_SRC>,
+			 <&mmcc DSI1_BYTE_CLK>, <&mmcc DSI_PIXEL_CLK>,
+			 <&mmcc DSI1_ESC_CLK>;
+		clock-names = "iface", "bus", "core_mmss", "src", "byte", "pixel", "core";
+		assigned-clocks = <&mmcc DSI_SRC>, <&mmcc DSI1_BYTE_CLK>,
+			 <&mmcc DSI_PIXEL_CLK>, <&mmcc DSI1_ESC_CLK>;
+		assigned-clock-parents = <&dsi_phy 0>, <&dsi_phy 0>, <&dsi_phy 1>, <&dsi_phy 1>;
+		phys = <&dsi_phy>;
+		phy-names = "dsi-phy";
+		qcom,mmss-sfpb = <&mmss_sfpb>;
+		vdda-supply = <&pm8058_l0>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		status = "okay";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			port@0 { reg = <0>; dsi_in: endpoint { remote-endpoint = <&mdp_out>; }; };
+			port@1 { reg = <1>; dsi_out: endpoint { remote-endpoint = <&panel_in>; }; };
+		};
+
+		panel@0 {
+			compatible = "renesas,r63306-tmd-mdv22";
+			reg = <0>;
+			vci-supply = <&pm8901_l2>;
+			vddio-supply = <&pm8901_lvs1>;
+			power-gpios = <&tlmm 18 GPIO_ACTIVE_HIGH>;
+			reset-gpios = <&tlmm 70 GPIO_ACTIVE_HIGH>;
+			ports { #address-cells = <1>; #size-cells = <0>; port { panel_in: endpoint { remote-endpoint = <&dsi_out>; }; }; };
+		};
+	};
+};
+
+/* Exact PHY rails and operating voltages from the Hikari downstream BSP. */
+&rpm {
+	regulators-0 {
+		compatible = "qcom,rpm-pm8901-regulators";
+		pm8901_l2: l2 { regulator-min-microvolt = <2850000>; regulator-max-microvolt = <2850000>; };
+		pm8901_lvs1: lvs1 { regulator-always-on; };
+	};
+	regulators-1 {
+		compatible = "qcom,rpm-pm8058-regulators";
+
+		pm8058_l6: l6 {
+			regulator-min-microvolt = <3050000>;
+			regulator-max-microvolt = <3050000>;
+			bias-pull-down;
+		};
+
+		pm8058_l7: l7 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			bias-pull-down;
+		};
+
+		pm8058_l0: l0 {
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1200000>;
+		};
+	};
+};
+
+&gsbi8 {
+	qcom,mode = <GSBI_PROT_I2C>;
+	status = "okay";
+};
+
+&gsbi8_i2c {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	backlight@40 {
+		compatible = "ams,as3676-backlight";
+		reg = <0x40>;
+		default-brightness = <32>;
+		status = "okay";
+	};
+};
