diff --git a/drivers/video/backlight/as3676-backlight.c b/drivers/video/backlight/as3676-backlight.c
new file mode 100644
index 0000000000000000000000000000000000000000..996eba5f85e13a38f803870f099a818ed67d6afa
--- /dev/null
+++ b/drivers/video/backlight/as3676-backlight.c
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * AS3676 LCD backlight support for Sony Fuji/Hikari.
+ *
+ * This intentionally implements only the proven LCD path: current sinks
+ * 01, 02 and 06.  The register assignments and sink selection come from
+ * Sony's Fuji board file and the vendor AS3676 driver; it does not expose
+ * the unrelated notification LEDs or ALS policy as a fake generic ABI.
+ */
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+
+#define AS3676_CONTROL		0x00
+#define AS3676_CURR12_CTRL	0x01
+#define AS3676_CURR_RGB_CTRL	0x02
+#define AS3676_CURR1		0x09
+#define AS3676_CURR2		0x0a
+#define AS3676_CURR6		0x2f
+
+struct as3676_backlight {
+	struct regmap *regmap;
+	struct backlight_device *bl;
+};
+
+static int as3676_backlight_update_status(struct backlight_device *bl)
+{
+	struct as3676_backlight *as = bl_get_data(bl);
+	u8 brightness = backlight_get_brightness(bl);
+	unsigned int mode = brightness ? 0x41 : 0x00; /* curr1, curr2, curr6 */
+	int ret;
+
+	ret = regmap_write(as->regmap, AS3676_CURR1, brightness);
+	if (ret)
+		return ret;
+	ret = regmap_write(as->regmap, AS3676_CURR2, brightness);
+	if (ret)
+		return ret;
+	ret = regmap_write(as->regmap, AS3676_CURR6, brightness);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(as->regmap, AS3676_CURR12_CTRL, 0x0f,
+				 brightness ? 0x05 : 0x00);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(as->regmap, AS3676_CURR_RGB_CTRL, 0xc0, mode);
+	if (ret)
+		return ret;
+
+	/* Direct-current sinks need the vendor driver's DCDC enable bit. */
+	ret = regmap_update_bits(as->regmap, AS3676_CONTROL, BIT(3),
+				 brightness ? BIT(3) : 0);
+	if (!ret && brightness)
+		usleep_range(12000, 20000);
+	return ret;
+}
+
+static const struct backlight_ops as3676_backlight_ops = {
+	.options = BL_CORE_SUSPENDRESUME,
+	.update_status = as3676_backlight_update_status,
+};
+
+static const struct regmap_config as3676_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = 0xbf,
+};
+
+static int as3676_backlight_probe(struct i2c_client *client)
+{
+	struct backlight_properties props = { .type = BACKLIGHT_RAW,
+		.max_brightness = 127, .brightness = 32 };
+	struct as3676_backlight *as;
+
+	as = devm_kzalloc(&client->dev, sizeof(*as), GFP_KERNEL);
+	if (!as)
+		return -ENOMEM;
+	as->regmap = devm_regmap_init_i2c(client, &as3676_regmap_config);
+	if (IS_ERR(as->regmap))
+		return PTR_ERR(as->regmap);
+	as->bl = devm_backlight_device_register(&client->dev, "as3676-backlight",
+					     &client->dev, as,
+					     &as3676_backlight_ops, &props);
+	if (IS_ERR(as->bl))
+		return PTR_ERR(as->bl);
+	return backlight_update_status(as->bl);
+}
+
+static const struct of_device_id as3676_backlight_of_match[] = {
+	{ .compatible = "ams,as3676-backlight" }, { }
+};
+MODULE_DEVICE_TABLE(of, as3676_backlight_of_match);
+
+static struct i2c_driver as3676_backlight_driver = {
+	.driver = { .name = "as3676-backlight", .of_match_table = as3676_backlight_of_match },
+	.probe = as3676_backlight_probe,
+};
+module_i2c_driver(as3676_backlight_driver);
+MODULE_DESCRIPTION("AS3676 Hikari LCD backlight");
+MODULE_LICENSE("GPL");
+#define AS3676_CONTROL		0x00
