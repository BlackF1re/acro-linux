From d74560dc33efe0a583b60af85c42439a4188832f Mon Sep 17 00:00:00 2001
From: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
Date: Mon, 5 Oct 2026 00:05:28 +0700
Subject: [PATCH] scm: consolidate final Hikari subsystem support

Repackage the prepared source without changing any byte of hardware
implementation. Includes final corrections and logging cleanup.

Prepared-source-tree: e3d73fd2f7bffefd6e42b0ec789d4e0af81fde45
Original-author: BlackF1re <plevickij57@gmail.com>
Original-series: research/patches/pre-subsystem-series-20261005
Signed-off-by: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
---
 drivers/firmware/qcom/qcom_scm.c | 84 +++++++++++++++++++++++---------
 1 file changed, 61 insertions(+), 23 deletions(-)

diff --git a/drivers/firmware/qcom/qcom_scm.c b/drivers/firmware/qcom/qcom_scm.c
index 3eaa4c9ccf3cc7db30257a41a4c2df027349ed52..46cef39b3ab6a9d6162f2913bbea965be3b4b6b4 100644
--- a/drivers/firmware/qcom/qcom_scm.c
+++ b/drivers/firmware/qcom/qcom_scm.c
@@ -1137,6 +1137,20 @@ int qcom_scm_io_readl(phys_addr_t addr, unsigned int *val)
 	struct qcom_scm_res res;
 	int ret;
 
+	/*
+	 * The original 32-bit Qualcomm atomic ABI used by MSM8x60 returns an
+	 * SCM_IO_READ value directly in r0.  Unlike SMCCC, r0 is not a status
+	 * with the payload in r1.  Sony's downstream scm-io.c consequently
+	 * treats scm_call_atomic1() itself as the read value.  Preserve the
+	 * generic SMCCC result handling, but decode the legacy ABI exactly;
+	 * otherwise MMCC regmap reads consume r1 (the context register) and
+	 * discard the real register value.
+	 */
+	if (__get_convention() == SMC_CONVENTION_LEGACY) {
+		ret = qcom_scm_call_atomic(__scm->dev, &desc, NULL);
+		*val = (u32)ret;
+		return 0;
+	}
 
 	ret = qcom_scm_call_atomic(__scm->dev, &desc, &res);
 	if (ret >= 0)
@@ -2793,6 +2807,7 @@ MODULE_PARM_DESC(minidump_dest, "Minidump SRAM destination: usb (default) or sto
 static int qcom_scm_probe(struct platform_device *pdev)
 {
 	struct qcom_tzmem_pool_config pool_config;
+	bool legacy_minimal;
 	struct qcom_scm *scm;
 	int irq, ret;
 	int i;
@@ -2803,6 +2818,10 @@ static int qcom_scm_probe(struct platform_device *pdev)
 
 	scm->dev = &pdev->dev;
 	platform_set_drvdata(pdev, scm);
+	legacy_minimal = of_device_is_compatible(pdev->dev.of_node,
+						 "qcom,scm-msm8660");
+	if (legacy_minimal)
+		dev_dbg(&pdev->dev, "MSM8x60 legacy SCM provider probe begin\n");
 	ret = qcom_scm_find_dload_address(&pdev->dev, &scm->dload_mode_addr);
 	if (ret < 0)
 		return dev_err_probe(&pdev->dev, ret,
@@ -2868,29 +2887,43 @@ static int qcom_scm_probe(struct platform_device *pdev)
 		goto err_rmem;
 	}
 
-	ret = qcom_scm_query_waitq_count(scm);
-	scm->wq_cnt = ret < 0 ? QCOM_SCM_DEFAULT_WAITQ_COUNT : ret;
-	scm->waitq_comps = devm_kcalloc(&pdev->dev, scm->wq_cnt, sizeof(*scm->waitq_comps),
-					GFP_KERNEL);
-	if (!scm->waitq_comps)
-		return -ENOMEM;
-
-	for (i = 0; i < scm->wq_cnt; i++)
-		init_completion(&scm->waitq_comps[i]);
-
-	irq = qcom_scm_get_waitq_irq(scm);
-	if (irq < 0)
-		irq = platform_get_irq_optional(pdev, 0);
-
-	if (irq < 0) {
-		if (irq != -ENXIO)
-			return irq;
-	} else {
-		ret = devm_request_threaded_irq(scm->dev, irq, NULL, qcom_scm_irq_handler,
-						IRQF_ONESHOT, "qcom-scm", scm);
-		if (ret < 0)
-			return dev_err_probe(scm->dev, ret,
-					     "Failed to request qcom-scm irq\n");
+	/*
+	 * Sony's MSM8x60 TrustZone implements the legacy SCM convention and the
+	 * atomic SCM_IO service used by the downstream secure MMSS accessor.  It
+	 * predates the sleeping-call waitqueue protocol, however.  Issuing the
+	 * modern WAITQ_GET_INFO command through scm_legacy_call() can leave the
+	 * caller polling a response which this firmware never completes.
+	 *
+	 * Do not probe optional modern SCM facilities on this compatible.  The
+	 * provider is published below so qcom_scm_io_readl()/writel() remain
+	 * available to the MSM8x60 MMCC driver.
+	 */
+	if (!legacy_minimal) {
+		ret = qcom_scm_query_waitq_count(scm);
+		scm->wq_cnt = ret < 0 ? QCOM_SCM_DEFAULT_WAITQ_COUNT : ret;
+		scm->waitq_comps = devm_kcalloc(&pdev->dev, scm->wq_cnt,
+						sizeof(*scm->waitq_comps), GFP_KERNEL);
+		if (!scm->waitq_comps)
+			return -ENOMEM;
+
+		for (i = 0; i < scm->wq_cnt; i++)
+			init_completion(&scm->waitq_comps[i]);
+
+		irq = qcom_scm_get_waitq_irq(scm);
+		if (irq < 0)
+			irq = platform_get_irq_optional(pdev, 0);
+
+		if (irq < 0) {
+			if (irq != -ENXIO)
+				return irq;
+		} else {
+			ret = devm_request_threaded_irq(scm->dev, irq, NULL,
+							qcom_scm_irq_handler,
+							IRQF_ONESHOT, "qcom-scm", scm);
+			if (ret < 0)
+				return dev_err_probe(scm->dev, ret,
+						     "Failed to request qcom-scm irq\n");
+		}
 	}
 
 	/*
@@ -2903,6 +2936,11 @@ static int qcom_scm_probe(struct platform_device *pdev)
 	smp_store_release(&__scm, scm);
 
 	__get_convention();
+	if (legacy_minimal) {
+		dev_info(&pdev->dev,
+			 "MSM8x60 legacy SCM provider ready for atomic SCM_IO\n");
+		return 0;
+	}
 
 	if (qcom_scm_is_pas_available()) {
 		qcom_pas_ops_scm.dev = scm->dev;
-- 
