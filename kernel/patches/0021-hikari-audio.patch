+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/remoteproc/qcom,msm8660-q6v3.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm MSM8660 QDSP6v3 audio processor
+
+maintainers:
+  - BlackF1re <55582873+BlackF1re@users.noreply.github.com>
+
+properties:
+  compatible:
+    const: qcom,msm8660-q6v3
+  reg:
+    items:
+      - description: Q6 boot vector and strap registers
+      - description: LCC Q6 function register
+      - description: Q6 tightly coupled memory
+  reg-names:
+    items:
+      - const: q6
+      - const: lcc
+      - const: tcm
+  clocks:
+    maxItems: 1
+  clock-names:
+    const: pll4
+  memory-region:
+    maxItems: 1
+    description: Reserved fixed-address Q6 DDR firmware region
+  smd-edge:
+    $ref: /schemas/remoteproc/qcom,smd-edge.yaml#
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+  - clock-names
+  - memory-region
+
+additionalProperties: false
