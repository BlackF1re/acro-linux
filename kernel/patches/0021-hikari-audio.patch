diff --git a/drivers/remoteproc/qcom_q6v3.c b/drivers/remoteproc/qcom_q6v3.c
new file mode 100644
index 0000000000000000000000000000000000000000..6d0e03b657e7db0207a347f933406516cfa9e07c
--- /dev/null
+++ b/drivers/remoteproc/qcom_q6v3.c
@@ -0,0 +1,338 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* MSM8660 QDSP6v3. Reset ordering from Sony 6.2.B.1.96 pil-q6v3.c.
+ * Copyright (c) 2010-2012, Code Aurora Forum. All rights reserved.
+ */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/elf.h>
+#include <linux/firmware.h>
+#include <linux/firmware/qcom/qcom_scm.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/platform_device.h>
+#include <linux/remoteproc.h>
+#include <linux/soc/qcom/mdt_loader.h>
+#include "qcom_common.h"
+
+#define Q6_FUNC 0x0
+#define STOP_CORE BIT(26)
+#define CLAMP_IO BIT(25)
+#define SS_ARES BIT(23)
+#define ISDB_ARES BIT(22)
+#define ETM_ARES BIT(21)
+#define CORE_ARES BIT(10)
+#define L1_MEM BIT(9)
+#define TCM_CORE BIT(8)
+#define TCM_PERIPH BIT(7)
+#define GFM4_CLK BIT(2)
+#define Q6_RESETS (SS_ARES | ISDB_ARES | ETM_ARES | CORE_ARES)
+#define Q6_MEM (L1_MEM | TCM_CORE | TCM_PERIPH)
+#define Q6_PAS_ID 1
+
+struct q6v3 {
+	struct device *dev;
+	struct clk *pll;
+	void __iomem *q6;
+	void __iomem *lcc;
+	void __iomem *tcm;
+	void __iomem *mem;
+	phys_addr_t tcm_phys;
+	size_t tcm_size;
+	phys_addr_t mem_phys;
+	size_t mem_size;
+	bool secure;
+	bool powered;
+	bool running;
+	struct qcom_scm_pas_context *pas;
+	struct qcom_rproc_subdev smd;
+};
+
+static void q6v3_hold(struct q6v3 *q)
+{
+	u32 val = readl(q->lcc + Q6_FUNC);
+
+	val |= Q6_RESETS | STOP_CORE;
+	val &= ~GFM4_CLK;
+	writel(val, q->lcc + Q6_FUNC);
+	usleep_range(20, 30);
+	val |= GFM4_CLK | Q6_MEM;
+	writel(val, q->lcc + Q6_FUNC);
+	val &= ~(CLAMP_IO | Q6_RESETS);
+	writel(val, q->lcc + Q6_FUNC);
+	/* Core remains stopped while firmware is copied into DDR/TCM. */
+	mb();
+}
+
+static int q6v3_off(struct q6v3 *q)
+{
+	u32 val;
+	int ret;
+
+	if (!q->powered)
+		return 0;
+	if (q->secure) {
+		if (q->running) {
+			ret = qcom_scm_pas_shutdown(Q6_PAS_ID);
+			if (ret)
+				return ret;
+		}
+		qcom_scm_pas_metadata_release(q->pas);
+	} else {
+		val = readl(q->lcc + Q6_FUNC);
+		val |= Q6_RESETS | STOP_CORE;
+		val &= ~GFM4_CLK;
+		writel(val, q->lcc + Q6_FUNC);
+		usleep_range(20, 30);
+		val &= ~Q6_MEM;
+		val |= CLAMP_IO;
+		writel(val, q->lcc + Q6_FUNC);
+	}
+	clk_disable_unprepare(q->pll);
+	q->powered = false;
+	q->running = false;
+	return 0;
+}
+
+static void *q6v3_da_to_va(struct rproc *rproc, u64 da, size_t len,
+			 bool *is_iomem)
+{
+	struct q6v3 *q = rproc->priv;
+
+	if (is_iomem)
+		*is_iomem = true;
+	if (da >= q->mem_phys && da - q->mem_phys <= q->mem_size &&
+	    len <= q->mem_size - (da - q->mem_phys))
+		return (void __force *)(q->mem + da - q->mem_phys);
+	if (da >= q->tcm_phys && da - q->tcm_phys <= q->tcm_size &&
+	    len <= q->tcm_size - (da - q->tcm_phys))
+		return (void __force *)(q->tcm + da - q->tcm_phys);
+	return NULL;
+}
+
+static bool q6v3_segment(const struct elf32_phdr *p)
+{
+	return p->p_type == PT_LOAD && p->p_memsz &&
+	       (p->p_flags & QCOM_MDT_TYPE_MASK) != QCOM_MDT_TYPE_HASH;
+}
+
+static int q6v3_load(struct rproc *rproc, const struct firmware *fw)
+{
+	struct q6v3 *q = rproc->priv;
+	const struct elf32_hdr *eh = (const void *)fw->data;
+	const struct elf32_phdr *ph;
+	const struct firmware *segment;
+	void *metadata;
+	void __iomem *dst;
+	size_t metadata_size;
+	char *name;
+	int i, ret;
+
+	if (fw->size < sizeof(*eh) || memcmp(eh->e_ident, ELFMAG, SELFMAG) ||
+	    eh->e_ident[EI_CLASS] != ELFCLASS32 ||
+	    eh->e_ident[EI_DATA] != ELFDATA2LSB || eh->e_machine != EM_HEXAGON ||
+	    eh->e_phentsize != sizeof(*ph) || eh->e_phoff > fw->size ||
+	    eh->e_phnum > (fw->size - eh->e_phoff) / sizeof(*ph))
+		return -EINVAL;
+	ph = (const void *)(fw->data + eh->e_phoff);
+	if ((eh->e_entry & 0xfff) ||
+	    !q6v3_da_to_va(rproc, eh->e_entry, 1, NULL))
+		return -EINVAL;
+	/* Check every destination before enabling clocks or touching hardware. */
+	for (i = 0; i < eh->e_phnum; i++) {
+		if (!q6v3_segment(&ph[i]))
+			continue;
+		if (ph[i].p_filesz > ph[i].p_memsz ||
+		    (ph[i].p_flags & QCOM_MDT_RELOCATABLE) ||
+		    !q6v3_da_to_va(rproc, ph[i].p_paddr, ph[i].p_memsz, NULL))
+			return -EINVAL;
+	}
+	name = kstrdup(rproc->firmware, GFP_KERNEL);
+	if (!name)
+		return -ENOMEM;
+	if (strlen(name) < 4 || strcmp(name + strlen(name) - 4, ".mdt")) {
+		ret = -EINVAL;
+		goto free_name;
+	}
+	ret = clk_prepare_enable(q->pll);
+	if (ret)
+		goto free_name;
+	q->powered = true;
+	if (q->secure) {
+		metadata = qcom_mdt_read_metadata(fw, &metadata_size,
+						rproc->firmware, q->dev);
+		if (IS_ERR(metadata)) {
+			ret = PTR_ERR(metadata);
+			goto power_off;
+		}
+		ret = qcom_scm_pas_init_image(Q6_PAS_ID, metadata,
+					      metadata_size, q->pas);
+		kfree(metadata);
+		if (ret)
+			goto power_off;
+	} else {
+		q6v3_hold(q);
+	}
+	for (i = 0; i < eh->e_phnum; i++) {
+		if (!q6v3_segment(&ph[i]))
+			continue;
+		dst = (void __force *)q6v3_da_to_va(rproc, ph[i].p_paddr,
+						ph[i].p_memsz, NULL);
+		if (ph[i].p_filesz) {
+			if (i > 99) {
+				ret = -EINVAL;
+				goto power_off;
+			}
+			snprintf(name + strlen(rproc->firmware) - 3, 4, "b%02d", i);
+			ret = request_firmware(&segment, name, q->dev);
+			if (ret)
+				goto power_off;
+			if (segment->size != ph[i].p_filesz) {
+				release_firmware(segment);
+				ret = -EINVAL;
+				goto power_off;
+			}
+			memcpy_toio(dst, segment->data, segment->size);
+			release_firmware(segment);
+		}
+		memset_io(dst + ph[i].p_filesz, 0,
+			  ph[i].p_memsz - ph[i].p_filesz);
+	}
+	/* Make all firmware writes visible before releasing the core. */
+	wmb();
+	rproc->bootaddr = eh->e_entry;
+	kfree(name);
+	return 0;
+power_off:
+	q6v3_off(q);
+free_name:
+	kfree(name);
+	return ret;
+}
+
+static int q6v3_start(struct rproc *rproc)
+{
+	struct q6v3 *q = rproc->priv;
+	u32 val;
+	int ret;
+
+	if (q->secure) {
+		ret = qcom_scm_pas_auth_and_reset(Q6_PAS_ID);
+		if (ret)
+			q6v3_off(q);
+		else
+			q->running = true;
+		return ret;
+	}
+	writel((rproc->bootaddr >> 12) & 0xfffff, q->q6);
+	writel((0x28c << 15) | 0x28b, q->q6 + 0x1c);
+	writel((0x290 << 12) | 0x280, q->q6 + 0x20);
+	/* Commit the boot vector and straps before starting instruction fetch. */
+	mb();
+	val = readl(q->lcc + Q6_FUNC);
+	writel(val & ~STOP_CORE, q->lcc + Q6_FUNC);
+	q->running = true;
+	return 0;
+}
+
+static int q6v3_stop(struct rproc *rproc)
+{
+	return q6v3_off(rproc->priv);
+}
+
+static const struct rproc_ops q6v3_ops = {
+	.start = q6v3_start,
+	.stop = q6v3_stop,
+	.load = q6v3_load,
+	.da_to_va = q6v3_da_to_va,
+};
+
+static int q6v3_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *node;
+	struct reserved_mem *mem;
+	struct resource *res;
+	struct rproc *rproc;
+	struct q6v3 *q;
+	int ret;
+
+	if (!qcom_scm_is_available())
+		return -EPROBE_DEFER;
+	rproc = devm_rproc_alloc(dev, "msm8660-q6", &q6v3_ops,
+			       "q6.mdt", sizeof(*q));
+	if (!rproc)
+		return -ENOMEM;
+	q = rproc->priv;
+	q->dev = dev;
+	q->q6 = devm_platform_ioremap_resource_byname(pdev, "q6");
+	if (IS_ERR(q->q6))
+		return PTR_ERR(q->q6);
+	q->lcc = devm_platform_ioremap_resource_byname(pdev, "lcc");
+	if (IS_ERR(q->lcc))
+		return PTR_ERR(q->lcc);
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "tcm");
+	if (!res)
+		return -EINVAL;
+	q->tcm_phys = res->start;
+	q->tcm_size = resource_size(res);
+	q->tcm = devm_ioremap_resource(dev, res);
+	if (IS_ERR(q->tcm))
+		return PTR_ERR(q->tcm);
+	node = of_parse_phandle(dev->of_node, "memory-region", 0);
+	if (!node)
+		return -EINVAL;
+	mem = of_reserved_mem_lookup(node);
+	of_node_put(node);
+	if (!mem)
+		return -EINVAL;
+	q->mem_phys = mem->base;
+	q->mem_size = mem->size;
+	q->mem = devm_ioremap_wc(dev, mem->base, mem->size);
+	if (!q->mem)
+		return -ENOMEM;
+	q->pll = devm_clk_get(dev, "pll4");
+	if (IS_ERR(q->pll))
+		return dev_err_probe(dev, PTR_ERR(q->pll), "PLL4 unavailable\n");
+	q->secure = qcom_scm_pas_supported(Q6_PAS_ID);
+	if (q->secure) {
+		q->pas = devm_qcom_scm_pas_context_alloc(dev, Q6_PAS_ID,
+						       mem->base, mem->size);
+		if (IS_ERR(q->pas))
+			return PTR_ERR(q->pas);
+	}
+	/* Explicit sysfs start during bring-up; do not boot untested DSP on probe. */
+	rproc->auto_boot = false;
+	platform_set_drvdata(pdev, rproc);
+	qcom_add_smd_subdev(rproc, &q->smd);
+	ret = rproc_add(rproc);
+	if (ret)
+		qcom_remove_smd_subdev(rproc, &q->smd);
+	return ret;
+}
+
+static void q6v3_remove(struct platform_device *pdev)
+{
+	struct rproc *rproc = platform_get_drvdata(pdev);
+	struct q6v3 *q = rproc->priv;
+
+	rproc_del(rproc);
+	qcom_remove_smd_subdev(rproc, &q->smd);
+}
+
+static const struct of_device_id q6v3_match[] = {
+	{ .compatible = "qcom,msm8660-q6v3" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, q6v3_match);
+static struct platform_driver q6v3_driver = {
+	.probe = q6v3_probe,
+	.remove = q6v3_remove,
+	.driver = {
+		.name = "qcom-q6v3",
+		.of_match_table = q6v3_match,
+	},
+};
+module_platform_driver(q6v3_driver);
+MODULE_DESCRIPTION("Qualcomm MSM8660 QDSP6v3 remote processor");
+MODULE_LICENSE("GPL");
