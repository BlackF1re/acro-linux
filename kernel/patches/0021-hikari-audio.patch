+++ b/arch/arm/boot/dts/qcom/qcom-msm8260-sony-hikari.dts
@@ -2,6 +2,7 @@
 /dts-v1/;
 
 #include <dt-bindings/soc/qcom,gsbi.h>
+#include <dt-bindings/soc/qcom,apr.h>
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/reset/qcom,gcc-msm8660.h>
 #include <dt-bindings/clock/qcom,mmcc-msm8660.h>
@@ -41,6 +42,12 @@ reserved-memory {
 		#size-cells = <1>;
 		ranges;
 
+
+		q6_region: adsp@46700000 {
+			reg = <0x46700000 0x01800000>;
+			no-map;
+		};
+
 		smem_region: smem@40000000 {
 			reg = <0x40000000 0x00200000>;
 			no-map;
@@ -427,6 +434,14 @@ pm8058_s3: s3 {
 			bias-pull-down;
 		};
 
+		/* Sony Hikari Timpani analog codec rail. */
+		pm8058_s4: s4 {
+			regulator-min-microvolt = <2200000>;
+			regulator-max-microvolt = <2200000>;
+			qcom,switch-mode-frequency = <1600000>;
+			bias-pull-down;
+		};
+
 		pm8058_l6: l6 {
 			regulator-min-microvolt = <3050000>;
 			regulator-max-microvolt = <3050000>;
@@ -510,6 +525,37 @@ usb_otg_guard: usb-otg-guard {
 	};
 };
 
+/* Sony Hikari routes its Timpani audio companion through GSBI7 QUP/I2C. */
+&tlmm {
+	gsbi7_i2c_default: gsbi7-i2c-default-state {
+		pins = "gpio59", "gpio60";
+		function = "gsbi7";
+		drive-strength = <12>;
+		bias-disable;
+	};
+};
+
+&gsbi7 {
+	qcom,mode = <GSBI_PROT_I2C>;
+	status = "okay";
+};
+
+&gsbi7_i2c {
+	clock-frequency = <100000>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&gsbi7_i2c_default>;
+	status = "okay";
+
+	timpani: audio-codec@d {
+		compatible = "qcom,timpani";
+		reg = <0x0d>;
+		vdd-supply = <&pm8058_l0>;
+		vddio-supply = <&pm8058_s3>;
+		va-supply = <&pm8058_s4>;
+		reset-gpios = <&pm8058_gpio 20 GPIO_ACTIVE_LOW>;
+	};
+};
+
 #include "qcom-msm8260-sony-hikari-hardware.dtsi"
 
 #include "qcom-msm8260-sony-hikari-wireless.dtsi"
@@ -580,3 +626,36 @@ &tlmm {
 &gcc {
 	clocks = <&rpmcc RPM_PXO_A_CLK>, <&cxo_board>;
 };
+
+/* QDSP6v3 fixed DDR/TCM layout and SMD routing from Sony's MSM8x60 BSP. */
+&soc {
+	adsp: remoteproc@28800000 {
+		compatible = "qcom,msm8660-q6v3";
+		reg = <0x28800000 0x100>, <0x2800001c 0x4>,
+		      <0x28400000 0x20000>;
+		reg-names = "q6", "lcc", "tcm";
+		clocks = <&rpmcc RPM_PLL4_CLK>;
+		clock-names = "pll4";
+		memory-region = <&q6_region>;
+
+		smd-edge {
+			interrupts = <GIC_SPI 90 IRQ_TYPE_EDGE_RISING>;
+			qcom,smd-edge = <1>;
+			qcom,ipc = <&l2cc 0x8 15>;
+
+			apr {
+				compatible = "qcom,apr";
+				qcom,smd-channels = "apr_audio_svc";
+				qcom,domain = <APR_DOMAIN_ADSP>;
+				qcom,legacy-no-pdr;
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				service@3 {
+					compatible = "qcom,msm8660-q6core";
+					reg = <APR_SVC_ADSP_CORE>;
+				};
+			};
+		};
+	};
+};
