diff --git a/sound/soc/codecs/timpani.c b/sound/soc/codecs/timpani.c
new file mode 100644
index 0000000000000000000000000000000000000000..a1d93c06e2d590a6bee5558d1d88259f3a02fb21
--- /dev/null
+++ b/sound/soc/codecs/timpani.c
@@ -0,0 +1,174 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Qualcomm Timpani control interface, as wired on Sony Fuji/Hikari. */
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <sound/soc.h>
+
+struct timpani {
+	struct regmap *core;
+	struct regmap *codec;
+	struct gpio_desc *reset;
+	struct regulator_bulk_data supplies[2];
+};
+
+static int timpani_power_on(struct device *dev)
+{
+	struct timpani *t = dev_get_drvdata(dev);
+	unsigned int version;
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(t->supplies), t->supplies);
+	if (ret)
+		return ret;
+	/* Sony: release reset, assert for 1 ms, then release again. */
+	gpiod_set_value_cansleep(t->reset, 0);
+	usleep_range(1000, 1500);
+	gpiod_set_value_cansleep(t->reset, 1);
+	usleep_range(1000, 1500);
+	gpiod_set_value_cansleep(t->reset, 0);
+	usleep_range(1000, 1500);
+	ret = regmap_read(t->core, 0x11, &version);
+	if (ret)
+		goto disable;
+	if (!(version & BIT(5))) {
+		ret = -ENODEV;
+		goto disable;
+	}
+	ret = regmap_write(t->core, 0x00, 0x10);
+	if (ret)
+		goto disable;
+	regcache_cache_only(t->codec, false);
+	ret = regcache_sync(t->codec);
+	if (!ret)
+		return 0;
+	regcache_cache_only(t->codec, true);
+disable:
+	gpiod_set_value_cansleep(t->reset, 1);
+	regulator_bulk_disable(ARRAY_SIZE(t->supplies), t->supplies);
+	return ret;
+}
+
+static int timpani_power_off(struct device *dev)
+{
+	struct timpani *t = dev_get_drvdata(dev);
+
+	regcache_cache_only(t->codec, true);
+	regcache_mark_dirty(t->codec);
+	gpiod_set_value_cansleep(t->reset, 1);
+	return regulator_bulk_disable(ARRAY_SIZE(t->supplies), t->supplies);
+}
+
+static void timpani_pm_disable(void *data)
+{
+	struct device *dev = data;
+
+	pm_runtime_disable(dev);
+	if (!pm_runtime_status_suspended(dev))
+		timpani_power_off(dev);
+}
+
+static const struct regmap_config timpani_core_regmap = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = 0xff,
+};
+
+static const struct regmap_config timpani_codec_regmap = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = 0xff,
+	.cache_type = REGCACHE_MAPLE,
+};
+
+static int timpani_component_probe(struct snd_soc_component *component)
+{
+	struct timpani *t = dev_get_drvdata(component->dev);
+
+	snd_soc_component_init_regmap(component, t->codec);
+	return 0;
+}
+
+/* Routes/DAIs are added once the Q6v3 AFE backend is available. */
+static const struct snd_soc_component_driver timpani_component = {
+	.name = "timpani",
+	.probe = timpani_component_probe,
+};
+
+static int timpani_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct i2c_client *codec;
+	struct timpani *t;
+	int ret;
+
+	t = devm_kzalloc(dev, sizeof(*t), GFP_KERNEL);
+	if (!t)
+		return -ENOMEM;
+	i2c_set_clientdata(client, t);
+	t->supplies[0].supply = "vdd";
+	t->supplies[1].supply = "vddio";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(t->supplies), t->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "core supplies unavailable\n");
+	ret = regulator_set_load(t->supplies[0].consumer, 5000);
+	if (ret)
+		return ret;
+	t->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(t->reset))
+		return dev_err_probe(dev, PTR_ERR(t->reset), "reset unavailable\n");
+	t->core = devm_regmap_init_i2c(client, &timpani_core_regmap);
+	if (IS_ERR(t->core))
+		return PTR_ERR(t->core);
+	/* The Sony MFD uses 0x0d for control and 0x77 for codec registers. */
+	codec = devm_i2c_new_dummy_device(dev, client->adapter, 0x77);
+	if (IS_ERR(codec))
+		return PTR_ERR(codec);
+	t->codec = devm_regmap_init_i2c(codec, &timpani_codec_regmap);
+	if (IS_ERR(t->codec))
+		return PTR_ERR(t->codec);
+	regcache_cache_only(t->codec, true);
+	ret = timpani_power_on(dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "Timpani identification failed\n");
+	pm_runtime_set_active(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_enable(dev);
+	ret = devm_add_action_or_reset(dev, timpani_pm_disable, dev);
+	if (ret)
+		return ret;
+	ret = devm_snd_soc_register_component(dev, &timpani_component, NULL, 0);
+	if (ret)
+		return ret;
+	pm_runtime_idle(dev);
+	dev_info(dev, "Timpani core identified, codec address 0x77\n");
+	return 0;
+}
+
+static const struct dev_pm_ops timpani_pm_ops = {
+	RUNTIME_PM_OPS(timpani_power_off, timpani_power_on, NULL)
+	SYSTEM_SLEEP_PM_OPS(pm_runtime_force_suspend, pm_runtime_force_resume)
+};
+
+static const struct of_device_id timpani_match[] = {
+	{ .compatible = "qcom,timpani" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, timpani_match);
+
+static struct i2c_driver timpani_driver = {
+	.probe = timpani_probe,
+	.driver = {
+		.name = "timpani",
+		.of_match_table = timpani_match,
+		.pm = pm_ptr(&timpani_pm_ops),
+	},
+};
+module_i2c_driver(timpani_driver);
+MODULE_DESCRIPTION("Qualcomm Timpani ASoC control interface");
+MODULE_LICENSE("GPL");
