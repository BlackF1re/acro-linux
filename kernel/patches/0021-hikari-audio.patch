+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/qcom,timpani.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm Timpani audio companion
+
+maintainers:
+  - BlackF1re <55582873+BlackF1re@users.noreply.github.com>
+
+description: |
+  Timpani has a control interface at I2C address 0x0d and a separate codec
+  register interface at 0x77 on the same bus. The control driver reserves
+  the latter address. Audio samples are exchanged with the Qualcomm DSP.
+
+properties:
+  compatible:
+    const: qcom,timpani
+  reg:
+    const: 0x0d
+  reset-gpios:
+    maxItems: 1
+  vdd-supply:
+    description: Core 1.2 V supply
+  vddio-supply:
+    description: Digital I/O 1.8 V supply
+  va-supply:
+    description: Analog 2.2 V supply
+
+required:
+  - compatible
+  - reg
+  - reset-gpios
+  - vdd-supply
+  - vddio-supply
+  - va-supply
+
+additionalProperties: false
