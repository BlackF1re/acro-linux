From: BlackF1re <plevickij57@gmail.com>
Date: Fri, 4 Sep 2026 12:19:49 +0700
Subject: [PATCH 29/36] arm: dts: qcom: power Hikari MDP4 before access

---
 arch/arm/boot/dts/qcom/qcom-msm8260-sony-hikari.dts | 7 ++++---
 drivers/gpu/drm/msm/disp/mdp4/mdp4_kms.c            | 2 ++
 2 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/msm/disp/mdp4/mdp4_kms.c b/drivers/gpu/drm/msm/disp/mdp4/mdp4_kms.c
index fd005b77261256643e3aa5f9ee4cda4fa10c7342..c78a1d08591df2ba24f558f71e98def050ec68bb 100644
--- a/drivers/gpu/drm/msm/disp/mdp4/mdp4_kms.c
+++ b/drivers/gpu/drm/msm/disp/mdp4/mdp4_kms.c
@@ -415,6 +415,8 @@ static int mdp4_kms_init(struct drm_device *dev)
 
 	clk_set_rate(mdp4_kms->clk, max_clk);
 
+	DRM_DEV_INFO(dev->dev,
+		     "reading MDP4 revision with display power domain enabled\n");
 	read_mdp_hw_revision(mdp4_kms, &major, &minor);
 
 	if (major != 4) {
