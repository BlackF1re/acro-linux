From b44a7cd030f7a5e57ce2f3b3a0190776c3a6548b Mon Sep 17 00:00:00 2001
From: BlackF1re <plevickij57@gmail.com>
Date: Fri, 4 Sep 2026 05:49:09 +0700
Subject: [PATCH 26/36] drm/msm/dsi: complete MSM8x60 boot-state quiesce

---
 drivers/gpu/drm/msm/dsi/dsi.h              |  1 +
 drivers/gpu/drm/msm/dsi/dsi_cfg.c          |  2 +-
 drivers/gpu/drm/msm/dsi/dsi_cfg.h          |  2 +-
 drivers/gpu/drm/msm/dsi/dsi_host.c         | 29 ++++++++++++++++------
 drivers/gpu/drm/msm/dsi/phy/dsi_phy.c      |  6 +++++
 drivers/gpu/drm/msm/dsi/phy/dsi_phy.h      |  1 +
 drivers/gpu/drm/msm/dsi/phy/dsi_phy_45nm.c | 13 ++++++++++
 7 files changed, 44 insertions(+), 10 deletions(-)

diff --git a/drivers/gpu/drm/msm/dsi/dsi.h b/drivers/gpu/drm/msm/dsi/dsi.h
index 86996d98512347bdccaf7e7781cc516d446857a6..d8c2e70cce0de7ed11dd5c0d7af6fb6a4e8dee28 100644
--- a/drivers/gpu/drm/msm/dsi/dsi.h
+++ b/drivers/gpu/drm/msm/dsi/dsi.h
@@ -147,6 +147,7 @@ int msm_dsi_phy_enable(struct msm_dsi_phy *phy,
 			struct msm_dsi_phy_clk_request *clk_req,
 			struct msm_dsi_phy_shared_timings *shared_timings);
 void msm_dsi_phy_disable(struct msm_dsi_phy *phy);
+void msm_dsi_phy_quiesce_boot_state(struct msm_dsi_phy *phy);
 void msm_dsi_phy_set_usecase(struct msm_dsi_phy *phy,
 			     enum msm_dsi_phy_usecase uc);
 void msm_dsi_phy_pll_save_state(struct msm_dsi_phy *phy);
diff --git a/drivers/gpu/drm/msm/dsi/dsi_cfg.c b/drivers/gpu/drm/msm/dsi/dsi_cfg.c
index 031d056ba235b3199df0fccc8ddef5c87594c7e9..ed5aa2b7b834c070ca004d2b7f8b381779dc0d8e 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_cfg.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_cfg.c
@@ -21,7 +21,7 @@ static const struct regulator_bulk_data msm8x60_dsi_regulators[] = {
  */
 static const struct msm_dsi_config msm8x60_dsi_cfg = {
 	.io_offset = 0,
-	.clear_clk_ctrl_on_suspend = true,
+	.quiesce_msm8x60_boot_state = true,
 	.regulator_data = msm8x60_dsi_regulators,
 	.num_regulators = ARRAY_SIZE(msm8x60_dsi_regulators),
 	.bus_clk_names = dsi_v2_bus_clk_names,
diff --git a/drivers/gpu/drm/msm/dsi/dsi_cfg.h b/drivers/gpu/drm/msm/dsi/dsi_cfg.h
index ce07183218f5c74c9358d2e4cb3b5e3174b9b9a1..be3e8733f3dcde8b09f1e52f12f3fb55e6867a2f 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_cfg.h
+++ b/drivers/gpu/drm/msm/dsi/dsi_cfg.h
@@ -43,7 +43,7 @@
 
 struct msm_dsi_config {
 	u32 io_offset;
-	bool clear_clk_ctrl_on_suspend;
+	bool quiesce_msm8x60_boot_state;
 	const struct regulator_bulk_data *regulator_data;
 	int num_regulators;
 	const char * const *bus_clk_names;
diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index 9ee7bc47d6fb6db7afd3dd38b000a2906d874c7c..edd8236fcb9474391c92cf3ffa31ad42c73c6314 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -375,16 +375,29 @@ int msm_dsi_runtime_suspend(struct device *dev)
 		return 0;
 
 	/*
-	 * MSM8x60's DSI_CLK_CTRL contains force-on bits for the three AHB
-	 * branches.  The downstream MSM8x60 DSI shutdown sequence clears this
-	 * register while the bus is still accessible, before asking the clock
-	 * controller to gate those branches.  Leaving the bootloader value in
-	 * place makes the clock framework wait forever for the halt bits.
+	 * Match Fuji's no-continuous-splash handoff before gating the AHB
+	 * branches: stop DSI clocks and controller, then stop the 45nm PLL.
+	 * The bootloader can leave all three active even though Linux has not
+	 * enabled the DRM pipeline yet.
 	 */
-	if (msm_host->cfg_hnd->cfg->clear_clk_ctrl_on_suspend) {
+	if (msm_host->cfg_hnd->cfg->quiesce_msm8x60_boot_state) {
 		dsi_write(msm_host, REG_DSI_CLK_CTRL, 0);
-		/* Complete the MMIO write before gating its bus clocks. */
-		wmb();
+		dsi_write(msm_host, REG_DSI_CTRL, 0);
+		msm_dsi_phy_quiesce_boot_state(msm_dsi->phy);
+		/* Flush host writes while the DSI slave AHB clock is still on. */
+		dsi_read(msm_host, REG_DSI_CTRL);
+
+		/*
+		 * Fuji disables master, slave, then AMP.  The configured array is
+		 * AMP, master, slave so generic bulk teardown would use the wrong
+		 * slave, master, AMP order.
+		 */
+		if (WARN_ON(msm_host->num_bus_clks != 3))
+			return 0;
+		clk_disable_unprepare(msm_host->bus_clks[1].clk);
+		clk_disable_unprepare(msm_host->bus_clks[2].clk);
+		clk_disable_unprepare(msm_host->bus_clks[0].clk);
+		return 0;
 	}
 
 	clk_bulk_disable_unprepare(msm_host->num_bus_clks, msm_host->bus_clks);
diff --git a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c
index 5ad2465689773b6fb39d368176fd2d8bc66fd85e..da77deeecba8a52382d4910503baba67119ce034 100644
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c
@@ -812,6 +812,12 @@ void msm_dsi_phy_disable(struct msm_dsi_phy *phy)
 	pm_runtime_put(&phy->pdev->dev);
 }
 
+void msm_dsi_phy_quiesce_boot_state(struct msm_dsi_phy *phy)
+{
+	if (phy && phy->cfg->ops.quiesce_boot_state)
+		phy->cfg->ops.quiesce_boot_state(phy);
+}
+
 void msm_dsi_phy_set_usecase(struct msm_dsi_phy *phy,
 			     enum msm_dsi_phy_usecase uc)
 {
diff --git a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h
index df56754578078af31182e094498698dd72aa934b..b5df76d87554ed86ae0fd9f1c2eab834ba354b43 100644
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h
@@ -18,6 +18,7 @@ struct msm_dsi_phy_ops {
 	int (*enable)(struct msm_dsi_phy *phy,
 			struct msm_dsi_phy_clk_request *clk_req);
 	void (*disable)(struct msm_dsi_phy *phy);
+	void (*quiesce_boot_state)(struct msm_dsi_phy *phy);
 	void (*save_pll_state)(struct msm_dsi_phy *phy);
 	int (*restore_pll_state)(struct msm_dsi_phy *phy);
 	bool (*set_continuous_clock)(struct msm_dsi_phy *phy, bool enable);
diff --git a/drivers/gpu/drm/msm/dsi/phy/dsi_phy_45nm.c b/drivers/gpu/drm/msm/dsi/phy/dsi_phy_45nm.c
index be3a129d9e9cf83ba1b82de4b392fc419b9956c7..db7ca5f31d8be31092a389997558f3672047813b 100644
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy_45nm.c
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy_45nm.c
@@ -157,6 +157,18 @@ static void dsi_45nm_disable(struct msm_dsi_phy *phy)
 	wmb();
 }
 
+static void dsi_45nm_quiesce_boot_state(struct msm_dsi_phy *phy)
+{
+	/*
+	 * Fuji's no-continuous-splash handoff clears PLL_CTRL_0 before the
+	 * DSI AHB branches are gated.  This is separate from the normal PHY
+	 * disable path because the DRM driver has not enabled the PHY yet.
+	 */
+	writel(0, phy->pll_base);
+	/* Flush the posted write while the DSI slave AHB clock is still on. */
+	readl(phy->pll_base);
+}
+
 static const struct regulator_bulk_data dsi_45nm_regulators[] = {
 	{ .supply = "vdda", .init_load_uA = 100000 }, /* PM8058 L0, 1.2 V */
 };
@@ -167,6 +179,7 @@ const struct msm_dsi_phy_cfg dsi_phy_45nm_msm8x60_cfgs = {
 	.ops = {
 		.enable = dsi_45nm_enable,
 		.disable = dsi_45nm_disable,
+		.quiesce_boot_state = dsi_45nm_quiesce_boot_state,
 		.pll_init = dsi_45nm_pll_init,
 	},
 	.min_pll_rate = HIKARI_BITCLK,
