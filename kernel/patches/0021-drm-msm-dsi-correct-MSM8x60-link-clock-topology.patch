diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index 148dd1c8a5d27d90267cc47b10c762fad4408e37..bef189a84f2feb79c6077503d858cb10c1b31d73 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -520,6 +520,29 @@ int dsi_link_clk_set_rate_v2(struct msm_dsi_host *msm_host)
 	return 0;
 }
 
+/*
+ * MSM8x60 predates the separate DSI source clock used by APQ8064.  Its
+ * escape clock is fixed to PXO/2 in MMCC and the pixel clock is the shared
+ * MDP pixel clock.  Only the PHY byte clock and MDP pixel clock are
+ * programmable link clocks.
+ */
+int dsi_link_clk_set_rate_msm8x60(struct msm_dsi_host *msm_host)
+{
+	int ret;
+
+	ret = clk_set_rate(msm_host->byte_clk, msm_host->byte_clk_rate);
+	if (ret)
+		return dev_err_probe(&msm_host->pdev->dev, ret,
+				     "failed to set DSI byte clock rate\n");
+
+	ret = clk_set_rate(msm_host->pixel_clk, msm_host->pixel_clk_rate);
+	if (ret)
+		return dev_err_probe(&msm_host->pdev->dev, ret,
+				     "failed to set DSI pixel clock rate\n");
+
+	return 0;
+}
+
 int dsi_link_clk_enable_v2(struct msm_dsi_host *msm_host)
 {
 	int ret;
@@ -560,6 +583,31 @@ int dsi_link_clk_enable_v2(struct msm_dsi_host *msm_host)
 	return ret;
 }
 
+int dsi_link_clk_enable_msm8x60(struct msm_dsi_host *msm_host)
+{
+	int ret;
+
+	ret = clk_prepare_enable(msm_host->byte_clk);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(msm_host->esc_clk);
+	if (ret)
+		goto disable_byte;
+
+	ret = clk_prepare_enable(msm_host->pixel_clk);
+	if (ret)
+		goto disable_esc;
+
+	return 0;
+
+disable_esc:
+	clk_disable_unprepare(msm_host->esc_clk);
+disable_byte:
+	clk_disable_unprepare(msm_host->byte_clk);
+	return ret;
+}
+
 void dsi_link_clk_disable_6g(struct msm_dsi_host *msm_host)
 {
 	clk_disable_unprepare(msm_host->esc_clk);
@@ -576,6 +624,13 @@ void dsi_link_clk_disable_v2(struct msm_dsi_host *msm_host)
 	clk_disable_unprepare(msm_host->byte_clk);
 }
 
+void dsi_link_clk_disable_msm8x60(struct msm_dsi_host *msm_host)
+{
+	clk_disable_unprepare(msm_host->pixel_clk);
+	clk_disable_unprepare(msm_host->esc_clk);
+	clk_disable_unprepare(msm_host->byte_clk);
+}
