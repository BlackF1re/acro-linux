Date: Sun, 4 Oct 2026 21:30:39 +0700
Subject: [PATCH] cpufreq: add MSM8660 Scorpion DVFS

Split without semantic changes from the signed Hikari integration.

Original-commit: f7a6e62ff206edff9cee8c04226e85f1102a9a85
---
 drivers/cpufreq/Kconfig.arm            |    9 +
 drivers/cpufreq/Makefile               |    1 +
 drivers/cpufreq/qcom-msm8660-cpufreq.c | 1134 ++++++++++++++++++++++++
 3 files changed, 1144 insertions(+)
 create mode 100644 drivers/cpufreq/qcom-msm8660-cpufreq.c

diff --git a/drivers/cpufreq/Kconfig.arm b/drivers/cpufreq/Kconfig.arm
index a441668f9e0cc698ff7b4cacc7ca43a87689492e..9379c00c022d715856379ef1845262306f32abb8 100644
--- a/drivers/cpufreq/Kconfig.arm
+++ b/drivers/cpufreq/Kconfig.arm
@@ -273,3 +273,12 @@ config ARM_PXA2xx_CPUFREQ
 	  This add the CPUFreq driver support for Intel PXA2xx SOCs.
 
 	  If in doubt, say N.
+
+
+config ARM_QCOM_MSM8660_CPUFREQ
+	bool "Qualcomm MSM8660 CPU frequency driver"
+	depends on ARCH_QCOM && OF && REGULATOR && INTERCONNECT
+	select REGULATOR_QCOM_MSM8660_SAW
+	help
+	  CPU, shared L2 and voltage/fabric DVFS driver for Qualcomm
+	  MSM8260/MSM8660.
diff --git a/drivers/cpufreq/Makefile b/drivers/cpufreq/Makefile
