From: Hikari project
Date: Wed, 23 Sep 2026 00:00:00 +0700
Subject: [PATCH] thermal: qcom: add MSM8660 TSENS support

MSM8660 contains the version-zero TSENS block in GCC, like the later
MSM8960 family, but exposes one useful sensor and uses a different QFPROM
calibration layout and slope.  Describe the shared GCC register block as a
simple MFD, add the read-only QFPROM cells and use the existing Qualcomm
thermal framework rather than the obsolete board-file driver.

The register offsets, interrupt, calibration locations and transfer function
come from Sony's MSM8660 BSP.  The BSP's 0.702 degree-C-per-code slope is the
inverse of the code-per-degree representation used by the upstream driver.

---
 .../bindings/clock/qcom,gcc-msm8660.yaml      |  8 ++--
 .../bindings/nvmem/qcom,qfprom.yaml           |  1 +
 .../bindings/thermal/qcom-tsens.yaml          |  1 +
 arch/arm/boot/dts/qcom/qcom-msm8660.dtsi     | 33 ++++++++++++++-
 drivers/thermal/qcom/tsens-8960.c             | 99 ++++++++++++++++++++++++++
 drivers/thermal/qcom/tsens.c                  |  3 ++
 drivers/thermal/qcom/tsens.h                  |  2 +-
 7 files changed, 142 insertions(+), 5 deletions(-)

diff --git a/Documentation/devicetree/bindings/clock/qcom,gcc-msm8660.yaml b/Documentation/devicetree/bindings/clock/qcom,gcc-msm8660.yaml
index 70c9da1f3..8e792ae59 100644
--- a/Documentation/devicetree/bindings/clock/qcom,gcc-msm8660.yaml
+++ b/Documentation/devicetree/bindings/clock/qcom,gcc-msm8660.yaml
@@ -23,8 +23,10 @@ allOf:
 
 properties:
   compatible:
-    enum:
-      - qcom,gcc-msm8660
+    items:
+      - const: qcom,gcc-msm8660
+      - const: syscon
+      - const: simple-mfd
 
   clocks:
     maxItems: 2
@@ -45,7 +47,7 @@ examples:
   # Example for GCC for MSM8974:
   - |
     clock-controller@900000 {
-      compatible = "qcom,gcc-msm8660";
+      compatible = "qcom,gcc-msm8660", "syscon", "simple-mfd";
       reg = <0x900000 0x4000>;
       #clock-cells = <1>;
       #reset-cells = <1>;
diff --git a/Documentation/devicetree/bindings/nvmem/qcom,qfprom.yaml b/Documentation/devicetree/bindings/nvmem/qcom,qfprom.yaml
index bc0a0898b..8de4f4779 100644
--- a/Documentation/devicetree/bindings/nvmem/qcom,qfprom.yaml
+++ b/Documentation/devicetree/bindings/nvmem/qcom,qfprom.yaml
@@ -33,6 +33,7 @@ properties:
           - qcom,kaanapali-qfprom
           - qcom,milos-qfprom
           - qcom,msm8226-qfprom
+          - qcom,msm8660-qfprom
