index b5ec70201..4c9719d79 100644
--- a/drivers/thermal/qcom/tsens.c
+++ b/drivers/thermal/qcom/tsens.c
@@ -1194,6 +1194,9 @@ static const struct of_device_id tsens_table[] = {
 	}, {
 		.compatible = "qcom,msm8956-tsens",
 		.data = &data_8956,
+	}, {
+		.compatible = "qcom,msm8660-tsens",
+		.data = &data_8660,
 	}, {
 		.compatible = "qcom,msm8960-tsens",
 		.data = &data_8960,
diff --git a/drivers/thermal/qcom/tsens.h b/drivers/thermal/qcom/tsens.h
index e8376accd..ca8a45326 100644
--- a/drivers/thermal/qcom/tsens.h
+++ b/drivers/thermal/qcom/tsens.h
@@ -663,7 +663,7 @@ static inline int tsens_suspend_common(struct tsens_priv *priv)
 #endif
 
 /* TSENS target */
-extern struct tsens_plat_data data_8960;
+extern struct tsens_plat_data data_8660, data_8960;
 
 /* TSENS v0.1 targets */
 extern struct tsens_plat_data data_8226, data_8909, data_8916, data_8939, data_8974, data_9607;
