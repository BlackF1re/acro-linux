From fb48685d80a0bfb4b55b67afc5ec1463d2833d0f Mon Sep 17 00:00:00 2001
From: BlackF1re <plevickij57@gmail.com>
Date: Sun, 6 Sep 2026 02:00:41 +0700
Subject: [PATCH] iommu/msm: track client masters per provider

MSM8x60 display clients reference more than one IOMMU provider. Keep one master object per provider and select only the matching device master during attach and detach instead of relying on the single per-device IOMMU private pointer.

This also makes a deferred probe retry safe after the IOMMU core has released the per-device state while the provider-local context list remains populated.

Based on the multi-provider handling in the current Tenderloin MSM8x60 port at shr-distribution/linux branch 6.18, head 37d5887cd67dae88b0eb37564adc8e6c0c39c609 (2026-09-06).

Signed-off-by: BlackF1re <plevickij57@gmail.com>
---
 drivers/iommu/msm_iommu.c | 90 ++++++++++++++++++++++-----------------
 1 file changed, 51 insertions(+), 39 deletions(-)

diff --git a/drivers/iommu/msm_iommu.c b/drivers/iommu/msm_iommu.c
index 8f10bfdf5..2448d90ee 100644
--- a/drivers/iommu/msm_iommu.c
+++ b/drivers/iommu/msm_iommu.c
@@ -357,23 +357,35 @@ static int msm_iommu_domain_config(struct msm_priv *priv)
 	return 0;
 }
 
+/*
+ * Return the master owned by @dev on this specific IOMMU instance.
+ *
+ * MSM8x60 clients such as MDP reference more than one IOMMU provider.  A
+ * device therefore has one master object per provider, while
+ * dev_iommu_priv_set() can retain only one pointer for the whole device.
+ */
+static struct msm_iommu_ctx_dev *
+find_master_for_dev(struct msm_iommu_dev *iommu, struct device *dev)
+{
+	struct msm_iommu_ctx_dev *master;
+
+	list_for_each_entry(master, &iommu->ctx_list, list)
+		if (master->of_node == dev->of_node)
+			return master;
+
+	return NULL;
+}
+
 /* Must be called under msm_iommu_lock */
 static struct msm_iommu_dev *find_iommu_for_dev(struct device *dev)
 {
-	struct msm_iommu_dev *iommu, *ret = NULL;
-	struct msm_iommu_ctx_dev *master;
+	struct msm_iommu_dev *iommu;
 
-	list_for_each_entry(iommu, &qcom_iommu_devices, dev_node) {
-		master = list_first_entry(&iommu->ctx_list,
-					  struct msm_iommu_ctx_dev,
-					  list);
-		if (master->of_node == dev->of_node) {
-			ret = iommu;
-			break;
-		}
-	}
+	list_for_each_entry(iommu, &qcom_iommu_devices, dev_node)
+		if (find_master_for_dev(iommu, dev))
+			return iommu;
 
-	return ret;
+	return NULL;
 }
 
 static struct iommu_device *msm_iommu_probe_device(struct device *dev)
@@ -405,10 +417,8 @@ static int msm_iommu_attach_dev(struct iommu_domain *domain, struct device *dev,
 
 	spin_lock_irqsave(&msm_iommu_lock, flags);
 	list_for_each_entry(iommu, &qcom_iommu_devices, dev_node) {
-		master = list_first_entry(&iommu->ctx_list,
-					  struct msm_iommu_ctx_dev,
-					  list);
-		if (master->of_node == dev->of_node) {
+		master = find_master_for_dev(iommu, dev);
+		if (master) {
 			ret = __enable_clocks(iommu);
 			if (ret)
 				goto fail;
@@ -423,23 +433,21 @@ static int msm_iommu_attach_dev(struct iommu_domain *domain, struct device *dev,
 				iommu->reset_done = true;
 			}
 
-			list_for_each_entry(master, &iommu->ctx_list, list) {
-				if (master->num) {
-					dev_err(dev, "domain already attached");
-					ret = -EEXIST;
-					goto fail;
-				}
-				master->num =
-					msm_iommu_alloc_ctx(iommu->context_map,
-							    0, iommu->ncb);
-				if (IS_ERR_VALUE(master->num)) {
-					ret = -ENODEV;
-					goto fail;
-				}
-				config_mids(iommu, master);
-				__program_context(iommu->base, master->num,
-						  priv);
+			if (master->num) {
+				dev_err(dev, "domain already attached");
+				ret = -EEXIST;
+				__disable_clocks(iommu);
+				goto fail;
 			}
+			master->num = msm_iommu_alloc_ctx(iommu->context_map,
+							  0, iommu->ncb);
+			if (IS_ERR_VALUE(master->num)) {
+				ret = -ENODEV;
+				__disable_clocks(iommu);
+				goto fail;
+			}
+			config_mids(iommu, master);
+			__program_context(iommu->base, master->num, priv);
 			__disable_clocks(iommu);
 			list_add(&iommu->dom_node, &priv->list_attached);
 		}
@@ -469,14 +477,17 @@ static int msm_iommu_identity_attach(struct iommu_domain *identity_domain,
 
 	spin_lock_irqsave(&msm_iommu_lock, flags);
 	list_for_each_entry(iommu, &priv->list_attached, dom_node) {
+		master = find_master_for_dev(iommu, dev);
+		if (!master)
+			continue;
+
 		ret = __enable_clocks(iommu);
 		if (ret)
 			goto fail;
 
-		list_for_each_entry(master, &iommu->ctx_list, list) {
-			msm_iommu_free_ctx(iommu->context_map, master->num);
-			__reset_context(iommu->base, master->num);
-		}
+		msm_iommu_free_ctx(iommu->context_map, master->num);
+		__reset_context(iommu->base, master->num);
+		master->num = 0;
 		__disable_clocks(iommu);
 	}
 fail:
@@ -611,10 +622,12 @@ static int insert_iommu_master(struct device *dev,
 				struct msm_iommu_dev **iommu,
 				const struct of_phandle_args *spec)
 {
-	struct msm_iommu_ctx_dev *master = dev_iommu_priv_get(dev);
+	struct msm_iommu_ctx_dev *master;
 	int sid;
 
-	if (list_empty(&(*iommu)->ctx_list)) {
+	/* A multi-provider device needs one persistent master per provider. */
+	master = find_master_for_dev(*iommu, dev);
+	if (!master) {
 		master = kzalloc_obj(*master, GFP_ATOMIC);
 		if (!master) {
 			dev_err(dev, "Failed to allocate iommu_master\n");
@@ -622,7 +635,6 @@ static int insert_iommu_master(struct device *dev,
 		}
 		master->of_node = dev->of_node;
 		list_add(&master->list, &(*iommu)->ctx_list);
-		dev_iommu_priv_set(dev, master);
 	}
 
 	for (sid = 0; sid < master->num_mids; sid++)
-- 
2.53.0

