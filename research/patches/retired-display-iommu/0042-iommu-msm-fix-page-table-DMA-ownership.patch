From 96651e282822a6b587b43dc3c4767a1f27581933 Mon Sep 17 00:00:00 2001
From: Hikari Patch Materializer <hikari-materializer@localhost>
Date: Sun, 6 Sep 2026 14:11:58 +0700
Subject: [PATCH] iommu/msm: fix page-table DMA ownership

---
 drivers/iommu/msm_iommu.c | 163 +++++++++++++++++++++++++-------------
 drivers/iommu/msm_iommu.h |   8 +-
 2 files changed, 115 insertions(+), 56 deletions(-)

diff --git a/drivers/iommu/msm_iommu.c b/drivers/iommu/msm_iommu.c
index 2448d90ee5db6a6ee632733ded126ec3142c5ed5..08a38cab8741d09dba903b0183a963f6cd853089 100644
--- a/drivers/iommu/msm_iommu.c
+++ b/drivers/iommu/msm_iommu.c
@@ -42,10 +42,13 @@ struct msm_priv {
 	struct iommu_domain domain;
 	struct io_pgtable_cfg	cfg;
 	struct io_pgtable_ops	*iop;
-	struct device		*dev;
+	struct device		*client;
+	struct device		*iommu_dev;
 	spinlock_t		pgtlock; /* pagetable lock */
 };
 
+static struct msm_iommu_dev *find_iommu_for_dev(struct device *dev);
+
 static struct msm_priv *to_msm_priv(struct iommu_domain *dom)
 {
 	return container_of(dom, struct msm_priv, domain);
@@ -117,17 +120,17 @@ static void msm_iommu_reset(void __iomem *base, int ncb)
 static void __flush_iotlb(void *cookie)
 {
 	struct msm_priv *priv = cookie;
-	struct msm_iommu_dev *iommu = NULL;
 	struct msm_iommu_ctx_dev *master;
+	struct msm_iommu_dev *iommu;
 	int ret = 0;
 
-	list_for_each_entry(iommu, &priv->list_attached, dom_node) {
+	list_for_each_entry(master, &priv->list_attached, domain_node) {
+		iommu = master->iommu;
 		ret = __enable_clocks(iommu);
 		if (ret)
 			goto fail;
 
-		list_for_each_entry(master, &iommu->ctx_list, list)
-			SET_CTX_TLBIALL(iommu->base, master->num, 0);
+		SET_CTX_TLBIALL(iommu->base, master->num, 0);
 
 		__disable_clocks(iommu);
 	}
@@ -139,25 +142,23 @@ static void __flush_iotlb_range(unsigned long iova, size_t size,
 				size_t granule, bool leaf, void *cookie)
 {
 	struct msm_priv *priv = cookie;
-	struct msm_iommu_dev *iommu = NULL;
 	struct msm_iommu_ctx_dev *master;
+	struct msm_iommu_dev *iommu;
+	unsigned long addr, offset;
 	int ret = 0;
-	int temp_size;
 
-	list_for_each_entry(iommu, &priv->list_attached, dom_node) {
+	list_for_each_entry(master, &priv->list_attached, domain_node) {
+		iommu = master->iommu;
 		ret = __enable_clocks(iommu);
 		if (ret)
 			goto fail;
 
-		list_for_each_entry(master, &iommu->ctx_list, list) {
-			temp_size = size;
-			do {
-				iova &= TLBIVA_VA;
-				iova |= GET_CONTEXTIDR_ASID(iommu->base,
-							    master->num);
-				SET_TLBIVA(iommu->base, master->num, iova);
-				iova += granule;
-			} while (temp_size -= granule);
+		for (offset = 0; offset < size; offset += granule) {
+			addr = iova + offset;
+			addr &= TLBIVA_VA;
+			addr |= GET_CONTEXTIDR_ASID(iommu->base,
+						    master->num);
+			SET_TLBIVA(iommu->base, master->num, addr);
 		}
 
 		__disable_clocks(iommu);
@@ -311,6 +312,7 @@ static struct iommu_domain *msm_iommu_domain_alloc_paging(struct device *dev)
 		goto fail_nomem;
 
 	INIT_LIST_HEAD(&priv->list_attached);
+	spin_lock_init(&priv->pgtlock);
 
 	priv->domain.pgsize_bitmap = MSM_IOMMU_PGSIZES;
 
@@ -327,30 +329,54 @@ static struct iommu_domain *msm_iommu_domain_alloc_paging(struct device *dev)
 
 static void msm_iommu_domain_free(struct iommu_domain *domain)
 {
-	struct msm_priv *priv;
-	unsigned long flags;
+	struct msm_priv *priv = to_msm_priv(domain);
 
-	spin_lock_irqsave(&msm_iommu_lock, flags);
-	priv = to_msm_priv(domain);
+	WARN_ON(!list_empty(&priv->list_attached));
+	if (priv->iop)
+		free_io_pgtable_ops(priv->iop);
+	if (priv->iommu_dev)
+		put_device(priv->iommu_dev);
 	kfree(priv);
-	spin_unlock_irqrestore(&msm_iommu_lock, flags);
 }
 
-static int msm_iommu_domain_config(struct msm_priv *priv)
+static int msm_iommu_domain_config(struct msm_priv *priv, struct device *dev)
 {
-	spin_lock_init(&priv->pgtlock);
+	struct msm_iommu_dev *iommu;
+	unsigned long flags;
+
+	if (priv->iop)
+		return priv->client == dev ? 0 : -EBUSY;
+
+	/*
+	 * io-pgtable uses cfg.iommu_dev for DMA cache maintenance of the
+	 * page tables themselves. It must therefore be the IOMMU provider,
+	 * not the client whose DMA ops translate through this same domain.
+	 */
+	spin_lock_irqsave(&msm_iommu_lock, flags);
+	iommu = find_iommu_for_dev(dev);
+	if (iommu)
+		priv->iommu_dev = get_device(iommu->dev);
+	spin_unlock_irqrestore(&msm_iommu_lock, flags);
+
+	if (!priv->iommu_dev)
+		return -ENODEV;
+
+	priv->client = dev;
 
 	priv->cfg = (struct io_pgtable_cfg) {
 		.pgsize_bitmap = priv->domain.pgsize_bitmap,
 		.ias = 32,
 		.oas = 32,
 		.tlb = &msm_iommu_flush_ops,
-		.iommu_dev = priv->dev,
+		.iommu_dev = priv->iommu_dev,
 	};
 
 	priv->iop = alloc_io_pgtable_ops(ARM_V7S, &priv->cfg, priv);
 	if (!priv->iop) {
-		dev_err(priv->dev, "Failed to allocate pgtable\n");
+		dev_err(dev, "Failed to allocate pgtable\n");
+		put_device(priv->iommu_dev);
+		priv->iommu_dev = NULL;
+		priv->client = NULL;
 		return -EINVAL;
 	}
 
@@ -407,21 +433,25 @@ static int msm_iommu_attach_dev(struct iommu_domain *domain, struct device *dev,
 				struct iommu_domain *old)
 {
 	int ret = 0;
+	int detach_ret;
 	unsigned long flags;
 	struct msm_iommu_dev *iommu;
 	struct msm_priv *priv = to_msm_priv(domain);
-	struct msm_iommu_ctx_dev *master;
+	struct msm_iommu_ctx_dev *master, *tmp;
+	bool found = false;
 
-	priv->dev = dev;
-	msm_iommu_domain_config(priv);
+	ret = msm_iommu_domain_config(priv, dev);
+	if (ret)
+		return ret;
 
 	spin_lock_irqsave(&msm_iommu_lock, flags);
 	list_for_each_entry(iommu, &qcom_iommu_devices, dev_node) {
 		master = find_master_for_dev(iommu, dev);
 		if (master) {
+			found = true;
 			ret = __enable_clocks(iommu);
 			if (ret)
-				goto fail;
+				goto unwind;
 
 			/*
 			 * MSM8x60 can still carry bootloader display DMA state while
@@ -433,27 +463,54 @@ static int msm_iommu_attach_dev(struct iommu_domain *domain, struct device *dev,
 				iommu->reset_done = true;
 			}
 
-			if (master->num) {
-				dev_err(dev, "domain already attached");
+			if (master->num >= 0 ||
+			    !list_empty(&master->domain_node)) {
+				dev_err(dev, "domain already attached\n");
 				ret = -EEXIST;
 				__disable_clocks(iommu);
-				goto fail;
+				goto unwind;
 			}
 			master->num = msm_iommu_alloc_ctx(iommu->context_map,
 							  0, iommu->ncb);
-			if (IS_ERR_VALUE(master->num)) {
-				ret = -ENODEV;
+			if (master->num < 0) {
+				ret = master->num;
+				master->num = -1;
 				__disable_clocks(iommu);
-				goto fail;
+				goto unwind;
 			}
 			config_mids(iommu, master);
 			__program_context(iommu->base, master->num, priv);
 			__disable_clocks(iommu);
-			list_add(&iommu->dom_node, &priv->list_attached);
+			list_add_tail(&master->domain_node, &priv->list_attached);
 		}
 	}
 
-fail:
+	if (!found)
+		ret = -ENODEV;
+
+	goto out;
+
+unwind:
+	list_for_each_entry_safe(master, tmp, &priv->list_attached,
+				 domain_node) {
+		if (master->of_node != dev->of_node)
+			continue;
+
+		iommu = master->iommu;
+		detach_ret = __enable_clocks(iommu);
+		if (detach_ret) {
+			dev_err(dev, "failed to unwind IOMMU context: %d\n",
+				detach_ret);
+			continue;
+		}
+		__reset_context(iommu->base, master->num);
+		msm_iommu_free_ctx(iommu->context_map, master->num);
+		master->num = -1;
+		list_del_init(&master->domain_node);
+		__disable_clocks(iommu);
+	}
+
+out:
 	spin_unlock_irqrestore(&msm_iommu_lock, flags);
 
 	return ret;
@@ -466,28 +523,29 @@ static int msm_iommu_identity_attach(struct iommu_domain *identity_domain,
 	struct msm_priv *priv;
 	unsigned long flags;
 	struct msm_iommu_dev *iommu;
-	struct msm_iommu_ctx_dev *master;
+	struct msm_iommu_ctx_dev *master, *tmp;
 	int ret = 0;
 
 	if (old == identity_domain || !old)
 		return 0;
 
 	priv = to_msm_priv(old);
-	free_io_pgtable_ops(priv->iop);
 
 	spin_lock_irqsave(&msm_iommu_lock, flags);
-	list_for_each_entry(iommu, &priv->list_attached, dom_node) {
-		master = find_master_for_dev(iommu, dev);
-		if (!master)
+	list_for_each_entry_safe(master, tmp, &priv->list_attached,
+				 domain_node) {
+		if (master->of_node != dev->of_node)
 			continue;
 
+		iommu = master->iommu;
 		ret = __enable_clocks(iommu);
 		if (ret)
 			goto fail;
 
-		msm_iommu_free_ctx(iommu->context_map, master->num);
 		__reset_context(iommu->base, master->num);
-		master->num = 0;
+		msm_iommu_free_ctx(iommu->context_map, master->num);
+		master->num = -1;
+		list_del_init(&master->domain_node);
 		__disable_clocks(iommu);
 	}
 fail:
@@ -557,16 +615,12 @@ static phys_addr_t msm_iommu_iova_to_phys(struct iommu_domain *domain,
 	spin_lock_irqsave(&msm_iommu_lock, flags);
 
 	priv = to_msm_priv(domain);
-	iommu = list_first_entry(&priv->list_attached,
-				 struct msm_iommu_dev, dom_node);
-
-	if (list_empty(&iommu->ctx_list))
+	if (list_empty(&priv->list_attached))
 		goto fail;
 
-	master = list_first_entry(&iommu->ctx_list,
-				  struct msm_iommu_ctx_dev, list);
-	if (!master)
-		goto fail;
+	master = list_first_entry(&priv->list_attached,
+				  struct msm_iommu_ctx_dev, domain_node);
+	iommu = master->iommu;
 
 	ret = __enable_clocks(iommu);
 	if (ret)
@@ -634,6 +688,9 @@ static int insert_iommu_master(struct device *dev,
 			return -ENOMEM;
 		}
 		master->of_node = dev->of_node;
+		master->iommu = *iommu;
+		master->num = -1;
+		INIT_LIST_HEAD(&master->domain_node);
 		list_add(&master->list, &(*iommu)->ctx_list);
 	}
 
diff --git a/drivers/iommu/msm_iommu.h b/drivers/iommu/msm_iommu.h
index 6532a27ab071b176e2dc5c7763cb05701bdd0cfa..8d2e5c30beedd1f0533dc0b6d02e1b8060c9ee8a 100644
--- a/drivers/iommu/msm_iommu.h
+++ b/drivers/iommu/msm_iommu.h
@@ -41,7 +41,6 @@
  * clk:		The bus clock for this IOMMU hardware instance
  * pclk:	The clock for the IOMMU bus interconnect
  * dev_node:	list head in qcom_iommu_device_list
- * dom_node:	list head for domain
  * ctx_list:	list of 'struct msm_iommu_ctx_dev'
  * context_map: Bitmap to track allocated context banks
  */
@@ -53,7 +52,6 @@ struct msm_iommu_dev {
 	struct clk *clk;
 	struct clk *pclk;
 	struct list_head dev_node;
-	struct list_head dom_node;
 	struct list_head ctx_list;
 	DECLARE_BITMAP(context_map, IOMMU_MAX_CBS);
 
@@ -75,14 +73,18 @@ struct msm_iommu_dev {
  *		AXI bus that identifies the function associated with a specific
  *		memory request. (See ARM spec).
  * num_mids	Total number of mids
- * node		list head in ctx_list
+ * iommu	IOMMU hardware instance owning this context
+ * list		list head in the provider ctx_list
+ * domain_node	list head in the currently attached domain
  */
 struct msm_iommu_ctx_dev {
 	struct device_node *of_node;
 	int num;
 	int mids[MAX_NUM_MIDS];
 	int num_mids;
+	struct msm_iommu_dev *iommu;
 	struct list_head list;
+	struct list_head domain_node;
 };
 
 /*
