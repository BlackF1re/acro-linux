From 2222222222222222222222222222222222222222 Mon Sep 17 00:00:00 2001
From: BlackF1re <55582873+BlackF1re@users.noreply.github.com>
Date: Sat, 5 Sep 2026 21:45:00 +0700
Subject: [PATCH] iommu/msm: defer MSM8x60 reset until first paging attach

The probe-time reset and V2P/PAR presence transaction are destructive to
state left by the bootloader and reject both Hikari MDP IOMMUs in practice:
PAR reads back as zero and probe returns -ENODEV even though MMCC and both
IOMMU clocks are available.

A current working MSM8x60 Tenderloin port avoids touching live IOMMU state
at probe time.  It keeps the default domain in identity mode and defers the
hardware reset until the first paging client explicitly attaches.  DRM/MSM
then takes ownership of the display path before the IOMMU is reset and
programmed.

Adapt that minimal model to the pinned msm_iommu driver: remember whether
reset has run, reset exactly once after clocks are enabled on the first
paging attach, use the identity default domain during generic device probe,
and remove the probe-time PAR heuristic entirely.

Based-on: shr-distribution/linux tenderloin/6.18/upstream-patches,
          drivers/iommu/msm_iommu.c and msm_iommu.h
Contributor context: Herman van Hazendonk
Original driver: Code Aurora Forum, Stepan Moskovchenko
License: GPL-2.0-only

---
 drivers/iommu/msm_iommu.c | 36 ++++++++++++++++++------------------
 drivers/iommu/msm_iommu.h |  6 ++++++
 2 files changed, 24 insertions(+), 18 deletions(-)

diff --git a/drivers/iommu/msm_iommu.h b/drivers/iommu/msm_iommu.h
--- a/drivers/iommu/msm_iommu.h
+++ b/drivers/iommu/msm_iommu.h
@@ -63,4 +63,10 @@ struct msm_iommu_dev {
 	DECLARE_BITMAP(context_map, IOMMU_MAX_CBS);
 
 	struct iommu_device iommu;
+
+	/*
+	 * Track whether the destructive hardware reset has run. MSM8x60
+	 * defers it until a paging client first takes ownership of the IOMMU.
+	 */
+	bool reset_done;
 };
diff --git a/drivers/iommu/msm_iommu.c b/drivers/iommu/msm_iommu.c
--- a/drivers/iommu/msm_iommu.c
+++ b/drivers/iommu/msm_iommu.c
@@ -414,4 +414,14 @@ static int msm_iommu_attach_dev(struct iommu_domain *domain, struct device *dev,
 			if (ret)
 				goto fail;
 
+			/*
+			 * MSM8x60 can still carry bootloader display DMA state while
+			 * devices are probing. Reset only when a paging client really
+			 * takes ownership of this IOMMU.
+			 */
+			if (!iommu->reset_done) {
+				msm_iommu_reset(iommu->base, iommu->ncb);
+				iommu->reset_done = true;
+			}
+
 			list_for_each_entry(master, &iommu->ctx_list, list) {
@@ -678,6 +688,15 @@ irqreturn_t msm_iommu_fault_handler(int irq, void *dev_id)
 	return 0;
 }
 
+static int msm_iommu_def_domain_type(struct device *dev)
+{
+	/*
+	 * Preserve bootloader DMA during generic bus probing. DRM/MSM creates
+	 * its paging domain when it is ready to take ownership of the display.
+	 */
+	return IOMMU_DOMAIN_IDENTITY;
+}
+
 static struct iommu_ops msm_iommu_ops = {
 	.identity_domain = &msm_iommu_identity_domain,
 	.domain_alloc_paging = msm_iommu_domain_alloc_paging,
@@ -683,6 +703,7 @@ static struct iommu_ops msm_iommu_ops = {
 	.probe_device = msm_iommu_probe_device,
 	.device_group = generic_device_group,
 	.of_xlate = qcom_iommu_of_xlate,
+	.def_domain_type = msm_iommu_def_domain_type,
 	.default_domain_ops = &(const struct iommu_domain_ops) {
 		.attach_dev	= msm_iommu_attach_dev,
 		.map_pages	= msm_iommu_map,
@@ -716,7 +737,7 @@ static int msm_iommu_probe(struct platform_device *pdev)
 	struct resource *r;
 	resource_size_t ioaddr;
 	struct msm_iommu_dev *iommu;
-	int ret, par, val;
+	int ret, val;
 
 	iommu = devm_kzalloc(&pdev->dev, sizeof(*iommu), GFP_KERNEL);
 	if (!iommu)
@@ -757,18 +778,4 @@ static int msm_iommu_probe(struct platform_device *pdev)
 	}
 	iommu->ncb = val;
 
-	msm_iommu_reset(iommu->base, iommu->ncb);
-	SET_M(iommu->base, 0, 1);
-	SET_PAR(iommu->base, 0, 0);
-	SET_V2PCFG(iommu->base, 0, 1);
-	SET_V2PPR(iommu->base, 0, 0);
-	par = GET_PAR(iommu->base, 0);
-	SET_V2PCFG(iommu->base, 0, 0);
-	SET_M(iommu->base, 0, 0);
-
-	if (!par) {
-		pr_err("Invalid PAR value detected\n");
-		return -ENODEV;
-	}
-
 	ret = devm_request_threaded_irq(iommu->dev, iommu->irq, NULL,
-- 
