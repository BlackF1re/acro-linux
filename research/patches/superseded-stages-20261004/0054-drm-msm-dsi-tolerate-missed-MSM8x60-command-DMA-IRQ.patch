From b3f32e0cbeeaa5ae982ed9591b7db6577f79e0f7 Mon Sep 17 00:00:00 2001
From: Hikari Patch Materializer <hikari-materializer@localhost>
Date: Tue, 8 Sep 2026 19:17:44 +0700
Subject: [PATCH] drm/msm/dsi: tolerate missed MSM8x60 command DMA IRQ

---
 drivers/gpu/drm/msm/dsi/dsi_host.c | 28 ++++++++++++++++++++++++++--
 1 file changed, 26 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index 3945be7a3..990aed6e1 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -1578,8 +1578,32 @@ static int dsi_cmd_dma_tx(struct msm_dsi_host *msm_host, int len)
 		ret = wait_for_completion_timeout(&msm_host->dma_comp,
 					msecs_to_jiffies(200));
 		DBG("ret=%d", ret);
-		if (ret == 0)
-			ret = -ETIMEDOUT;
+		if (ret == 0) {
+			u32 trigger = dsi_read(msm_host, REG_DSI_TRIG_DMA);
+			u32 intr = dsi_read(msm_host, REG_DSI_INTR_CTRL);
+
+			/*
+			 * MSM8x60 can lose the command-DMA completion interrupt while
+			 * still completing the transfer.  The hardware clears TRIG_DMA
+			 * after consuming the buffer, so do not abort panel preparation
+			 * solely because IRQ 82 was not observed.
+			 */
+			if (!(trigger & 1)) {
+				dev_warn(&msm_host->pdev->dev,
+					 "command DMA completed without IRQ: base=%#llx len=%d intr=%#x\n",
+					 dma_base, len, intr);
+				ret = len;
+			} else {
+				dev_err(&msm_host->pdev->dev,
+					"command DMA timeout: base=%#llx len=%d trigger=%#x intr=%#x status=%#x fifo=%#x ack=%#x clk=%#x\n",
+					dma_base, len, trigger, intr,
+					dsi_read(msm_host, REG_DSI_STATUS0),
+					dsi_read(msm_host, REG_DSI_FIFO_STATUS),
+					dsi_read(msm_host, REG_DSI_ACK_ERR_STATUS),
+					dsi_read(msm_host, REG_DSI_CLK_STATUS));
+				ret = -ETIMEDOUT;
+			}
+		}
 		else
 			ret = len;
 	} else {
-- 
