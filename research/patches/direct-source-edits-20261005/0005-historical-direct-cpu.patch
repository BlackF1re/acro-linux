@@ -0,0 +1,86 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/cpufreq/qcom,msm8660-cpufreq.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm MSM8660 Scorpion CPU frequency controller
+
+maintainers:
+  - Hikari Linux Project <hikari-linux@example.com>
+
+description: |
+  The MSM8260/MSM8660 application processors use one SCPLL and supply per CPU,
+  plus a shared SCPLL for L2 and shared memory/digital supplies.  Frequency
+  transitions must coordinate all of these resources and the Apps fabric.
+
+properties:
+  compatible:
+    const: qcom,msm8660-cpufreq
+
+  reg:
+    maxItems: 3
+
+  reg-names:
+    items:
+      - const: scpll
+      - const: acc0
+      - const: acc1
+
+  qcom,l2cc:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Phandle to the KPSS GCC syscon containing the L2 clock mux
+
+  cpu0-supply: true
+  cpu1-supply: true
+  mem-supply: true
+  dig-supply: true
+
+  interconnects:
+    maxItems: 1
+
+  interconnect-names:
+    const: cpu-mem
+
+  nvmem-cells:
+    maxItems: 1
+
+  nvmem-cell-names:
+    const: speed-bin
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - qcom,l2cc
+  - cpu0-supply
+  - cpu1-supply
+  - mem-supply
+  - dig-supply
+  - interconnects
+  - interconnect-names
+  - nvmem-cells
+  - nvmem-cell-names
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interconnect/qcom,msm8660.h>
+
+    cpufreq@903000 {
+        compatible = "qcom,msm8660-cpufreq";
+        reg = <0x00903000 0x1000>, <0x02041000 0x1000>,
+              <0x02051000 0x1000>;
+        reg-names = "scpll", "acc0", "acc1";
+        qcom,l2cc = <&l2cc>;
+        cpu0-supply = <&s0>;
+        cpu1-supply = <&s1>;
+        mem-supply = <&memory_supply>;
+        dig-supply = <&digital_supply>;
+        interconnects = <&afab AFAB_MAS_AMPSS_M0
+                               &afab AFAB_SLV_EBI_CH0>;
+        interconnect-names = "cpu-mem";
+        nvmem-cells = <&speed_bin>;
+        nvmem-cell-names = "speed-bin";
+    };
