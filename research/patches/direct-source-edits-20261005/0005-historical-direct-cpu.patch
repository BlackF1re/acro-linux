diff --git a/drivers/cpufreq/qcom-msm8660-cpufreq.c b/drivers/cpufreq/qcom-msm8660-cpufreq.c
new file mode 100644
index 0000000000000000000000000000000000000000..e20353ab4904965e7372940a9ae76cd1249598a4
--- /dev/null
+++ b/drivers/cpufreq/qcom-msm8660-cpufreq.c
@@ -0,0 +1,559 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Qualcomm MSM8660 Scorpion CPU/L2 clock and voltage scaling
+ *
+ * The clock sequence and PVS data come from Qualcomm's acpuclock-8x60
+ * driver.  Unlike that legacy driver, this exposes the standard CPUFreq,
+ * regulator and interconnect interfaces.
+ */
+
+#include <linux/cpu.h>
+#include <linux/cpufreq.h>
+#include <linux/delay.h>
+#include <linux/interconnect.h>
+#include <linux/iopoll.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/mfd/syscon.h>
+#include <linux/mutex.h>
+#include <linux/nvmem-consumer.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+
+#define SCPLL_DEBUG		0x00
+#define SCPLL_CTL		0x04
+#define SCPLL_CAL		0x08
+#define SCPLL_STATUS		0x10
+#define SCPLL_CFG		0x1c
+#define SCPLL_FSM_CTL_EXT	0x24
+#define SCPLL_LUT(l)		(0x38 + ((l) / 4) * 4)
+
+#define SCPLL_POWER_DOWN	0
+#define SCPLL_STANDBY		2
+#define SCPLL_FULL_CAL		4
+#define SCPLL_NORMAL		7
+#define SCPLL_DEBUG_FULL	3
+#define SCPLL_SHOT_SWITCH	4
+#define SCPLL_COMPLEX_SLEW	7
+
+#define SCPLL_CPU0		0x200
+#define SCPLL_CPU1		0x300
+#define SCPLL_L2		0x400
+#define ACC_CLK_CTL		0x04
+#define ACC_CLK_SEL		0x08
+#define L2_CLK_SEL		0x38
+#define AFAB_KHZ		310500
+#define MAX_L_VAL		0x1c
+
+struct msm8660_l2_level {
+	u32 khz;
+	u8 l_val;
+	u32 mem_uv;
+	u32 dig_uv;
+	u16 peak_mbps;
+};
+
+struct msm8660_level {
+	u32 khz;
+	u8 l_val;
+	u8 l2;
+	u32 cpu_uv;
+};
+
+static const struct msm8660_l2_level msm8660_l2[] = {
+	{ 310500, 0x00, 1100000, 1000000,  824 },
+	{ 432000, 0x08, 1100000, 1000000,  824 },
+	{ 486000, 0x09, 1100000, 1000000,  824 },
+	{ 540000, 0x0a, 1100000, 1000000,  824 },
+	{ 594000, 0x0b, 1100000, 1000000,  824 },
+	{ 648000, 0x0c, 1100000, 1000000, 1336 },
+	{ 702000, 0x0d, 1100000, 1100000, 1336 },
+	{ 756000, 0x0e, 1100000, 1100000, 1336 },
+	{ 810000, 0x0f, 1100000, 1100000, 1336 },
+	{ 864000, 0x10, 1100000, 1100000, 1336 },
+	{ 918000, 0x11, 1100000, 1100000, 2008 },
+	{ 972000, 0x12, 1100000, 1100000, 2008 },
+	{1026000, 0x13, 1100000, 1100000, 2008 },
+	{1080000, 0x14, 1200000, 1100000, 2008 },
+	{1134000, 0x15, 1200000, 1100000, 2008 },
+	{1188000, 0x16, 1200000, 1200000, 2480 },
+	{1242000, 0x17, 1212500, 1200000, 2480 },
+	{1296000, 0x18, 1225000, 1200000, 2480 },
+	{1350000, 0x19, 1225000, 1200000, 2480 },
+	{1404000, 0x1a, 1250000, 1200000, 2480 },
+};
+
+/* MSM8260 speed-bin 1, PVS nominal, as fused on Sony Hikari. */
+static const struct msm8660_level hikari_nominal[] = {
+	{ 384000, 0x00,  1,  825000 },
+	{ 432000, 0x08,  1,  850000 },
+	{ 486000, 0x09,  2,  850000 },
+	{ 540000, 0x0a,  3,  875000 },
+	{ 594000, 0x0b,  4,  875000 },
+	{ 648000, 0x0c,  5,  900000 },
+	{ 702000, 0x0d,  6,  900000 },
+	{ 756000, 0x0e,  7,  925000 },
+	{ 810000, 0x0f,  8,  950000 },
+	{ 864000, 0x10,  9,  975000 },
+	{ 918000, 0x11, 10,  975000 },
+	{ 972000, 0x12, 11, 1000000 },
+	{1026000, 0x13, 12, 1000000 },
+	{1080000, 0x14, 13, 1025000 },
+	{1134000, 0x15, 14, 1025000 },
+	{1188000, 0x16, 15, 1050000 },
+	{1242000, 0x17, 16, 1075000 },
+	{1296000, 0x18, 17, 1100000 },
+	{1350000, 0x19, 18, 1125000 },
+	{1404000, 0x1a, 19, 1150000 },
+	{1458000, 0x1b, 19, 1150000 },
+	{1512000, 0x1c, 19, 1175000 },
+};
+
+struct msm8660_cpufreq {
+	struct device *dev;
+	void __iomem *scpll;
+	void __iomem *acc[2];
+	struct regmap *l2cc;
+	struct regulator *cpu_reg[2];
+	struct regulator *mem_reg;
+	struct regulator *dig_reg;
+	struct icc_path *cpu_mem;
+	struct mutex lock;
+	unsigned int current_idx[2];
+	unsigned int l2_vote[2];
+	unsigned int current_l2;
+	struct cpufreq_frequency_table table[ARRAY_SIZE(hikari_nominal) + 1];
+};
+
+static struct msm8660_cpufreq *msm8660_data;
+
+static void __iomem *msm8660_pll(struct msm8660_cpufreq *d, unsigned int id)
+{
+	static const unsigned int off[] = { SCPLL_CPU0, SCPLL_CPU1, SCPLL_L2 };
+
+	return d->scpll + off[id];
+}
+
+static void msm8660_select_core(struct msm8660_cpufreq *d, unsigned int id,
+				unsigned int src)
+{
+	u32 shift = id == 2 ? 0 : 1;
+	u32 val;
+
+	if (id == 2) {
+		regmap_update_bits(d->l2cc, L2_CLK_SEL, 3, src);
+		return;
+	}
+	val = readl_relaxed(d->acc[id] + ACC_CLK_SEL);
+
+	val &= ~(3 << shift);
+	val |= src << shift;
+	writel_relaxed(val, d->acc[id] + ACC_CLK_SEL);
+}
+
+static void msm8660_select_pll8(struct msm8660_cpufreq *d, unsigned int cpu)
+{
+	u32 sel = readl_relaxed(d->acc[cpu] + ACC_CLK_SEL);
+	u32 bank = sel & 1;
+	u32 ctl = readl_relaxed(d->acc[cpu] + ACC_CLK_CTL);
+
+	ctl &= ~(0xff << (8 * bank));
+	ctl |= 3 << (4 + 8 * bank); /* PLL8 */
+	writel_relaxed(ctl, d->acc[cpu] + ACC_CLK_CTL);
+	writel_relaxed(sel ^ 1, d->acc[cpu] + ACC_CLK_SEL);
+	msm8660_select_core(d, cpu, 0);
+}
+
+static int msm8660_scpll_change(struct msm8660_cpufreq *d, unsigned int id,
+				u8 l_val)
+{
+	void __iomem *base = msm8660_pll(d, id);
+	u32 val;
+	int ret;
+
+	writel_relaxed((l_val << 3) | SCPLL_COMPLEX_SLEW,
+		       base + SCPLL_FSM_CTL_EXT);
+	writel_relaxed(SCPLL_NORMAL, base + SCPLL_CTL);
+	ret = readl_poll_timeout_atomic(base + SCPLL_CTL, val,
+					((val >> 3) & 0x3f) == l_val, 1, 1000);
+	if (ret)
+		return ret;
+
+	return readl_poll_timeout_atomic(base + SCPLL_STATUS, val,
+					 !(val & 1), 1, 1000);
+}
+
+static void msm8660_scpll_enable(struct msm8660_cpufreq *d, unsigned int id,
+				  u8 l_val)
+{
+	void __iomem *base = msm8660_pll(d, id);
+
+	writel_relaxed(SCPLL_STANDBY, base + SCPLL_CTL);
+	mb();
+	udelay(10);
+	writel_relaxed((l_val << 3) | SCPLL_SHOT_SWITCH,
+		       base + SCPLL_FSM_CTL_EXT);
+	writel_relaxed(SCPLL_NORMAL, base + SCPLL_CTL);
+	mb();
+	udelay(20);
+}
+
+static void msm8660_scpll_disable(struct msm8660_cpufreq *d, unsigned int id)
+{
+	writel_relaxed(SCPLL_POWER_DOWN, msm8660_pll(d, id) + SCPLL_CTL);
+}
+
+static int msm8660_scpll_calibrate(struct msm8660_cpufreq *d, unsigned int id,
+				    u8 max_l_val)
+{
+	void __iomem *base = msm8660_pll(d, id);
+	u32 val;
+	int ret;
+
+	writel_relaxed(SCPLL_DEBUG_FULL, base + SCPLL_DEBUG);
+	writel_relaxed(0, base + SCPLL_LUT(max_l_val));
+	writel_relaxed(0, base + SCPLL_DEBUG);
+	writel_relaxed(SCPLL_STANDBY, base + SCPLL_CTL);
+	mb();
+	udelay(10);
+	writel_relaxed((max_l_val << 24) | (0x08 << 16), base + SCPLL_CAL);
+	writel_relaxed(SCPLL_FULL_CAL, base + SCPLL_CTL);
+
+	ret = readl_poll_timeout_atomic(base + SCPLL_LUT(max_l_val), val,
+					val, 1, 10000);
+	if (!ret)
+		ret = readl_poll_timeout_atomic(base + SCPLL_STATUS, val,
+						 !(val & 2), 1, 10000);
+	msm8660_scpll_disable(d, id);
+	return ret;
+}
+
+static int msm8660_set_cpu_clock(struct msm8660_cpufreq *d, unsigned int cpu,
+				 unsigned int old, unsigned int new)
+{
+	bool old_scpll = hikari_nominal[old].l_val;
+	bool new_scpll = hikari_nominal[new].l_val;
+	int ret = 0;
+
+	if (old_scpll && new_scpll) {
+		ret = msm8660_scpll_change(d, cpu, hikari_nominal[new].l_val);
+	} else if (!old_scpll && new_scpll) {
+		msm8660_scpll_enable(d, cpu, hikari_nominal[new].l_val);
+		mb();
+		msm8660_select_core(d, cpu, 1);
+	} else if (old_scpll && !new_scpll) {
+		msm8660_select_pll8(d, cpu);
+		mb();
+		udelay(1);
+		msm8660_scpll_disable(d, cpu);
+	}
+
+	return ret;
+}
+
+static int msm8660_set_l2(struct msm8660_cpufreq *d, unsigned int new)
+{
+	unsigned int old = d->current_l2;
+	int ret = 0;
+
+	if (old == new)
+		return 0;
+	if (old && new) {
+		ret = msm8660_scpll_change(d, 2, msm8660_l2[new].l_val);
+	} else if (!old && new) {
+		msm8660_scpll_enable(d, 2, msm8660_l2[new].l_val);
+		mb();
+		msm8660_select_core(d, 2, 1);
+	} else {
+		msm8660_select_core(d, 2, 0);
+		mb();
+		msm8660_scpll_disable(d, 2);
+	}
+	if (!ret)
+		d->current_l2 = new;
+	return ret;
+}
+
+static unsigned int msm8660_shared_l2(struct msm8660_cpufreq *d,
+				      unsigned int cpu, unsigned int target)
+{
+	unsigned int other = d->l2_vote[!cpu];
+
+	return max(hikari_nominal[target].l2, other);
+}
+
+static int msm8660_target_index(struct cpufreq_policy *policy,
+				unsigned int index)
+{
+	struct msm8660_cpufreq *d = policy->driver_data;
+	unsigned int cpu = policy->cpu, old, l2;
+	u32 mem_uv, dig_uv;
+	int ret;
+
+	mutex_lock(&d->lock);
+	old = d->current_idx[cpu];
+	if (old == index) {
+		ret = 0;
+		goto out;
+	}
+
+	l2 = msm8660_shared_l2(d, cpu, index);
+	mem_uv = max3(hikari_nominal[index].cpu_uv,
+			msm8660_l2[l2].mem_uv,
+			hikari_nominal[d->current_idx[!cpu]].cpu_uv);
+	dig_uv = msm8660_l2[l2].dig_uv;
+	if (hikari_nominal[index].khz > 594000 || msm8660_l2[l2].khz > 594000)
+		dig_uv = max(dig_uv, 1100000U);
+
+	if (index > old) {
+		ret = regulator_set_voltage(d->mem_reg, mem_uv, 1325000);
+		if (ret)
+			goto out;
+		ret = regulator_set_voltage(d->dig_reg, dig_uv, 1200000);
+		if (ret)
+			goto out;
+		ret = regulator_set_voltage(d->cpu_reg[cpu],
+					    hikari_nominal[index].cpu_uv, 1325000);
+		if (ret)
+			goto out;
+		ret = icc_set_bw(d->cpu_mem, 0,
+				 MBps_to_icc(msm8660_l2[l2].peak_mbps));
+		if (ret)
+			goto out;
+	}
+
+	ret = msm8660_set_cpu_clock(d, cpu, old, index);
+	if (ret)
+		goto out;
+	d->current_idx[cpu] = index;
+	d->l2_vote[cpu] = hikari_nominal[index].l2;
+	ret = msm8660_set_l2(d, l2);
+	if (ret)
+		goto out;
+	if (index < old) {
+		ret = icc_set_bw(d->cpu_mem, 0,
+				 MBps_to_icc(msm8660_l2[l2].peak_mbps));
+		if (ret)
+			goto out;
+		ret = regulator_set_voltage(d->cpu_reg[cpu],
+					    hikari_nominal[index].cpu_uv, 1325000);
+		if (ret)
+			goto out;
+		ret = regulator_set_voltage(d->dig_reg, dig_uv, 1200000);
+		if (ret)
+			goto out;
+		ret = regulator_set_voltage(d->mem_reg, mem_uv, 1325000);
+	}
+out:
+	mutex_unlock(&d->lock);
+	return ret;
+}
+
+static unsigned int msm8660_get(unsigned int cpu)
+{
+	struct msm8660_cpufreq *d = msm8660_data;
+
+	if (!d || cpu > 1)
+		return 0;
+	return hikari_nominal[READ_ONCE(d->current_idx[cpu])].khz;
+}
+
+static int msm8660_cpu_init(struct cpufreq_policy *policy)
+{
+	struct msm8660_cpufreq *d = msm8660_data;
+
+	if (!d || policy->cpu > 1)
+		return -ENODEV;
+	cpumask_set_cpu(policy->cpu, policy->cpus);
+	policy->driver_data = d;
+	policy->freq_table = d->table;
+	policy->cpuinfo.transition_latency = 100000;
+	return 0;
+}
+
+static struct cpufreq_driver msm8660_cpufreq_driver = {
+	.name = "qcom-msm8660",
+	.flags = CPUFREQ_NEED_INITIAL_FREQ_CHECK |
+		 CPUFREQ_HAVE_GOVERNOR_PER_POLICY | CPUFREQ_IS_COOLING_DEV,
+	.verify = cpufreq_generic_frequency_table_verify,
+	.target_index = msm8660_target_index,
+	.get = msm8660_get,
+	.init = msm8660_cpu_init,
+};
+
+static int msm8660_map_resources(struct platform_device *pdev,
+				 struct msm8660_cpufreq *d)
+{
+	static const char * const names[] = { "scpll", "acc0", "acc1" };
+	void __iomem *base[ARRAY_SIZE(names)];
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		base[i] = devm_platform_ioremap_resource_byname(pdev, names[i]);
+		if (IS_ERR(base[i]))
+			return PTR_ERR(base[i]);
+	}
+	d->scpll = base[0];
+	d->acc[0] = base[1];
+	d->acc[1] = base[2];
+	d->l2cc = syscon_regmap_lookup_by_phandle(pdev->dev.of_node,
+						 "qcom,l2cc");
+	if (IS_ERR(d->l2cc))
+		return PTR_ERR(d->l2cc);
+	return 0;
+}
+
+static int msm8660_cpufreq_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct msm8660_cpufreq *d;
+	struct nvmem_cell *cell;
+	size_t len;
+	u32 *fuse, speed, pvs, val;
+	unsigned int i;
+	int ret;
+
+	d = devm_kzalloc(dev, sizeof(*d), GFP_KERNEL);
+	if (!d)
+		return -ENOMEM;
+	d->dev = dev;
+	mutex_init(&d->lock);
+	ret = msm8660_map_resources(pdev, d);
+	if (ret)
+		return ret;
+
+	cell = devm_nvmem_cell_get(dev, "speed-bin");
+	if (IS_ERR(cell))
+		return dev_err_probe(dev, PTR_ERR(cell), "speed-bin unavailable\n");
+	fuse = nvmem_cell_read(cell, &len);
+	if (IS_ERR(fuse))
+		return PTR_ERR(fuse);
+	if (len < sizeof(*fuse)) {
+		kfree(fuse);
+		return -EINVAL;
+	}
+	val = *fuse;
+	kfree(fuse);
+	speed = val & 0xf;
+	if (speed == 0xf)
+		speed = (val >> 4) & 0xf;
+	pvs = (val >> 10) & 7;
+	if (pvs == 7)
+		pvs = (val >> 13) & 7;
+	if (speed != 1 || pvs != 1)
+		return dev_err_probe(dev, -EINVAL,
+			"unsupported speed/PVS bin %u/%u (fuse %#x)\n",
+			speed, pvs, val);
+
+	d->cpu_reg[0] = devm_regulator_get(dev, "cpu0");
+	d->cpu_reg[1] = devm_regulator_get(dev, "cpu1");
+	d->mem_reg = devm_regulator_get(dev, "mem");
+	d->dig_reg = devm_regulator_get(dev, "dig");
+	if (IS_ERR(d->cpu_reg[0]) || IS_ERR(d->cpu_reg[1]) ||
+	    IS_ERR(d->mem_reg) || IS_ERR(d->dig_reg))
+		return dev_err_probe(dev, -EPROBE_DEFER, "regulators unavailable\n");
+	d->cpu_mem = devm_of_icc_get(dev, "cpu-mem");
+	if (IS_ERR(d->cpu_mem))
+		return dev_err_probe(dev, PTR_ERR(d->cpu_mem),
+				     "memory interconnect unavailable\n");
+
+	for (i = 0; i < 2; i++) {
+		ret = regulator_enable(d->cpu_reg[i]);
+		if (ret)
+			return ret;
+	}
+	ret = regulator_enable(d->mem_reg);
+	if (ret)
+		return ret;
+	ret = regulator_enable(d->dig_reg);
+	if (ret)
+		return ret;
+
+	/* Raise all rails and the memory path before touching shared clocks. */
+	ret = regulator_set_voltage(d->cpu_reg[0], 1175000, 1325000);
+	ret |= regulator_set_voltage(d->cpu_reg[1], 1175000, 1325000);
+	ret |= regulator_set_voltage(d->mem_reg, 1250000, 1325000);
+	ret |= regulator_set_voltage(d->dig_reg, 1200000, 1200000);
+	ret |= icc_set_bw(d->cpu_mem, 0, MBps_to_icc(2480));
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to establish safe rails\n");
+
+	/* Move both cores and L2 to AFAB while their SCPLLs are calibrated. */
+	for (i = 0; i < 2; i++) {
+		msm8660_select_pll8(d, i);
+		msm8660_select_core(d, i, 0);
+	}
+	msm8660_select_core(d, 2, 0);
+	for (i = 0; i < 3; i++) {
+		u32 cfg = readl_relaxed(msm8660_pll(d, i) + SCPLL_CFG);
+
+		writel_relaxed(cfg & ~BIT(4), msm8660_pll(d, i) + SCPLL_CFG);
+		ret = msm8660_scpll_calibrate(d, i,
+					      i == 2 ? msm8660_l2[19].l_val : MAX_L_VAL);
+		if (ret)
+			return dev_err_probe(dev, ret, "SCPLL%u calibration timed out\n", i);
+	}
+
+	/* Establish a known 756 MHz starting state before CPUFreq registration. */
+	d->current_idx[0] = d->current_idx[1] = 0;
+	d->l2_vote[0] = d->l2_vote[1] = 0;
+	d->current_l2 = 0;
+	for (i = 0; i < 2; i++) {
+		msm8660_scpll_enable(d, i, hikari_nominal[7].l_val);
+		mb();
+		msm8660_select_core(d, i, 1);
+		d->current_idx[i] = 7;
+		d->l2_vote[i] = hikari_nominal[7].l2;
+	}
+	ret = msm8660_set_l2(d, hikari_nominal[7].l2);
+	if (ret)
+		return ret;
+	ret = regulator_set_voltage(d->cpu_reg[0], 925000, 1325000);
+	ret |= regulator_set_voltage(d->cpu_reg[1], 925000, 1325000);
+	ret |= regulator_set_voltage(d->dig_reg, 1100000, 1200000);
+	ret |= regulator_set_voltage(d->mem_reg, 1100000, 1325000);
+	ret |= icc_set_bw(d->cpu_mem, 0, MBps_to_icc(1336));
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to set initial operating point\n");
+	for (i = 0; i < ARRAY_SIZE(hikari_nominal); i++)
+		d->table[i].frequency = hikari_nominal[i].khz;
+	d->table[i].frequency = CPUFREQ_TABLE_END;
+
+	msm8660_data = d;
+	ret = cpufreq_register_driver(&msm8660_cpufreq_driver);
+	if (ret) {
+		msm8660_data = NULL;
+		return ret;
+	}
+	platform_set_drvdata(pdev, d);
+	dev_info(dev, "speed/PVS 1/1, 384-1512 MHz, schedutil capable\n");
+	return 0;
+}
+
+static void msm8660_cpufreq_remove(struct platform_device *pdev)
+{
+	cpufreq_unregister_driver(&msm8660_cpufreq_driver);
+	msm8660_data = NULL;
+}
+
+static const struct of_device_id msm8660_cpufreq_match[] = {
+	{ .compatible = "qcom,msm8660-cpufreq" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, msm8660_cpufreq_match);
+
+static struct platform_driver msm8660_cpufreq_platdrv = {
+	.probe = msm8660_cpufreq_probe,
+	.remove = msm8660_cpufreq_remove,
+	.driver = {
+		.name = "qcom-msm8660-cpufreq",
+		.of_match_table = msm8660_cpufreq_match,
+	},
+};
+module_platform_driver(msm8660_cpufreq_platdrv);
+
+MODULE_DESCRIPTION("Qualcomm MSM8660 Scorpion CPUFreq driver");
+MODULE_LICENSE("GPL");
