+static void mmci_fifo_read(struct mmci_host *host, void *buffer,
+			   unsigned int words, unsigned int *word_offset)
+{
+	void __iomem *fifo = host->base + MMCIFIFO;
+	u32 *ptr = buffer;
+	unsigned int i;
+
+	if (!host->variant->qcom_fifo) {
+		ioread32_rep(fifo, buffer, words);
+		return;
+	}
+
+	/*
+	 * The Qualcomm FIFO is exposed as a cyclic address window.  Preserve
+	 * the offset across the eight-word bursts consumed by one PIO service,
+	 * matching the downstream Qualcomm driver.
+	 */
+	for (i = 0; i < words; i++) {
+		unsigned int offset = *word_offset * sizeof(*ptr);
+
+		*ptr++ = readl_relaxed(fifo + offset);
+		*word_offset = (*word_offset + 1) %
+				(host->variant->fifosize / sizeof(*ptr));
+	}
+}
