@@ -28,6 +28,10 @@
 #define SLP_CLK_ENA		BIT(26)
 #define SLP_CLK_ENA_8660	BIT(24)
 #define SENSOR0_SHIFT		3
+#define MIN_STATUS_MASK_8660	BIT(8)
+#define LOW_STATUS_CLEAR_8660	BIT(9)
+#define UP_STATUS_CLEAR_8660	BIT(10)
+#define MAX_STATUS_MASK_8660	BIT(11)
 
 #define THRESHOLD_ADDR		0x3624
 
@@ -52,6 +56,72 @@ static u32 tsens_msm8960_slope[] = {
 			782, 849, 782
 			};
 
+static int __init init_8660(struct tsens_priv *priv)
+{
+	unsigned int reg, status;
+	int ret;
+
+	ret = init_common(priv);
+	if (ret)
+		return ret;
+
+	ret = regmap_read(priv->tm_map, CNTL_ADDR, &reg);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(priv->tm_map, CNTL_ADDR, reg | SW_RST);
+	if (ret)
+		return ret;
+
+	reg |= EN | BIT(SENSOR0_SHIFT) | MEASURE_PERIOD | SLP_CLK_ENA_8660 |
+	       MIN_STATUS_MASK_8660 | LOW_STATUS_CLEAR_8660 |
+	       UP_STATUS_CLEAR_8660 | MAX_STATUS_MASK_8660;
+	reg &= ~CONFIG_MASK_8660;
+	reg |= CONFIG_8660 << CONFIG_SHIFT_8660;
+
+	ret = regmap_write(priv->tm_map, CNTL_ADDR, reg);
+	if (ret)
+		return ret;
+
+	/* Match the safe power-on thresholds used by the MSM8660 BSP. */
+	ret = regmap_write(priv->tm_map, THRESHOLD_ADDR, 0xff38df50);
+	if (ret)
+		return ret;
+
+	/* The first conversion takes one measurement period (up to 1 second). */
+	return regmap_read_poll_timeout(priv->tm_map, INT_STATUS_ADDR, status,
+					status & BIT(7), 1000, 1100000);
+}
+
+/* MSM8660 QFPROM stores the 30 degree calibration code twice. */
+static int calibrate_8660(struct tsens_priv *priv)
+{
+	char *calib, *calib_backup;
+	u32 p1;
+
+	calib = qfprom_read(priv->dev, "calib");
+	if (IS_ERR(calib))
+		return PTR_ERR(calib);
+
+	calib_backup = qfprom_read(priv->dev, "calib_backup");
+	if (IS_ERR(calib_backup)) {
+		kfree(calib);
+		return PTR_ERR(calib_backup);
+	}
+
+	p1 = (u8)calib_backup[0] ? (u8)calib_backup[0] : (u8)calib[0];
+	kfree(calib_backup);
+	kfree(calib);
+	if (!p1)
+		return -ENODEV;
+
+	/* Sony specifies 0.702 degrees C per ADC code. */
+	priv->sensor[0].slope = 1425;
+	compute_intercept_slope(priv, &p1, NULL, ONE_PT_CALIB);
+
+	return 0;
+}
+
 static int suspend_8960(struct tsens_priv *priv)
